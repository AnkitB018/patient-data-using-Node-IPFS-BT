                    const bgColor = bgColors[idx % bgColors.length];
                    
                    html += `
                        <div class="insight-item mb-3" style="padding: 18px 20px; background: ${bgColor}; border-left: 4px solid ${color}; border-radius: 10px; transition: all 0.3s; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                            <div class="d-flex align-items-start">
                                <i class="bi ${insight.icon} me-3" style="color: ${color}; font-size: 1.3rem; margin-top: 2px;"></i>
                                <span style="color: #e5e7eb; line-height: 1.6; font-size: 0.95rem;">${insight.text}</span>
                            </div>
                        </div>
                    `;
                });
                
                html += `
                        </div>
                    </div>
                `;
            }

            // Diagnoses Section
            if (summary.diagnoses && summary.diagnoses.length > 0) {
                html += `
                    <div class="card mb-4" style="background: rgba(30,41,59,0.9); border: 2px solid #00ff7f; border-radius: 15px; padding: 25px;">
                        <h5 style="color: #00ff7f; margin-bottom: 20px;">
                            <i class="bi bi-clipboard-pulse me-2"></i>Top Diagnoses
                        </h5>
                `;
                
                summary.diagnoses.forEach((item, index) => {
                    const color = index === 0 ? '#00ff7f' : index === 1 ? '#00d2ff' : '#ffd700';
                    html += `
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span style="color: #e5e7eb;">${item.diagnosis}</span>
                                <span style="color: ${color}; font-weight: bold;">${item.percentage.toFixed(1)}%</span>
                            </div>
                            <div style="background: rgba(255,255,255,0.1); height: 10px; border-radius: 5px; overflow: hidden;">
                                <div style="background: ${color}; height: 100%; width: ${item.percentage}%; transition: width 0.3s;"></div>
                            </div>
                            <small style="color: #9ca3af;">${item.count} cases</small>
                        </div>
                    `;
                });
                
                html += `</div>`;
            }

            // Symptoms Section
            if (summary.symptoms && summary.symptoms.length > 0) {
                html += `
                    <div class="card mb-4" style="background: rgba(30,41,59,0.9); border: 2px solid #ffd700; border-radius: 15px; padding: 25px;">
                        <h5 style="color: #ffd700; margin-bottom: 20px;">
                            <i class="bi bi-thermometer me-2"></i>Common Symptoms
                        </h5>
                        <div class="row">
                `;
                
                summary.symptoms.forEach(item => {
                    html += `
                        <div class="col-md-6 mb-3">
                            <div style="padding: 12px; background: rgba(255, 215, 0, 0.1); border-radius: 8px;">
                                <div class="d-flex justify-content-between">
                                    <span style="color: #e5e7eb;">${item.symptom}</span>
                                    <span style="color: #ffd700; font-weight: bold;">${item.percentage.toFixed(1)}%</span>
                                </div>
                                <small style="color: #9ca3af;">${item.count} cases</small>
                            </div>
                        </div>
                    `;
                });
                
                html += `
                        </div>
                    </div>
                `;
            }

            // Treatments Section
            if (summary.treatments && summary.treatments.length > 0) {
                html += `
                    <div class="card mb-4" style="background: rgba(30,41,59,0.9); border: 2px solid #ff6b6b; border-radius: 15px; padding: 25px;">
                        <h5 style="color: #ff6b6b; margin-bottom: 20px;">
                            <i class="bi bi-heart-pulse me-2"></i>Treatment Approaches
                        </h5>
                `;
                
                summary.treatments.forEach(item => {
                    html += `
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span style="color: #e5e7eb;">${item.treatment}</span>
                                <span style="color: #ff6b6b; font-weight: bold;">${item.percentage.toFixed(1)}%</span>
                            </div>
                            <div style="background: rgba(255,255,255,0.1); height: 8px; border-radius: 4px; overflow: hidden;">
                                <div style="background: #ff6b6b; height: 100%; width: ${item.percentage}%;"></div>
                            </div>
                            <small style="color: #9ca3af;">${item.count} cases</small>
                        </div>
                    `;
                });
                
                html += `</div>`;
            }

            // Medications Section
            if (summary.medications && summary.medications.length > 0) {
                html += `
                    <div class="card mb-4" style="background: rgba(30,41,59,0.9); border: 2px solid #a78bfa; border-radius: 15px; padding: 25px;">
                        <h5 style="color: #a78bfa; margin-bottom: 20px;">
                            <i class="bi bi-capsule me-2"></i>Common Medications
                        </h5>
                        <div class="row">
                `;
                
                summary.medications.forEach(item => {
                    html += `
                        <div class="col-md-6 mb-3">
                            <div style="padding: 12px; background: rgba(167, 139, 250, 0.1); border-radius: 8px;">
                                <div class="d-flex justify-content-between">
                                    <span style="color: #e5e7eb;">${item.medication}</span>
                                    <span style="color: #a78bfa; font-weight: bold;">${item.percentage.toFixed(1)}%</span>
                                </div>
                                <small style="color: #9ca3af;">${item.count} cases</small>
                            </div>
                        </div>
                    `;
                });
                
                html += `
                        </div>
                    </div>
                `;
            }

            // Demographics Section
            if (summary.demographics && (summary.demographics.gender?.length > 0 || summary.demographics.bloodGroups?.length > 0 || summary.demographics.recordTypes?.length > 0)) {
                html += `
                    <div class="card mb-4" style="background: rgba(30,41,59,0.9); border: 2px solid #ec4899; border-radius: 15px; padding: 25px;">
                        <h5 style="color: #ec4899; margin-bottom: 20px;">
                            <i class="bi bi-people me-2"></i>Demographics
                        </h5>
                        <div class="row">
                `;
                
                // Gender Distribution - filter out invalid values
                if (summary.demographics.gender && summary.demographics.gender.length > 0) {
                    const validGenders = summary.demographics.gender.filter(g => 
                        g.gender && g.gender !== 'Unknown' && g.gender !== '0' && g.count > 0
                    );
                    
                    if (validGenders.length > 0) {
                        html += `
                            <div class="col-md-4 mb-3">
                                <h6 style="color: #ec4899; font-size: 0.9rem;">Gender Distribution</h6>
                        `;
                        validGenders.forEach(item => {
                            html += `
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between">
                                        <span style="color: #e5e7eb;">${item.gender}</span>
                                        <span style="color: #ec4899;">${item.percentage.toFixed(1)}%</span>
                                    </div>
                                    <small style="color: #9ca3af;">${item.count} case${item.count !== 1 ? 's' : ''}</small>
                                </div>
                            `;
                        });
                        html += `</div>`;
                    }
                }
                
                // Blood Group Distribution
                if (summary.demographics.bloodGroups && summary.demographics.bloodGroups.length > 0) {
                    html += `
                        <div class="col-md-4 mb-3">
                            <h6 style="color: #ec4899; font-size: 0.9rem;">Blood Groups</h6>
                    `;
                    summary.demographics.bloodGroups.forEach(item => {
                        html += `
                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <span style="color: #e5e7eb;">${item.type}</span>
                                    <span style="color: #ec4899;">${item.percentage.toFixed(1)}%</span>
                                </div>
                                <small style="color: #9ca3af;">${item.count} case${item.count !== 1 ? 's' : ''}</small>
                            </div>
                        `;
                    });
                    html += `</div>`;
                }
                
                // File Types
                if (summary.demographics.recordTypes && summary.demographics.recordTypes.length > 0) {
                    html += `
                        <div class="col-md-4 mb-3">
                            <h6 style="color: #ec4899; font-size: 0.9rem;">Record Types</h6>
                    `;
                    summary.demographics.recordTypes.forEach(item => {
                        html += `
                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <span style="color: #e5e7eb;">${item.fileType}</span>
                                    <span style="color: #ec4899;">${item.percentage.toFixed(1)}%</span>
                                </div>
                                <small style="color: #9ca3af;">${item.count} record${item.count !== 1 ? 's' : ''}</small>
                            </div>
                        `;
                    });
                    html += `</div>`;
                }
                
                html += `
                        </div>
                    </div>
                `;
            }

            // Confidence Level Footer
            html += `
                <div class="card" style="background: rgba(30,41,59,0.7); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 20px;">
                    <div class="text-center" style="color: #9ca3af;">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Confidence Level:</strong> ${summary.confidenceLevel || 'Medium'}
                        <br>
                        <small>Based on ${meta.totalRecordsAnalyzed} records from the database</small>
                    </div>
                </div>
            `;
            
            resultsContent.innerHTML = html;
        }

        async function performGASearch(event) {
            event.preventDefault();
            
            const searchBtn = document.getElementById('gaSearchBtn');
            const resultsDiv = document.getElementById('gaResults');
            const resultsContent = document.getElementById('gaResultsContent');
            const resultCount = document.getElementById('gaResultCount');

            searchBtn.disabled = true;
            searchBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Searching...';
            resultsContent.innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"></div><p class="mt-3">Analyzing records...</p></div>';
            resultsDiv.style.display = 'block';

            try {
                const searchMode = document.getElementById('searchMode').value;
                const analyticsMode = searchMode === 'analytics';
                
                const searchCriteria = {
                    file_type: document.getElementById('ga_file_type').value,
                    patient_id: document.getElementById('ga_patient_id').value,
                    primary_diagnosis: document.getElementById('ga_primary_diagnosis').value.trim(),
                    symptoms: collectFieldValues('ga-symptom-field'),
                    affected_body_parts: document.getElementById('ga_body_parts').value.trim(),
                    medications: collectFieldValues('ga-medication-field'),
                    treatments: collectFieldValues('ga-treatment-field'),
                    secondary_diagnoses: collectFieldValues('ga-secondary-diagnosis-field'),
                    current_conditions: document.getElementById('ga_conditions').value.trim(),
                    blood_group: document.getElementById('ga_blood_group').value,
                    gender: document.getElementById('ga_gender').value,
                    age_range: document.getElementById('ga_age_range').value,
                    limit: parseInt(document.getElementById('ga_limit').value) || 10,
                    analyticsMode: analyticsMode
                };

                // Check if at least one criterion is provided
                const hasAnyCriteria = Object.values(searchCriteria).some(val => 
                    val !== '' && val !== null && val !== undefined && val !== 'All Patients'
                );

                if (!hasAnyCriteria) {
                    resultsContent.innerHTML = `
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Please provide at least one search criterion.
                        </div>
                    `;
                    searchBtn.disabled = false;
                    searchBtn.innerHTML = '<i class="bi bi-search me-2"></i>Search with GA';
                    return;
                }

                console.log('Sending GA search with criteria:', searchCriteria);

                const response = await fetch('/api/ga/recommend', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(searchCriteria)
                });

                const data = await response.json();

                // Handle analytics mode response
                if (data.mode === 'analytics' && data.summary) {
                    renderAnalyticsDisplay(data);
                } else if (data.success && data.recommendations && data.recommendations.length > 0) {
                    resultCount.textContent = data.recommendations.length;
                    
                    let html = `
                        <div class="alert alert-success mb-4" style="background: rgba(0, 255, 127, 0.25); border: 2px solid rgba(0, 255, 127, 0.6); color: #00ff7f; font-weight: 500;">
                            <i class="bi bi-check-circle me-2"></i>
                            <strong>Search Complete!</strong> Found ${data.recommendations.length} relevant records.
                            ${data.samplingEnabled && data.totalEvaluations ? `<br><small>⚡ Smart sampling: ${data.totalEvaluations} evaluations across ${data.generationsRun} generations (${data.totalRecordsAnalyzed} unique records)</small>` : ''}
                        </div>
                        
                        <div class="row">
                    `;
                    
                    data.recommendations.forEach((record, index) => {
                        const percentage = (record.matchPercentage || 0).toFixed(1);
                        const matchColor = percentage >= 80 ? '#00ff7f' : 
                                         percentage >= 60 ? '#00d2ff' : 
                                         percentage >= 40 ? '#ffd700' : '#ff6b6b';
                        
                        html += `
                            <div class="col-md-6 mb-3">
                                <div class="card" style="background: rgba(30,41,59,0.8); border: 2px solid ${matchColor}; border-radius: 15px; padding: 20px; color: white;">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h5 style="color: ${matchColor};">
                                            <i class="bi bi-file-earmark-medical me-2"></i>
                                            Record #${index + 1}
                                        </h5>
                                        <span class="badge" style="background: ${matchColor}; color: #000; font-size: 1.2rem; padding: 8px 15px;">
                                            ${percentage}% Match
                                        </span>
                                    </div>
                                    
                                    <div class="record-details">
                                        <div class="mb-2">
                                            <i class="bi bi-fingerprint me-2"></i>
                                            <strong>Block Index:</strong> ${record.block_index}
                                        </div>
                                        <div class="mb-2">
                                            <i class="bi bi-person me-2"></i>
                                            <strong>Patient:</strong> ${record.patient_username || 'N/A'} (ID: ${record.patient_id})
                                        </div>
                                        <div class="mb-2">
                                            <i class="bi bi-file-text me-2"></i>
                                            <strong>File Type:</strong> ${record.file_type || 'N/A'}
                                        </div>
                                        ${record.primary_diagnosis ? `
                                        <div class="mb-2">
                                            <i class="bi bi-clipboard-pulse me-2"></i>
                                            <strong>Diagnosis:</strong> ${record.primary_diagnosis}
                                        </div>
                                        ` : ''}
                                        ${record.symptoms ? `
                                        <div class="mb-2">
                                            <i class="bi bi-thermometer-half me-2"></i>
                                            <strong>Symptoms:</strong> ${record.symptoms}
                                        </div>
                                        ` : ''}
                                        ${record.medications ? `
                                        <div class="mb-2">
                                            <i class="bi bi-capsule me-2"></i>
                                            <strong>Medications:</strong> ${record.medications}
                                        </div>
                                        ` : ''}
                                        ${record.current_conditions ? `
                                        <div class="mb-2">
                                            <i class="bi bi-heart-pulse me-2"></i>
                                            <strong>Conditions:</strong> ${record.current_conditions}
                                        </div>
                                        ` : ''}
                                        ${record.gender ? `
                                        <div class="mb-2">
                                            <i class="bi bi-gender-ambiguous me-2"></i>
                                            <strong>Gender:</strong> ${record.gender}
                                        </div>
                                        ` : ''}
                                        ${record.blood_group ? `
                                        <div class="mb-2">
                                            <i class="bi bi-droplet me-2"></i>
                                            <strong>Blood Group:</strong> ${record.blood_group}
                                        </div>
                                        ` : ''}
                                        <div class="mb-2">
                                            <i class="bi bi-clock me-2"></i>
                                            <strong>Date:</strong> ${new Date(record.timestamp).toLocaleString()}
                                        </div>
                                        <div class="mb-2">
                                            <i class="bi bi-link-45deg me-2"></i>
                                            <strong>IPFS CID:</strong> 
                                            <code style="font-size: 0.75rem; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">
                                                ${record.ipfs_cid ? record.ipfs_cid.substring(0, 30) + '...' : 'N/A'}
                                            </code>
                                        </div>
                                        
                                        <hr style="border-color: rgba(255,255,255,0.2); margin: 15px 0;">
                                        
                                        <div class="fitness-details" style="font-size: 0.85rem; color: rgba(255,255,255,0.7);">
                                            <div><strong>Fitness Score:</strong> ${record.fitnessScore}</div>
                                            <div><strong>Raw Score:</strong> ${record.rawScore} / ${record.maxScore}</div>
                                        </div>
                                        
                                        <div class="mt-3">
                                            ${record.ipfs_cid ? `<button class="btn btn-sm btn-primary w-100" onclick="viewRecord('${record.ipfs_cid}')">
                                                <i class="bi bi-eye me-2"></i>View Full Record
                                            </button>` : '<span class="badge bg-secondary w-100">No Data</span>'}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    
                    html += '</div>';
                    resultsContent.innerHTML = html;
                    
                    // Scroll to results
                    resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
                } else {
                    resultsContent.innerHTML = `
                        <div class="alert alert-warning" style="background: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.3);">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            No matching records found. Try adjusting your search criteria.
                        </div>
                        ${data.totalRecordsAnalyzed ? `
                        <div class="mt-3">
                            <strong>Search analyzed:</strong> ${data.totalRecordsAnalyzed} total records<br>
                            <strong>Generations:</strong> ${data.config.generations}<br>
                            <strong>Population size:</strong> ${data.config.populationSize}
                        </div>
                        ` : ''}
                    `;
                }
            } catch (error) {
                console.error('GA search error:', error);
                resultsContent.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Search failed: ${error.message}
                    </div>
                `;
            } finally {
                searchBtn.disabled = false;
                searchBtn.innerHTML = '<i class="bi bi-search me-2"></i>Search with GA';
            }
        }

        function clearGASearch() {
            document.getElementById('gaSearchForm').reset();
            document.getElementById('gaResults').style.display = 'none';
            
            // Reset multi-field containers
            ['ga_symptoms_container', 'ga_medications_container', 'ga_treatments_container', 'ga_secondary_diagnosis_container'].forEach(containerId => {
                const container = document.getElementById(containerId);
                const firstInput = container.querySelector('input');
                if (firstInput) {
                    firstInput.value = '';
                }
                const extraGroups = container.querySelectorAll('.input-group:not(:first-child)');
                extraGroups.forEach(group => group.remove());
            });
            
            updateRemoveButtons('ga-symptom-field');
            updateRemoveButtons('ga-medication-field');
            updateRemoveButtons('ga-treatment-field');
            updateRemoveButtons('ga-secondary-diagnosis-field');
        }
    </script>
</body>
</html>
