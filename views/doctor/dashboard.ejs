<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - MediChain</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            color: #fff;
        }
        
        .top-navbar {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        .logo {
            font-size: 1.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, #00d2ff, #3a7bd5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .user-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        
        .btn-logout {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            padding: 10px 25px;
            border-radius: 25px;
            text-decoration: none;
            transition: all 0.3s;
            font-weight: 600;
        }
        
        .btn-logout:hover {
            background: rgba(255,255,255,0.2);
            color: white;
            transform: translateY(-2px);
        }
        
        .tabs-container {
            max-width: 1400px;
            margin: 30px auto;
            padding: 0 40px;
        }
        
        .tabs-nav {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }
        
        .tab-btn {
            background: rgba(30,41,59,0.6);
            border: 1px solid rgba(255,255,255,0.15);
            color: rgba(255,255,255,0.7);
            padding: 15px 30px;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
            font-size: 1rem;
        }
        
        .tab-btn:hover {
            background: rgba(30,41,59,0.8);
            color: white;
            transform: translateY(-2px);
        }
        
        .tab-btn.active {
            background: linear-gradient(135deg, #00d2ff, #3a7bd5);
            color: white;
            border-color: transparent;
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
            animation: fadeIn 0.3s;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .content-card {
            background: rgba(30,41,59,0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 20px;
            padding: 40px;
        }
        
        .form-label {
            font-weight: 600;
            color: rgba(255,255,255,0.9);
            margin-bottom: 8px;
        }
        
        .form-control, .form-select {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            padding: 12px 15px;
            border-radius: 10px;
        }
        
        .form-control:focus, .form-select:focus {
            background: rgba(255,255,255,0.15);
            border-color: #00d2ff;
            color: white;
            box-shadow: 0 0 0 3px rgba(0,210,255,0.1);
        }
        
        .form-control::placeholder {
            color: rgba(255,255,255,0.5);
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #00d2ff, #3a7bd5);
            border: none;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,210,255,0.3);
        }
        
        .file-upload-area {
            border: 3px dashed #0d9488;
            border-radius: 20px;
            padding: 50px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            margin-bottom: 30px;
            background: rgba(14,165,164,0.05);
        }
        
        .file-upload-area:hover {
            background: rgba(14,165,164,0.1);
            border-color: #00d2ff;
        }
        
        .upload-icon {
            font-size: 4rem;
            color: #00d2ff;
            margin-bottom: 20px;
        }
        
        .file-preview {
            display: none;
            background: rgba(0,210,255,0.1);
            border: 1px solid #00d2ff;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 30px;
        }
        
        .file-preview.show {
            display: block;
        }
        
        .record-card {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            transition: all 0.3s;
        }
        
        .record-card:hover {
            background: rgba(255,255,255,0.08);
            transform: translateY(-3px);
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: rgba(255,255,255,0.5);
        }
        
        .empty-state i {
            font-size: 4rem;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    
    <!-- Top Navigation Bar -->
    <div class="top-navbar">
        <div class="logo">
            <i class="bi bi-heart-pulse-fill me-2"></i>MediChain Doctor
        </div>
        <div class="user-info">
            <span><i class="bi bi-person-badge me-2"></i>Dr. <%= user.username %></span>
            <span style="opacity: 0.6;"><%= patients.length %> Patients</span>
            <a href="/logout" class="btn-logout">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
            </a>
        </div>
    </div>
    
    <!-- Tabs Container -->
    <div class="tabs-container">
        <!-- Tabs Navigation -->
        <div class="tabs-nav">
            <button class="tab-btn active" onclick="switchTab('upload')">
                <i class="bi bi-cloud-upload me-2"></i>Upload Record
            </button>
            <button class="tab-btn" onclick="switchTab('view')">
                <i class="bi bi-file-medical me-2"></i>View Records
            </button>
            <button class="tab-btn" onclick="switchTab('patients')">
                <i class="bi bi-people me-2"></i>My Patients
            </button>
            <button class="tab-btn" onclick="switchTab('allocate')">
                <i class="bi bi-person-plus me-2"></i>Allocate Patient
            </button>
            <button class="tab-btn" onclick="switchTab('update')">
                <i class="bi bi-pencil-square me-2"></i>Update Patient Info
            </button>
            <button class="tab-btn" onclick="switchTab('consented')">
                <i class="bi bi-eye-fill me-2"></i>View Granted Records
            </button>
            <button class="tab-btn" onclick="switchTab('ga-search')">
                <i class="bi bi-search me-2"></i>Find Similar Records
            </button>
        </div>
        
        <!-- Tab: Upload Record -->
        <div id="upload-tab" class="tab-content active">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-cloud-upload me-2"></i>Upload Medical Record</h3>
                
                <% if (success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i><%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                
                <% if (error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                
                <% if (patients.length === 0) { %>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        You don't have any patients assigned yet. Please contact the administrator.
                    </div>
                <% } else { %>
                
                <form action="/doctor/upload" method="POST" onsubmit="return handleUpload(event)">
                    <!-- File Upload Area -->
                    <div class="file-upload-area" id="dropZone" onclick="document.getElementById('fileInput').click()">
                        <i class="bi bi-cloud-arrow-up upload-icon"></i>
                        <h4>Drag & Drop File Here</h4>
                        <p style="color: rgba(255,255,255,0.6);">or click to browse</p>
                        <input type="file" id="fileInput" hidden accept="image/*,.pdf,.doc,.docx">
                    </div>
                    
                    <div class="file-preview" id="filePreview">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-file-earmark-check text-success me-3" style="font-size: 2rem;"></i>
                            <div class="flex-grow-1">
                                <div id="fileName" style="font-weight: 600;"></div>
                                <small id="fileSize" style="color: rgba(255,255,255,0.6);"></small>
                            </div>
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeFile()">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    
                    <input type="hidden" id="file_base64" name="file_base64">
                    <input type="hidden" id="filename" name="filename">
                    
                    <!-- Patient Selection -->
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label">Select Patient *</label>
                            <select class="form-select" name="patient_id" required>
                                <option value="">Choose a patient</option>
                                <% patients.forEach(patient => { %>
                                    <option value="<%= patient.patient_id %>">
                                        <%= patient.patient_id %> - <%= patient.username %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="form-label">File Type *</label>
                            <input type="text" class="form-control" name="file_type" 
                                   list="uploadFileTypeOptions" placeholder="Select or type file type" required>
                            <datalist id="uploadFileTypeOptions">
                                <option value="Blood Test">
                                <option value="X-Ray">
                                <option value="MRI Scan">
                                <option value="CT Scan">
                                <option value="Ultrasound">
                                <option value="ECG">
                                <option value="EEG">
                                <option value="PET Scan">
                                <option value="Prescription">
                                <option value="Lab Report">
                                <option value="Pathology Report">
                                <option value="Discharge Summary">
                                <option value="Medical Certificate">
                                <option value="Vaccination Record">
                                <option value="Operation Notes">
                                <option value="Biopsy Report">
                                <option value="Other">
                            </datalist>
                            <small class="text-muted">Select from dropdown or type custom type</small>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label">Primary Diagnosis *</label>
                            <input type="text" class="form-control" name="disease" placeholder="e.g., Hypertension" required>
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="form-label">Doctor Name</label>
                            <input type="text" class="form-control" name="doctor" value="Dr. <%= user.username %>" readonly>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" name="description" rows="3" placeholder="Additional notes..."></textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label">Status</label>
                            <select class="form-select" name="file_status">
                                <option value="Open">Open</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>
                    </div>
                    
                    <hr style="border-color: rgba(255,255,255,0.2); margin: 30px 0;">
                    <h5 class="mb-3"><i class="bi bi-clipboard2-pulse me-2"></i>Clinical Details (For GA Recommendations)</h5>
                    
                    <!-- Symptoms -->
                    <div class="form-group">
                        <label class="form-label">Symptoms</label>
                        <div id="symptomsContainer">
                            <div class="input-group mb-2">
                                <input type="text" class="form-control" name="symptoms[]" placeholder="e.g., Fever, Cough">
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-light" onclick="addField('symptomsContainer', 'symptoms')">
                            <i class="bi bi-plus-circle me-1"></i>Add Symptom
                        </button>
                    </div>
                    
                    <!-- Secondary Diagnoses -->
                    <div class="form-group">
                        <label class="form-label">Secondary Diagnoses</label>
                        <div id="diagnosesContainer">
                            <div class="input-group mb-2">
                                <input type="text" class="form-control" name="secondary_diagnosis[]" placeholder="e.g., Diabetes Type 2">
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-light" onclick="addField('diagnosesContainer', 'secondary_diagnosis')">
                            <i class="bi bi-plus-circle me-1"></i>Add Diagnosis
                        </button>
                    </div>
                    
                    <!-- Affected Body Parts -->
                    <div class="form-group">
                        <label class="form-label">Affected Body Parts</label>
                        <input type="text" class="form-control" name="affected_body_parts" placeholder="e.g., Chest, Lungs (comma-separated)">
                    </div>
                    
                    <!-- Treatments -->
                    <div class="form-group">
                        <label class="form-label">Treatments</label>
                        <div id="treatmentsContainer">
                            <div class="input-group mb-2">
                                <input type="text" class="form-control" name="treatments[]" placeholder="e.g., Physical Therapy">
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-light" onclick="addField('treatmentsContainer', 'treatments')">
                            <i class="bi bi-plus-circle me-1"></i>Add Treatment
                        </button>
                    </div>
                    
                    <!-- Medications -->
                    <div class="form-group">
                        <label class="form-label">Medications</label>
                        <div id="medicationsContainer">
                            <div class="input-group mb-2">
                                <input type="text" class="form-control" name="medications[]" placeholder="e.g., Paracetamol 500mg">
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-light" onclick="addField('medicationsContainer', 'medications')">
                            <i class="bi bi-plus-circle me-1"></i>Add Medication
                        </button>
                    </div>
                    
                    <!-- Follow-up Info -->
                    <div class="form-group">
                        <label class="form-label">Follow-up Required?</label>
                        <select class="form-select" name="followup_required" onchange="toggleFollowup(this.value)">
                            <option value="No">No</option>
                            <option value="Yes">Yes</option>
                        </select>
                    </div>
                    
                    <div id="followupDetails" style="display: none;">
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label">Follow-up Date</label>
                                <input type="date" class="form-control" name="followup_date">
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label">Follow-up Notes</label>
                                <textarea class="form-control" name="followup_notes" rows="2" placeholder="Follow-up instructions..."></textarea>
                            </div>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
                        <i class="bi bi-send me-2"></i>Upload to IPFS & Blockchain
                    </button>
                </form>
                
                <% } %>
            </div>
        </div>
        
        <!-- Tab: View Records -->
        <div id="view-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-file-medical me-2"></i>Patient Medical Records</h3>
                
                <% if (patients.length === 0) { %>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        You don't have any patients assigned yet.
                    </div>
                <% } else { %>
                
                <div class="form-group mb-4">
                    <label class="form-label">Select Patient</label>
                    <select class="form-select" id="viewPatientSelect" onchange="loadPatientRecords()">
                        <option value="">Choose a patient...</option>
                        <% patients.forEach(patient => { %>
                            <option value="<%= patient.patient_id %>">
                                <%= patient.patient_id %> - <%= patient.username %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                
                <div id="patientRecordsList">
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <h5>Select a patient to view records</h5>
                    </div>
                </div>
                
                <% } %>
            </div>
        </div>
        
        <!-- Tab: My Patients -->
        <div id="patients-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-people me-2"></i>My Assigned Patients</h3>
                
                <% if (patients.length === 0) { %>
                    <div class="empty-state">
                        <i class="bi bi-people"></i>
                        <h5>No patients assigned yet</h5>
                        <p>Go to the "Allocate Patient" tab to add patients to your list.</p>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table" style="color: white;">
                            <thead>
                                <tr>
                                    <th>Patient ID</th>
                                    <th>Name</th>
                                    <th>Gender</th>
                                    <th>Blood Group</th>
                                    <th>Contact</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% patients.forEach(patient => { %>
                                    <tr>
                                        <td><%= patient.patient_id %></td>
                                        <td><%= patient.username %></td>
                                        <td><%= patient.gender || 'N/A' %></td>
                                        <td><%= patient.blood_group || 'N/A' %></td>
                                        <td><%= patient.contact || 'N/A' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
        
        <!-- Tab: Update Patient Info -->
        <div id="update-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-pencil-square me-2"></i>Update Patient Medical Information</h3>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Select Patient</label>
                            <select class="form-select" id="updatePatientSelect" onchange="loadPatientInfo()">
                                <option value="">Choose a patient...</option>
                                <% patients.forEach(patient => { %>
                                    <option value="<%= patient.patient_id %>">
                                        <%= patient.patient_id %> - <%= patient.username %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </div>
                
                <div id="patientInfoForm" style="display: none;">
                    <hr style="border-color: rgba(255,255,255,0.2); margin: 30px 0;">
                    <h5 class="mb-3">Medical Information (Editable)</h5>
                    <form id="updateMedicalForm">
                        <input type="hidden" id="update_patient_id" name="patient_id">
                        
                        <div class="row">
                            <div class="col-md-12 form-group">
                                <label class="form-label">Blood Group</label>
                                <select class="form-select" name="blood_group" id="update_blood_group">
                                    <option value="">Not Specified</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label">Height (cm)</label>
                                <input type="number" class="form-control" name="height" id="update_height" placeholder="e.g., 175">
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label">Weight (kg)</label>
                                <input type="number" class="form-control" name="weight" id="update_weight" placeholder="e.g., 70">
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">Current Conditions</label>
                            <textarea class="form-control" name="current_conditions" id="update_conditions" rows="3" placeholder="e.g., Diabetes, Hypertension"></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 mt-3">
                            <i class="bi bi-save me-2"></i>Update Medical Information
                        </button>
                    </form>
                    
                    <hr style="border-color: rgba(255,255,255,0.2); margin: 30px 0;">
                    <h5 class="mb-3">Personal Information (Read-Only)</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong>Name:</strong> <span id="display_name" style="color: rgba(255,255,255,0.7);">-</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Gender:</strong> <span id="display_gender" style="color: rgba(255,255,255,0.7);">-</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Date of Birth:</strong> <span id="display_dob" style="color: rgba(255,255,255,0.7);">-</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Contact:</strong> <span id="display_contact" style="color: rgba(255,255,255,0.7);">-</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Email:</strong> <span id="display_email" style="color: rgba(255,255,255,0.7);">-</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Tab: Allocate Patient -->
        <div id="allocate-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-person-plus me-2"></i>Allocate Patient to Myself</h3>
                
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="mb-3">Add New Patient</h5>
                        <form id="allocateForm">
                            <div class="form-group mb-3">
                                <label class="form-label">Select Patient</label>
                                <select class="form-select" id="patientSelectAlloc" required>
                                    <option value="">Choose a patient...</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-plus-circle me-2"></i>Allocate Patient
                            </button>
                        </form>
                    </div>
                    
                    <div class="col-md-6">
                        <h5 class="mb-3">My Current Allocations</h5>
                        <div id="myAllocationsTable" style="max-height: 400px; overflow-y: auto;">
                            <div class="text-center py-4">
                                <div class="spinner-border text-primary"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Tab: View Granted Records -->
    <div id="consented-tab" class="tab-content">
        <div class="content-card">
            <h3 class="mb-4"><i class="bi bi-eye-fill me-2"></i>Records Shared With You</h3>
            
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Select Patient:</label>
                    <select class="form-select" id="consentedPatientSelectDoctor" onchange="loadConsentedRecordsDoctor()" onclick="if(this.options.length <= 1) loadPatientsGrantedToDoctor()">
                        <option value="">Choose patient...</option>
                    </select>
                    <small class="text-muted">Click to refresh if empty</small>
                </div>
                <div class="col-md-8 mb-3">
                    <label class="form-label">&nbsp;</label><br>
                    <button type="button" class="btn btn-sm btn-primary" onclick="loadPatientsGrantedToDoctor()">
                        <i class="bi bi-arrow-clockwise me-2"></i>Refresh Patient List
                    </button>
                </div>
            </div>
            
            <div id="consentedRecordsListDoctor">
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h5>Select a patient to view their shared records</h5>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Tab: Find Similar Records (GA Search) -->
    <div id="ga-search-tab" class="tab-content">
        <div class="content-card">
            <div class="mb-4">
                <h3><i class="bi bi-search me-2"></i>Find Similar Medical Records</h3>
            </div>

            <!-- Search Mode Toggle -->
            <div class="btn-group mb-4 w-100" role="group">
                <button type="button" class="btn btn-primary active" id="myRecordsBtn" onclick="switchSearchMode('my-records')">
                    <i class="bi bi-folder me-2"></i>My Records
                </button>
                <button type="button" class="btn btn-outline-primary" id="analyticsBtn" onclick="switchSearchMode('analytics')">
                    <i class="bi bi-graph-up me-2"></i>Database Analytics
                </button>
            </div>

            <input type="hidden" id="searchMode" value="my-records">

            <!-- Search Form -->
            <form id="gaSearchForm" onsubmit="performGASearch(event)">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-file-earmark-medical me-2"></i>File Type
                            </label>
                            <input type="text" class="form-control" id="ga_file_type" 
                                   list="gaFileTypeOptions" placeholder="All file types or type specific">
                            <datalist id="gaFileTypeOptions">
                                <option value="">
                                <option value="Blood Test">
                                <option value="X-Ray">
                                <option value="MRI Scan">
                                <option value="CT Scan">
                                <option value="Ultrasound">
                                <option value="ECG">
                                <option value="EEG">
                                <option value="PET Scan">
                                <option value="Prescription">
                                <option value="Lab Report">
                                <option value="Pathology Report">
                                <option value="Discharge Summary">
                                <option value="Medical Certificate">
                                <option value="Vaccination Record">
                                <option value="Operation Notes">
                                <option value="Biopsy Report">
                                <option value="Other">
                            </datalist>
                            <small class="text-muted">Optional: Select or type specific file type for exact matching</small>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-person me-2"></i>Patient
                            </label>
                            <select class="form-select" id="ga_patient_id">
                                <option value="">All Patients</option>
                                <% if (patients && patients.length > 0) { %>
                                    <% patients.forEach(patient => { %>
                                        <option value="<%= patient.patient_id %>">
                                            <%= patient.patient_id %> - <%= patient.username || 'Unnamed' %>
                                        </option>
                                    <% }); %>
                                <% } %>
                            </select>
                            <small class="text-muted">Optional: Filter by specific patient</small>
                        </div>
                    </div>
                </div>

                <!-- Primary Medical Criteria -->
                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-clipboard-pulse me-2"></i>Primary Diagnosis
                            </label>
                            <input type="text" class="form-control" id="ga_primary_diagnosis" 
                                   placeholder="e.g., Pneumonia, Diabetes Type 2">
                            <small class="text-muted"><strong>Weight: Very High</strong> - Main medical condition</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-thermometer-half me-2"></i>Symptoms
                            </label>
                            <div id="ga_symptoms_container">
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control ga-symptom-field" 
                                           placeholder="e.g., fever, headache, cough">
                                    <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)" style="display:none;">
                                        <i class="bi bi-dash-circle"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addGASymptom()">
                                <i class="bi bi-plus-circle me-1"></i>Add More Symptoms
                            </button>
                            <div><small class="text-muted"><strong>Weight: Very High</strong></small></div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-heart-pulse me-2"></i>Affected Body Parts / Organs
                            </label>
                            <input type="text" class="form-control" id="ga_body_parts" 
                                   placeholder="e.g., lungs, chest, heart">
                            <small class="text-muted"><strong>Weight: High</strong></small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-capsule me-2"></i>Medications
                            </label>
                            <div id="ga_medications_container">
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control ga-medication-field" 
                                           placeholder="e.g., Amoxicillin 500mg">
                                    <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)" style="display:none;">
                                        <i class="bi bi-dash-circle"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addGAMedication()">
                                <i class="bi bi-plus-circle me-1"></i>Add More Medications
                            </button>
                            <div><small class="text-muted"><strong>Weight: Medium-High</strong></small></div>
                        </div>
                    </div>
                </div>

                <!-- Additional Fields -->
                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-prescription2 me-2"></i>Treatments Given
                            </label>
                            <div id="ga_treatments_container">
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control ga-treatment-field" 
                                           placeholder="e.g., Oxygen therapy, Physical therapy">
                                    <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)" style="display:none;">
                                        <i class="bi bi-dash-circle"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addGATreatment()">
                                <i class="bi bi-plus-circle me-1"></i>Add More Treatments
                            </button>
                            <div><small class="text-muted"><strong>Weight: Medium</strong></small></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-clipboard-check me-2"></i>Secondary Diagnoses
                            </label>
                            <div id="ga_secondary_diagnosis_container">
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control ga-secondary-diagnosis-field" 
                                           placeholder="e.g., Hypertension, Asthma">
                                    <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)" style="display:none;">
                                        <i class="bi bi-dash-circle"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addGASecondaryDiagnosis()">
                                <i class="bi bi-plus-circle me-1"></i>Add More
                            </button>
                            <div><small class="text-muted"><strong>Weight: Medium</strong></small></div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-journal-medical me-2"></i>General Medical Conditions / Notes
                            </label>
                            <textarea class="form-control" id="ga_conditions" rows="2" 
                                      placeholder="e.g., chronic conditions, additional medical history"></textarea>
                            <small class="text-muted"><strong>Weight: Medium</strong> - Free text for any additional context</small>
                        </div>
                    </div>
                </div>

                <!-- Demographic & Administrative Filters -->
                <div class="alert alert-info mt-3" style="background: rgba(13, 202, 240, 0.25); border: 1px solid rgba(13, 202, 240, 0.5); color: #4dd4ff;">
                    <strong><i class="bi bi-funnel me-2"></i>Demographic & Administrative Filters</strong>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-droplet me-2"></i>Blood Group
                            </label>
                            <select class="form-select" id="ga_blood_group">
                                <option value="">All Blood Groups</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>
                            <small class="text-muted">Patient's blood group</small>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-gender-ambiguous me-2"></i>Gender
                            </label>
                            <select class="form-select" id="ga_gender">
                                <option value="">Any Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <small class="text-muted">Patient's gender</small>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-calendar-range me-2"></i>Age Range
                            </label>
                            <select class="form-select" id="ga_age_range">
                                <option value="">Any Age</option>
                                <option value="0-12">Pediatric (0-12)</option>
                                <option value="13-19">Adolescent (13-19)</option>
                                <option value="20-39">Young Adult (20-39)</option>
                                <option value="40-59">Middle Age (40-59)</option>
                                <option value="60-150">Senior (60+)</option>
                            </select>
                            <small class="text-muted">Patient's age group</small>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-list-ol me-2"></i>Number of Results
                            </label>
                            <input type="number" class="form-control" id="ga_limit" 
                                   value="10" min="1" max="50">
                            <small class="text-muted">Maximum results to return (1-50)</small>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg" id="gaSearchBtn">
                        <i class="bi bi-search me-2"></i>Search with GA
                    </button>
                    <button type="button" class="btn btn-secondary btn-lg" onclick="clearGASearch()">
                        <i class="bi bi-x-circle me-2"></i>Clear
                    </button>
                </div>
            </form>

            <!-- Results Section -->
            <div id="gaResults" style="display: none; margin-top: 40px;">
                <h4 class="mb-4">
                    <i class="bi bi-list-check me-2"></i>Search Results
                    <span id="gaResultCount" class="badge bg-primary ms-2">0</span>
                </h4>
                <div id="gaResultsContent"></div>
            </div>
        </div>
    </div>
    
    <!-- File Preview Modal -->
    <div class="modal fade" id="filePreviewModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content" style="background: #1a1a2e; color: white;">
                <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-text me-2"></i>Medical Record Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="modalContent">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                        <p class="mt-3">Loading record...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tab Switching
        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            
            event.target.classList.add('active');
            document.getElementById(tabName + '-tab').classList.add('active');
            
            if (tabName === 'consented') {
                loadPatientsGrantedToDoctor();
            }
        }
        
        // File Upload Handling
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        
        if (dropZone && fileInput) {
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.style.borderColor = '#00d2ff';
            });
            
            dropZone.addEventListener('dragleave', () => {
                dropZone.style.borderColor = '#0d9488';
            });
            
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.style.borderColor = '#0d9488';
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    handleFileSelect(files[0]);
                }
            });
            
            fileInput.addEventListener('change', (e) => {
                if (e.target.files.length > 0) {
                    handleFileSelect(e.target.files[0]);
                }
            });
        }
        
        function handleFileSelect(file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const base64 = e.target.result;
                document.getElementById('file_base64').value = base64;
                document.getElementById('filename').value = file.name;
                document.getElementById('fileName').textContent = file.name;
                document.getElementById('fileSize').textContent = (file.size / 1024).toFixed(2) + ' KB';
                document.getElementById('filePreview').classList.add('show');
            };
            reader.readAsDataURL(file);
        }
        
        function removeFile() {
            fileInput.value = '';
            document.getElementById('file_base64').value = '';
            document.getElementById('filename').value = '';
            document.getElementById('filePreview').classList.remove('show');
        }
        
        function handleUpload(e) {
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Uploading...';
            return true;
        }
        
        // Add dynamic field
        function addField(containerId, fieldName) {
            const container = document.getElementById(containerId);
            const newField = document.createElement('div');
            newField.className = 'input-group mb-2';
            newField.innerHTML = `
                <input type="text" class="form-control" name="${fieldName}[]" placeholder="Enter ${fieldName.replace('_', ' ')}">
                <button type="button" class="btn btn-danger" onclick="this.parentElement.remove()">
                    <i class="bi bi-trash"></i>
                </button>
            `;
            container.appendChild(newField);
        }
        
        // Toggle follow-up details
        function toggleFollowup(value) {
            const details = document.getElementById('followupDetails');
            details.style.display = value === 'Yes' ? 'block' : 'none';
        }
        
        // Load patient information for update
        async function loadPatientInfo() {
            const patientId = document.getElementById('updatePatientSelect').value;
            const formContainer = document.getElementById('patientInfoForm');
            
            if (!patientId) {
                formContainer.style.display = 'none';
                return;
            }
            
            try {
                const response = await fetch(`/doctor/api/patient-info/${patientId}`);
                const data = await response.json();
                
                if (data.success && data.patient) {
                    const p = data.patient;
                    
                    // Populate editable fields
                    document.getElementById('update_patient_id').value = p.patient_id;
                    document.getElementById('update_blood_group').value = p.blood_group || '';
                    document.getElementById('update_height').value = p.height || '';
                    document.getElementById('update_weight').value = p.weight || '';
                    document.getElementById('update_conditions').value = p.current_conditions || '';
                    
                    // Display read-only fields
                    document.getElementById('display_name').textContent = p.username || 'N/A';
                    document.getElementById('display_gender').textContent = p.gender || 'N/A';
                    
                    // Format Date of Birth
                    if (p.date_of_birth) {
                        const dob = new Date(p.date_of_birth);
                        document.getElementById('display_dob').textContent = dob.toLocaleDateString('en-US', { 
                            year: 'numeric', 
                            month: 'short', 
                            day: 'numeric' 
                        });
                    } else {
                        document.getElementById('display_dob').textContent = 'N/A';
                    }
                    
                    document.getElementById('display_contact').textContent = p.contact || 'N/A';
                    document.getElementById('display_email').textContent = p.email || 'N/A';
                    
                    formContainer.style.display = 'block';
                } else {
                    alert('Failed to load patient information');
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }
        
        // Update medical information form submit
        document.getElementById('updateMedicalForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);
            
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Updating...';
            
            try {
                const response = await fetch('/doctor/update-patient-info', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('✅ Medical information updated successfully!');
                } else {
                    alert('❌ ' + result.error);
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-save me-2"></i>Update Medical Information';
            }
        });
        
        // Load Patient Records
        async function loadPatientRecords() {
            const patientId = document.getElementById('viewPatientSelect').value;
            const container = document.getElementById('patientRecordsList');
            
            if (!patientId) {
                container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>Select a patient</h5></div>';
                return;
            }
            
            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch(`/doctor/api/patient-records/${patientId}`);
                const data = await response.json();
                
                if (data.success && data.blocks.length > 0) {
                    let html = '';
                    data.blocks.forEach(block => {
                        const hasCid = block.ipfs_cid && block.ipfs_cid !== 'N/A';
                        html += `
                            <div class="record-card">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h5 style="color: #00d2ff;">${block.file_type || 'Medical Record'}</h5>
                                        <p class="mb-1"><strong>Date:</strong> ${new Date(parseInt(block.timestamp)).toLocaleString()}</p>
                                        <p class="mb-1"><strong>Status:</strong> <span class="badge ${block.file_status === 'Closed' ? 'bg-secondary' : 'bg-success'}">${block.file_status || 'Open'}</span></p>
                                    </div>
                                    ${hasCid ? `<button class="btn btn-primary" onclick="viewRecord('${block.ipfs_cid}')">
                                        <i class="bi bi-eye me-2"></i>View Details
                                    </button>` : '<span class="badge bg-secondary">No Data</span>'}
                                </div>
                            </div>
                        `;
                    });
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>No records found</h5></div>';
                }
            } catch (error) {
                container.innerHTML = '<div class="alert alert-danger">Error: ' + error.message + '</div>';
            }
        }
        
        // View Record Details
        async function viewRecord(cid) {
            const modal = new bootstrap.Modal(document.getElementById('filePreviewModal'));
            const modalContent = document.getElementById('modalContent');
            
            modalContent.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3">Loading record...</p></div>';
            modal.show();
            
            try {
                const response = await fetch(`/doctor/api/fetch-ipfs/${cid}`);
                const result = await response.json();
                
                if (result.success) {
                    const data = result.data;
                    
                    // Normalize data keys - handle both formats (capitalized with spaces AND lowercase with underscores)
                    const normalizedData = {
                        patient_name: data.patient_name || data['Patient Name'] || 'N/A',
                        patient_id: data.patient_id || data['Patient ID'] || 'N/A',
                        file_type: data.file_type || data['File Type'] || 'N/A',
                        primary_diagnosis: data.primary_diagnosis || data['Disease'] || 'N/A',
                        file_status: data.file_status || data['File Status'] || 'Open',
                        doctor: data.doctor || 'N/A',
                        uploaded_by: data.uploaded_by || data['Uploaded By'] || 'N/A',
                        timestamp: data.timestamp || data['Timestamp'] || 'N/A',
                        description: data.description || data['Description'] || '',
                        file_base64: data.file_base64 || data.file_data || null,
                        filename: data.filename || 'N/A',
                        symptoms: data.symptoms || [],
                        secondary_diagnoses: data.secondary_diagnoses || data.secondary_diagnosis || [],
                        affected_body_parts: data.affected_body_parts || [],
                        treatments_given: data.treatments_given || data.treatments || [],
                        medications: data.medications || [],
                        followup_info: data.followup_info || {}
                    };
                    
                    // Format timestamp to be readable
                    let formattedTimestamp = normalizedData.timestamp;
                    if (formattedTimestamp !== 'N/A') {
                        try {
                            const date = new Date(formattedTimestamp);
                            formattedTimestamp = date.toLocaleString('en-US', {
                                year: 'numeric',
                                month: 'short',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit',
                                hour12: true
                            });
                        } catch (e) {
                            // Keep original if parsing fails
                        }
                    }
                    normalizedData.timestamp = formattedTimestamp;
                    
                    let html = '<div class=\"container-fluid\">';
                    
                    // Metadata Section
                    html += '<div class=\"row mb-4\">';
                    html += '<div class=\"col-md-6\">';
                    html += `<div class=\"metadata-item\"><strong>Patient Name:</strong> <span style=\"color: #e4e4e7;\">${normalizedData.patient_name}</span></div>`;
                    html += `<div class=\"metadata-item\"><strong>Patient ID:</strong> <span style=\"color: #e4e4e7;\">${normalizedData.patient_id}</span></div>`;
                    html += `<div class=\"metadata-item\"><strong>File Type:</strong> <span style=\"color: #e4e4e7;\">${normalizedData.file_type}</span></div>`;
                    html += `<div class=\"metadata-item\"><strong>Primary Diagnosis:</strong> <span style=\"color: #e4e4e7;\">${normalizedData.primary_diagnosis}</span></div>`;
                    html += '</div>';
                    html += '<div class=\"col-md-6\">';
                    html += `<div class=\"metadata-item\"><strong>Status:</strong> <span class=\"badge ${normalizedData.file_status === 'Closed' ? 'bg-secondary' : 'bg-success'}\">${normalizedData.file_status}</span></div>`;
                    html += `<div class=\"metadata-item\"><strong>Doctor:</strong> <span style=\"color: #e4e4e7;\">${normalizedData.doctor}</span></div>`;
                    html += `<div class=\"metadata-item\"><strong>Uploaded By:</strong> <span style=\"color: #e4e4e7;\">${normalizedData.uploaded_by}</span></div>`;
                    html += `<div class=\"metadata-item\"><strong>Timestamp:</strong> <span style=\"color: #e4e4e7;\">${normalizedData.timestamp}</span></div>`;
                    html += '</div>';
                    html += '</div>';
                    
                    // Symptoms
                    if (normalizedData.symptoms && normalizedData.symptoms.length > 0) {
                        html += '<div class=\"alert alert-primary\" style=\"background: rgba(59,130,246,0.15); border: 2px solid rgba(59,130,246,0.4);\">';
                        html += '<strong style=\"font-size: 1.1rem; color: #3b82f6;\"><i class=\"bi bi-thermometer-half me-2\"></i>Symptoms:</strong><br>';
                        html += '<div class=\"mt-2\">';
                        html += normalizedData.symptoms.map(s => `<span class=\"badge bg-primary me-1 mb-1\" style=\"font-size: 0.9rem; padding: 0.5rem 0.75rem;\">${s}</span>`).join('');
                        html += '</div></div>';
                    }
                    
                    // Secondary Diagnoses
                    if (normalizedData.secondary_diagnoses && normalizedData.secondary_diagnoses.length > 0) {
                        html += '<div class=\"alert alert-warning\" style=\"background: rgba(251,191,36,0.1); border-color: rgba(251,191,36,0.3);\">';
                        html += '<strong><i class=\"bi bi-clipboard-check me-2\"></i>Secondary Diagnoses:</strong> ';
                        html += normalizedData.secondary_diagnoses.map(d => `<span class=\"badge bg-warning text-dark me-1\">${d}</span>`).join('');
                        html += '</div>';
                    }
                    
                    // Body Parts Affected
                    if (normalizedData.affected_body_parts && normalizedData.affected_body_parts.length > 0) {
                        html += '<div class=\"alert alert-danger\" style=\"background: rgba(239,68,68,0.1); border-color: rgba(239,68,68,0.3);\">';
                        html += '<strong><i class=\"bi bi-heart-pulse me-2\"></i>Affected Areas:</strong> ';
                        html += normalizedData.affected_body_parts.map(p => `<span class=\"badge bg-danger me-1\">${p}</span>`).join('');
                        html += '</div>';
                    }
                    
                    // Treatments and Medications
                    if ((normalizedData.treatments_given && normalizedData.treatments_given.length > 0) || (normalizedData.medications && normalizedData.medications.length > 0)) {
                        html += '<div class=\"row mb-3\">';
                        if (normalizedData.treatments_given && normalizedData.treatments_given.length > 0) {
                            html += '<div class=\"col-md-6\">';
                            html += '<div class=\"alert alert-success\" style=\"background: rgba(34,197,94,0.15); border: 2px solid rgba(34,197,94,0.4);\">';
                            html += '<strong style=\"font-size: 1.1rem; color: #22c55e;\"><i class=\"bi bi-capsule me-2\"></i>Treatments:</strong><ul class=\"mt-2 mb-0\" style=\"color: #e4e4e7; font-size: 0.95rem;\">';
                            normalizedData.treatments_given.forEach(t => html += `<li style=\"margin-bottom: 0.5rem;\"><strong>${t}</strong></li>`);
                            html += '</ul></div></div>';
                        }
                        if (normalizedData.medications && normalizedData.medications.length > 0) {
                            html += '<div class=\"col-md-6\">';
                            html += '<div class=\"alert alert-info\" style=\"background: rgba(6,182,212,0.15); border: 2px solid rgba(6,182,212,0.4);\">';
                            html += '<strong style=\"font-size: 1.1rem; color: #06b6d4;\"><i class=\"bi bi-prescription2 me-2\"></i>Medications:</strong><ul class=\"mt-2 mb-0\" style=\"color: #e4e4e7; font-size: 0.95rem;\">';
                            normalizedData.medications.forEach(m => html += `<li style=\"margin-bottom: 0.5rem;\"><strong>${m}</strong></li>`);
                            html += '</ul></div></div>';
                        }
                        html += '</div>';
                    }
                    
                    // Follow-up Information
                    if (normalizedData.followup_info && normalizedData.followup_info.required) {
                        html += '<div class=\"alert alert-secondary\" style=\"background: rgba(148,163,184,0.15); border: 2px solid rgba(148,163,184,0.4);\">';
                        html += '<strong style=\"font-size: 1.1rem; color: #94a3b8;\"><i class=\"bi bi-calendar-check me-2\"></i>Follow-up Required:</strong> ';
                        if (normalizedData.followup_info.date) html += `<span class=\"text-warning\" style=\"font-weight: bold; font-size: 1rem;\">\ud83d\udcc5 ${normalizedData.followup_info.date}</span> `;
                        if (normalizedData.followup_info.notes) html += `<br><small style=\"color: #e4e4e7; font-size: 0.9rem; margin-top: 0.5rem; display: inline-block;\">${normalizedData.followup_info.notes}</small>`;
                        html += '</div>';
                    }
                    
                    // Description
                    if (normalizedData.description && normalizedData.description !== 'No additional notes') {
                        html += '<div class=\"alert alert-light\" style=\"background: rgba(241,245,249,0.15); border: 2px solid rgba(241,245,249,0.3); padding: 1.25rem;\">';
                        html += '<strong style=\"font-size: 1.1rem; color: #00d2ff;\"><i class=\"bi bi-clipboard-text me-2\"></i>Additional Notes:</strong>';
                        html += `<p style=\"color: #e4e4e7; margin-top: 0.75rem; margin-bottom: 0; font-size: 0.95rem; line-height: 1.6;\">${normalizedData.description}</p>`;
                        html += '</div>';
                    }
                    
                    // File Preview
                    if (normalizedData.file_base64) {
                        html += '<h5 class=\"mt-4 mb-3\" style=\"color: #00d2ff;\">File Preview:</h5>';
                        const fileType = (normalizedData.file_type || '').toLowerCase();
                        const filename = (normalizedData.filename || 'medical_file').toLowerCase();
                        
                        const isPDF = fileType.includes('pdf') || filename.endsWith('.pdf') || normalizedData.file_base64.startsWith('data:application/pdf');
                        const isImage = fileType.includes('image') || fileType.includes('x-ray') || fileType.includes('scan') || 
                                       fileType.includes('mri') || fileType.includes('ct') ||
                                       filename.match(/\\.(jpg|jpeg|png|gif|bmp)$/i) ||
                                       normalizedData.file_base64.startsWith('data:image/');
                        
                        let fileData = normalizedData.file_base64;
                        if (!fileData.startsWith('data:')) {
                            if (isPDF) {
                                fileData = 'data:application/pdf;base64,' + fileData;
                            } else if (isImage) {
                                fileData = 'data:image/jpeg;base64,' + fileData;
                            }
                        }
                        
                        if (isPDF) {
                            html += `
                                <div class=\"mb-3\">
                                    <div style=\"background: #1e293b; padding: 20px; border-radius: 15px;\">
                                        <iframe 
                                            src=\"${fileData}#toolbar=1&navpanes=1&scrollbar=1\" 
                                            type=\"application/pdf\"
                                            width=\"100%\" 
                                            height=\"700px\" 
                                            style=\"border: none; border-radius: 10px; background: white;\">
                                        </iframe>
                                    </div>
                                    <div class=\"text-center mt-3\">
                                        <a href=\"${fileData}\" download=\"${normalizedData.filename}\" class=\"btn btn-primary\">
                                            <i class=\"bi bi-download me-2\"></i>Download PDF
                                        </a>
                                    </div>
                                </div>
                            `;
                        } else if (isImage) {
                            html += `
                                <div class=\"text-center mb-3\">
                                    <img src=\"${fileData}\" class=\"img-fluid\" alt=\"Medical Image\" style=\"max-width: 100%; border-radius: 15px; box-shadow: 0 5px 20px rgba(0,0,0,0.3);\"/>
                                    <div class=\"mt-3\">
                                        <a href=\"${fileData}\" download=\"${normalizedData.filename}\" class=\"btn btn-primary\">
                                            <i class=\"bi bi-download me-2\"></i>Download Image
                                        </a>
                                    </div>
                                </div>
                            `;
                        } else {
                            html += `
                                <div class=\"text-center p-5\" style=\"background: rgba(15,52,96,0.4); border-radius: 15px;\">
                                    <i class=\"bi bi-file-earmark-text\" style=\"font-size: 4rem; color: #00d2ff;\"></i>
                                    <p class=\"mt-3\" style=\"color: #e4e4e7;\">File type: ${normalizedData.file_type}</p>
                                    <p class=\"text-muted\">Preview not available for this file type</p>
                                    <small class=\"text-muted\">Filename: ${normalizedData.filename}</small>
                                    <div class=\"mt-3\">
                                        <a href=\"${fileData}\" download=\"${normalizedData.filename}\" class=\"btn btn-primary\">
                                            <i class=\"bi bi-download me-2\"></i>Download File
                                        </a>
                                    </div>
                                </div>
                            `;
                        }
                    } else {
                        html += '<div class=\"alert alert-warning mt-4\">No file attached to this record.</div>';
                    }
                    
                    html += '</div>';
                    modalContent.innerHTML = html;
                } else {
                    modalContent.innerHTML = '<div class=\"alert alert-danger\">Error fetching record: ' + result.error + '</div>';
                }
            } catch (error) {
                modalContent.innerHTML = '<div class=\"alert alert-danger\">Error: ' + error.message + '</div>';
            }
        }
        
        // Load allocation data when tab is opened
        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            
            event.target.classList.add('active');
            document.getElementById(tabName + '-tab').classList.add('active');
            
            if (tabName === 'allocate') {
                loadAllocationData();
            }
        }
        
        // Load all patients and current allocations
        async function loadAllocationData() {
            // Load all patients for dropdown
            try {
                const response = await fetch('/doctor/api/all-patients');
                const data = await response.json();
                
                const select = document.getElementById('patientSelectAlloc');
                select.innerHTML = '<option value="">Choose a patient...</option>';
                
                if (data.success && data.patients) {
                    data.patients.forEach(patient => {
                        select.innerHTML += `<option value="${patient.patient_id}">${patient.patient_id} - ${patient.username}</option>`;
                    });
                }
            } catch (error) {
                console.error('Error loading patients:', error);
            }
            
            // Load current allocations
            loadMyAllocations();
        }
        
        // Load doctor's current patient allocations
        async function loadMyAllocations() {
            const container = document.getElementById('myAllocationsTable');
            container.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch('/doctor/api/my-allocations');
                const data = await response.json();
                
                if (data.success && data.relations.length > 0) {
                    let html = '<table class="table table-sm" style="color: white;"><thead><tr><th>Patient ID</th><th>Name</th><th>Action</th></tr></thead><tbody>';
                    data.relations.forEach(rel => {
                        html += `
                            <tr>
                                <td>${rel.pat_id}</td>
                                <td>${rel.patient_name}</td>
                                <td><button class="btn btn-sm btn-danger" onclick="removeAllocation('${rel.pat_id}')"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        `;
                    });
                    html += '</tbody></table>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<p class="text-center" style="color: rgba(255,255,255,0.5);">No allocations yet</p>';
                }
            } catch (error) {
                container.innerHTML = '<div class="alert alert-danger">Error loading allocations</div>';
            }
        }
        
        // Allocate patient to self
        document.getElementById('allocateForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const patientId = document.getElementById('patientSelectAlloc').value;
            if (!patientId) return;
            
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Allocating...';
            
            try {
                const response = await fetch('/doctor/allocate-patient', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ patient_id: patientId })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('✅ Patient allocated successfully!');
                    document.getElementById('patientSelectAlloc').value = '';
                    loadMyAllocations();
                    // Reload page to update patient lists
                    setTimeout(() => location.reload(), 1000);
                } else {
                    alert('❌ ' + result.error);
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-plus-circle me-2"></i>Allocate Patient';
            }
        });
        
        // Remove patient allocation
        async function removeAllocation(patientId) {
            if (!confirm('Remove this patient from your list?')) return;
            
            try {
                const response = await fetch('/doctor/remove-patient', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ patient_id: patientId })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('✅ Patient removed successfully!');
                    loadMyAllocations();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    alert('❌ ' + result.error);
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            }
        }
        
        // ===========================================
        // CONSENT MANAGEMENT FOR DOCTOR
        // ===========================================
        
        // Load patients who granted consent to this doctor
        async function loadPatientsGrantedToDoctor() {
            const select = document.getElementById('consentedPatientSelectDoctor');
            
            if (!select) {
                return;
            }
            
            select.innerHTML = '<option value="">Loading...</option>';
            
            try {
                const response = await fetch('/doctor/api/patients-granted-to-me');
                const data = await response.json();
                
                if (data.success) {
                    select.innerHTML = '<option value="">Choose patient...</option>';
                    if (data.patients && data.patients.length > 0) {
                        data.patients.forEach(patient => {
                            select.innerHTML += `<option value="${patient.patient_id}">${patient.patient_id} - ${patient.username}</option>`;
                        });
                    } else {
                        select.innerHTML = '<option value="">No patients have granted you access</option>';
                    }
                } else {
                    select.innerHTML = '<option value="">Error loading</option>';
                }
            } catch (error) {
                select.innerHTML = '<option value="">Error loading</option>';
            }
        }
        
        // Load consented records for doctor
        async function loadConsentedRecordsDoctor() {
            const patientId = document.getElementById('consentedPatientSelectDoctor').value;
            const container = document.getElementById('consentedRecordsListDoctor');
            
            if (!patientId) {
                container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>Select a patient</h5></div>';
                return;
            }
            
            container.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch(`/doctor/api/consented-blocks/${patientId}`);
                const data = await response.json();
                
                if (data.success && data.blocks.length > 0) {
                    let html = '';
                    data.blocks.forEach(block => {
                        const hasCid = block.ipfs_cid && block.ipfs_cid !== 'N/A';
                        html += `
                            <div class="record-card">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h5 style="color: #00d2ff;">${block.file_type || 'Medical Record'}</h5>
                                        <p class="mb-1"><strong>Date:</strong> ${new Date(parseInt(block.timestamp)).toLocaleString()}</p>
                                        <p class="mb-1"><strong>Status:</strong> <span class="badge ${block.file_status === 'Closed' ? 'bg-secondary' : 'bg-success'}">${block.file_status || 'Open'}</span></p>
                                        <span class="badge bg-info">Block #${block.block_index}</span>
                                    </div>
                                    ${hasCid ? `<button class="btn btn-primary" onclick="viewRecord('${block.ipfs_cid}')">
                                        <i class="bi bi-eye me-2"></i>View Details
                                    </button>` : '<span class="badge bg-secondary">No Data</span>'}
                                </div>
                            </div>
                        `;
                    });
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>No records shared</h5></div>';
                }
            } catch (error) {
                container.innerHTML = '<div class="alert alert-danger">Error loading records</div>';
            }
        }

        // GA Search Functions
        function addGASymptom() {
            const container = document.getElementById('ga_symptoms_container');
            const inputGroup = document.createElement('div');
            inputGroup.className = 'input-group mb-2';
            inputGroup.innerHTML = `
                <input type="text" class="form-control ga-symptom-field" placeholder="e.g., fever, headache">
                <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)">
                    <i class="bi bi-dash-circle"></i>
                </button>
            `;
            container.appendChild(inputGroup);
            updateRemoveButtons('ga-symptom-field');
        }

        function addGAMedication() {
            const container = document.getElementById('ga_medications_container');
            const inputGroup = document.createElement('div');
            inputGroup.className = 'input-group mb-2';
            inputGroup.innerHTML = `
                <input type="text" class="form-control ga-medication-field" placeholder="e.g., Amoxicillin 500mg">
                <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)">
                    <i class="bi bi-dash-circle"></i>
                </button>
            `;
            container.appendChild(inputGroup);
            updateRemoveButtons('ga-medication-field');
        }

        function addGATreatment() {
            const container = document.getElementById('ga_treatments_container');
            const inputGroup = document.createElement('div');
            inputGroup.className = 'input-group mb-2';
            inputGroup.innerHTML = `
                <input type="text" class="form-control ga-treatment-field" placeholder="e.g., Oxygen therapy, Physical therapy">
                <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)">
                    <i class="bi bi-dash-circle"></i>
                </button>
            `;
            container.appendChild(inputGroup);
            updateRemoveButtons('ga-treatment-field');
        }

        function addGASecondaryDiagnosis() {
            const container = document.getElementById('ga_secondary_diagnosis_container');
            const inputGroup = document.createElement('div');
            inputGroup.className = 'input-group mb-2';
            inputGroup.innerHTML = `
                <input type="text" class="form-control ga-secondary-diagnosis-field" placeholder="e.g., Hypertension, Asthma">
                <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)">
                    <i class="bi bi-dash-circle"></i>
                </button>
            `;
            container.appendChild(inputGroup);
            updateRemoveButtons('ga-secondary-diagnosis-field');
        }

        function removeGAField(button) {
            const inputGroup = button.parentElement;
            const input = inputGroup.querySelector('input');
            const fieldClass = input.className.match(/ga-\w+-field/)[0];
            inputGroup.remove();
            updateRemoveButtons(fieldClass);
        }

        function updateRemoveButtons(fieldClass) {
            const fields = document.querySelectorAll(`.${fieldClass}`);
            const buttons = Array.from(fields).map(field => field.parentElement.querySelector('.btn-outline-danger'));
            buttons.forEach((btn, index) => {
                btn.style.display = fields.length > 1 ? 'block' : 'none';
            });
        }

        function collectFieldValues(className) {
            const inputs = document.querySelectorAll(`.${className}`);
            const values = Array.from(inputs)
                .map(input => input.value.trim())
                .filter(value => value.length > 0);
            return values.length > 0 ? values.join(', ') : '';
        }

        function switchSearchMode(mode) {
            const myRecordsBtn = document.getElementById('myRecordsBtn');
            const analyticsBtn = document.getElementById('analyticsBtn');
            const searchModeInput = document.getElementById('searchMode');
            
            if (mode === 'my-records') {
                myRecordsBtn.classList.add('active');
                myRecordsBtn.classList.remove('btn-outline-primary');
                myRecordsBtn.classList.add('btn-primary');
                analyticsBtn.classList.remove('active');
                analyticsBtn.classList.remove('btn-primary');
                analyticsBtn.classList.add('btn-outline-primary');
                searchModeInput.value = 'my-records';
            } else {
                analyticsBtn.classList.add('active');
                analyticsBtn.classList.remove('btn-outline-primary');
                analyticsBtn.classList.add('btn-primary');
                myRecordsBtn.classList.remove('active');
                myRecordsBtn.classList.remove('btn-primary');
                myRecordsBtn.classList.add('btn-outline-primary');
                searchModeInput.value = 'analytics';
            }
            
            // Clear previous results when switching modes
            const resultsDiv = document.getElementById('gaResults');
            if (resultsDiv.style.display === 'block') {
                resultsDiv.style.display = 'none';
            }
        }

        function renderAnalyticsDisplay(data) {
