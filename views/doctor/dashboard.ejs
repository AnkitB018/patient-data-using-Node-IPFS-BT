            if (insights && insights.length > 0) {
                html += `
                    <div class="card mb-4" style="background: linear-gradient(145deg, rgba(30,41,59,0.95) 0%, rgba(15,23,42,0.95) 100%); border: 2px solid #00d2ff; border-radius: 16px; padding: 30px; box-shadow: 0 8px 32px rgba(0, 210, 255, 0.15);">
