<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - MediChain</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            color: #fff;
        }
        
        .top-navbar {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        .logo {
            font-size: 1.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, #00d2ff, #3a7bd5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .user-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        
        .btn-logout {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            padding: 10px 25px;
            border-radius: 25px;
            text-decoration: none;
            transition: all 0.3s;
            font-weight: 600;
        }
        
        .btn-logout:hover {
            background: rgba(255,255,255,0.2);
            color: white;
            transform: translateY(-2px);
        }
        
        .tabs-container {
            max-width: 1400px;
            margin: 30px auto;
            padding: 0 40px;
        }
        
        .tabs-nav {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }
        
        .tab-btn {
            background: rgba(30,41,59,0.6);
            border: 1px solid rgba(255,255,255,0.15);
            color: rgba(255,255,255,0.7);
            padding: 15px 30px;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
            font-size: 1rem;
        }
        
        .tab-btn:hover {
            background: rgba(30,41,59,0.8);
            color: white;
            transform: translateY(-2px);
        }
        
        .tab-btn.active {
            background: linear-gradient(135deg, #00d2ff, #3a7bd5);
            color: white;
            border-color: transparent;
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
            animation: fadeIn 0.3s;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .content-card {
            background: rgba(30,41,59,0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 20px;
            padding: 40px;
        }
        
        .form-label {
            font-weight: 600;
            color: rgba(255,255,255,0.9);
            margin-bottom: 8px;
        }
        
        .form-control, .form-select {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            padding: 12px 15px;
            border-radius: 10px;
        }
        
        .form-control:focus, .form-select:focus {
            background: rgba(255,255,255,0.15);
            border-color: #00d2ff;
            color: white;
            box-shadow: 0 0 0 3px rgba(0,210,255,0.1);
        }
        
        .form-control::placeholder {
            color: rgba(255,255,255,0.5);
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #00d2ff, #3a7bd5);
            border: none;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,210,255,0.3);
        }
        
        .file-upload-area {
            border: 3px dashed #0d9488;
            border-radius: 20px;
            padding: 50px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            margin-bottom: 30px;
            background: rgba(14,165,164,0.05);
        }
        
        .file-upload-area:hover {
            background: rgba(14,165,164,0.1);
            border-color: #00d2ff;
        }
        
        .upload-icon {
            font-size: 4rem;
            color: #00d2ff;
            margin-bottom: 20px;
        }
        
        .file-preview {
            display: none;
            background: rgba(0,210,255,0.1);
            border: 1px solid #00d2ff;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 30px;
        }
        
        .file-preview.show {
            display: block;
        }
        
        .record-card {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            transition: all 0.3s;
        }
        
        .record-card:hover {
            background: rgba(255,255,255,0.08);
            transform: translateY(-3px);
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: rgba(255,255,255,0.5);
        }
        
        .empty-state i {
            font-size: 4rem;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    
    <!-- Top Navigation Bar -->
    <div class="top-navbar">
        <div class="logo">
            <i class="bi bi-heart-pulse-fill me-2"></i>MediChain Doctor
        </div>
        <div class="user-info">
            <span><i class="bi bi-person-badge me-2"></i>Dr. <%= user.username %></span>
            <span style="opacity: 0.6;"><%= patients.length %> Patients</span>
            <a href="/logout" class="btn-logout">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
            </a>
        </div>
    </div>
    
    <!-- Tabs Container -->
    <div class="tabs-container">
        <!-- Tabs Navigation -->
        <div class="tabs-nav">
            <button class="tab-btn active" onclick="switchTab('upload')">
                <i class="bi bi-cloud-upload me-2"></i>Upload Record
            </button>
            <button class="tab-btn" onclick="switchTab('view')">
                <i class="bi bi-file-medical me-2"></i>View Records
            </button>
            <button class="tab-btn" onclick="switchTab('patients')">
                <i class="bi bi-people me-2"></i>My Patients
            </button>
            <button class="tab-btn" onclick="switchTab('allocate')">
                <i class="bi bi-person-plus me-2"></i>Allocate Patient
            </button>
            <button class="tab-btn" onclick="switchTab('update')">
                <i class="bi bi-pencil-square me-2"></i>Update Patient Info
            </button>
            <button class="tab-btn" onclick="switchTab('consented')">
                <i class="bi bi-eye-fill me-2"></i>View Granted Records
            </button>
        </div>
        
        <!-- Tab: Upload Record -->
        <div id="upload-tab" class="tab-content active">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-cloud-upload me-2"></i>Upload Medical Record</h3>
                
                <% if (success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i><%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                
                <% if (error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                
                <% if (patients.length === 0) { %>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        You don't have any patients assigned yet. Please contact the administrator.
                    </div>
                <% } else { %>
                
                <form action="/doctor/upload" method="POST" onsubmit="return handleUpload(event)">
                    <!-- File Upload Area -->
                    <div class="file-upload-area" id="dropZone" onclick="document.getElementById('fileInput').click()">
                        <i class="bi bi-cloud-arrow-up upload-icon"></i>
                        <h4>Drag & Drop File Here</h4>
                        <p style="color: rgba(255,255,255,0.6);">or click to browse</p>
                        <input type="file" id="fileInput" hidden accept="image/*,.pdf,.doc,.docx">
                    </div>
                    
                    <div class="file-preview" id="filePreview">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-file-earmark-check text-success me-3" style="font-size: 2rem;"></i>
                            <div class="flex-grow-1">
                                <div id="fileName" style="font-weight: 600;"></div>
                                <small id="fileSize" style="color: rgba(255,255,255,0.6);"></small>
                            </div>
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeFile()">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    
                    <input type="hidden" id="file_base64" name="file_base64">
                    <input type="hidden" id="filename" name="filename">
                    
                    <!-- Patient Selection -->
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label">Select Patient *</label>
                            <select class="form-select" name="patient_id" required>
                                <option value="">Choose a patient</option>
                                <% patients.forEach(patient => { %>
                                    <option value="<%= patient.patient_id %>">
                                        <%= patient.patient_id %> - <%= patient.username %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="form-label">File Type *</label>
                            <select class="form-select" name="file_type" required>
                                <option value="">Select Type</option>
                                <option value="Blood Test">Blood Test</option>
                                <option value="X-Ray">X-Ray</option>
                                <option value="MRI Scan">MRI Scan</option>
                                <option value="CT Scan">CT Scan</option>
                                <option value="Prescription">Prescription</option>
                                <option value="Lab Report">Lab Report</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label">Primary Diagnosis *</label>
                            <input type="text" class="form-control" name="disease" placeholder="e.g., Hypertension" required>
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="form-label">Doctor Name</label>
                            <input type="text" class="form-control" name="doctor" value="Dr. <%= user.username %>" readonly>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" name="description" rows="3" placeholder="Additional notes..."></textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label">Status</label>
                            <select class="form-select" name="file_status">
                                <option value="Open">Open</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="form-label">Next Appointment</label>
                            <input type="date" class="form-control" name="next_appointment">
                        </div>
                    </div>
                    
                    <hr style="border-color: rgba(255,255,255,0.2); margin: 30px 0;">
                    <h5 class="mb-3"><i class="bi bi-clipboard2-pulse me-2"></i>Clinical Details (For GA Recommendations)</h5>
                    
                    <!-- Symptoms -->
                    <div class="form-group">
                        <label class="form-label">Symptoms</label>
                        <div id="symptomsContainer">
                            <div class="input-group mb-2">
                                <input type="text" class="form-control" name="symptoms[]" placeholder="e.g., Fever, Cough">
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-light" onclick="addField('symptomsContainer', 'symptoms')">
                            <i class="bi bi-plus-circle me-1"></i>Add Symptom
                        </button>
                    </div>
                    
                    <!-- Secondary Diagnoses -->
                    <div class="form-group">
                        <label class="form-label">Secondary Diagnoses</label>
                        <div id="diagnosesContainer">
                            <div class="input-group mb-2">
                                <input type="text" class="form-control" name="secondary_diagnosis[]" placeholder="e.g., Diabetes Type 2">
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-light" onclick="addField('diagnosesContainer', 'secondary_diagnosis')">
                            <i class="bi bi-plus-circle me-1"></i>Add Diagnosis
                        </button>
                    </div>
                    
                    <!-- Affected Body Parts -->
                    <div class="form-group">
                        <label class="form-label">Affected Body Parts</label>
                        <input type="text" class="form-control" name="affected_body_parts" placeholder="e.g., Chest, Lungs (comma-separated)">
                    </div>
                    
                    <!-- Treatments -->
                    <div class="form-group">
                        <label class="form-label">Treatments</label>
                        <div id="treatmentsContainer">
                            <div class="input-group mb-2">
                                <input type="text" class="form-control" name="treatments[]" placeholder="e.g., Physical Therapy">
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-light" onclick="addField('treatmentsContainer', 'treatments')">
                            <i class="bi bi-plus-circle me-1"></i>Add Treatment
                        </button>
                    </div>
                    
                    <!-- Medications -->
                    <div class="form-group">
                        <label class="form-label">Medications</label>
                        <div id="medicationsContainer">
                            <div class="input-group mb-2">
                                <input type="text" class="form-control" name="medications[]" placeholder="e.g., Paracetamol 500mg">
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-light" onclick="addField('medicationsContainer', 'medications')">
                            <i class="bi bi-plus-circle me-1"></i>Add Medication
                        </button>
                    </div>
                    
                    <!-- Follow-up Info -->
                    <div class="form-group">
                        <label class="form-label">Follow-up Required?</label>
                        <select class="form-select" name="followup_required" onchange="toggleFollowup(this.value)">
                            <option value="No">No</option>
                            <option value="Yes">Yes</option>
                        </select>
                    </div>
                    
                    <div id="followupDetails" style="display: none;">
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label">Follow-up Date</label>
                                <input type="date" class="form-control" name="followup_date">
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label">Follow-up Notes</label>
                                <textarea class="form-control" name="followup_notes" rows="2" placeholder="Follow-up instructions..."></textarea>
                            </div>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
                        <i class="bi bi-send me-2"></i>Upload to IPFS & Blockchain
                    </button>
                </form>
                
                <% } %>
            </div>
        </div>
        
        <!-- Tab: View Records -->
        <div id="view-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-file-medical me-2"></i>Patient Medical Records</h3>
                
                <% if (patients.length === 0) { %>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        You don't have any patients assigned yet.
                    </div>
                <% } else { %>
                
                <div class="form-group mb-4">
                    <label class="form-label">Select Patient</label>
                    <select class="form-select" id="viewPatientSelect" onchange="loadPatientRecords()">
                        <option value="">Choose a patient...</option>
                        <% patients.forEach(patient => { %>
                            <option value="<%= patient.patient_id %>">
                                <%= patient.patient_id %> - <%= patient.username %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                
                <div id="patientRecordsList">
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <h5>Select a patient to view records</h5>
                    </div>
                </div>
                
                <% } %>
            </div>
        </div>
        
        <!-- Tab: My Patients -->
        <div id="patients-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-people me-2"></i>My Assigned Patients</h3>
                
                <% if (patients.length === 0) { %>
                    <div class="empty-state">
                        <i class="bi bi-people"></i>
                        <h5>No patients assigned yet</h5>
                        <p>Go to the "Allocate Patient" tab to add patients to your list.</p>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table" style="color: white;">
                            <thead>
                                <tr>
                                    <th>Patient ID</th>
                                    <th>Name</th>
                                    <th>Gender</th>
                                    <th>Blood Group</th>
                                    <th>Contact</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% patients.forEach(patient => { %>
                                    <tr>
                                        <td><%= patient.patient_id %></td>
                                        <td><%= patient.username %></td>
                                        <td><%= patient.gender || 'N/A' %></td>
                                        <td><%= patient.blood_group || 'N/A' %></td>
                                        <td><%= patient.contact || 'N/A' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
        
        <!-- Tab: Update Patient Info -->
        <div id="update-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-pencil-square me-2"></i>Update Patient Medical Information</h3>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Select Patient</label>
                            <select class="form-select" id="updatePatientSelect" onchange="loadPatientInfo()">
                                <option value="">Choose a patient...</option>
                                <% patients.forEach(patient => { %>
                                    <option value="<%= patient.patient_id %>">
                                        <%= patient.patient_id %> - <%= patient.username %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </div>
                
                <div id="patientInfoForm" style="display: none;">
                    <hr style="border-color: rgba(255,255,255,0.2); margin: 30px 0;">
                    <h5 class="mb-3">Medical Information (Editable)</h5>
                    <form id="updateMedicalForm">
                        <input type="hidden" id="update_patient_id" name="patient_id">
                        
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label">Blood Group</label>
                                <select class="form-select" name="blood_group" id="update_blood_group">
                                    <option value="">Not Specified</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                </select>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label">Date of Birth</label>
                                <input type="date" class="form-control" name="date_of_birth" id="update_dob">
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label">Height (cm)</label>
                                <input type="number" class="form-control" name="height" id="update_height" placeholder="e.g., 175">
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label">Weight (kg)</label>
                                <input type="number" class="form-control" name="weight" id="update_weight" placeholder="e.g., 70">
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">Current Conditions</label>
                            <textarea class="form-control" name="current_conditions" id="update_conditions" rows="3" placeholder="e.g., Diabetes, Hypertension"></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 mt-3">
                            <i class="bi bi-save me-2"></i>Update Medical Information
                        </button>
                    </form>
                    
                    <hr style="border-color: rgba(255,255,255,0.2); margin: 30px 0;">
                    <h5 class="mb-3">Personal Information (Read-Only)</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong>Name:</strong> <span id="display_name" style="color: rgba(255,255,255,0.7);">-</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Gender:</strong> <span id="display_gender" style="color: rgba(255,255,255,0.7);">-</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Contact:</strong> <span id="display_contact" style="color: rgba(255,255,255,0.7);">-</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Email:</strong> <span id="display_email" style="color: rgba(255,255,255,0.7);">-</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Tab: Allocate Patient -->
        <div id="allocate-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-person-plus me-2"></i>Allocate Patient to Myself</h3>
                
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="mb-3">Add New Patient</h5>
                        <form id="allocateForm">
                            <div class="form-group mb-3">
                                <label class="form-label">Select Patient</label>
                                <select class="form-select" id="patientSelectAlloc" required>
                                    <option value="">Choose a patient...</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-plus-circle me-2"></i>Allocate Patient
                            </button>
                        </form>
                    </div>
                    
                    <div class="col-md-6">
                        <h5 class="mb-3">My Current Allocations</h5>
                        <div id="myAllocationsTable" style="max-height: 400px; overflow-y: auto;">
                            <div class="text-center py-4">
                                <div class="spinner-border text-primary"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Tab: View Granted Records -->
    <div id="consented-tab" class="tab-content">
        <div class="content-card">
            <h3 class="mb-4"><i class="bi bi-eye-fill me-2"></i>Records Shared With You</h3>
            
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Select Patient:</label>
                    <select class="form-select" id="consentedPatientSelectDoctor" onchange="loadConsentedRecordsDoctor()">
                        <option value="">Choose patient...</option>
                    </select>
                </div>
            </div>
            
            <div id="consentedRecordsListDoctor">
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h5>Select a patient to view their shared records</h5>
                </div>
            </div>
        </div>
    </div>
    
    <!-- File Preview Modal -->
    <div class="modal fade" id="filePreviewModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content" style="background: #1a1a2e; color: white;">
                <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-text me-2"></i>Medical Record Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="modalContent">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                        <p class="mt-3">Loading record...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tab Switching
        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            
            event.target.classList.add('active');
            document.getElementById(tabName + '-tab').classList.add('active');
            
            if (tabName === 'consented') {
                loadPatientsGrantedToDoctor();
            }
        }
        
        // File Upload Handling
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        
        if (dropZone && fileInput) {
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.style.borderColor = '#00d2ff';
            });
            
            dropZone.addEventListener('dragleave', () => {
                dropZone.style.borderColor = '#0d9488';
            });
            
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.style.borderColor = '#0d9488';
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    handleFileSelect(files[0]);
                }
            });
            
            fileInput.addEventListener('change', (e) => {
                if (e.target.files.length > 0) {
                    handleFileSelect(e.target.files[0]);
                }
            });
        }
        
        function handleFileSelect(file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const base64 = e.target.result;
                document.getElementById('file_base64').value = base64;
                document.getElementById('filename').value = file.name;
                document.getElementById('fileName').textContent = file.name;
                document.getElementById('fileSize').textContent = (file.size / 1024).toFixed(2) + ' KB';
                document.getElementById('filePreview').classList.add('show');
            };
            reader.readAsDataURL(file);
        }
        
        function removeFile() {
            fileInput.value = '';
            document.getElementById('file_base64').value = '';
            document.getElementById('filename').value = '';
            document.getElementById('filePreview').classList.remove('show');
        }
        
        function handleUpload(e) {
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Uploading...';
            return true;
        }
        
        // Add dynamic field
        function addField(containerId, fieldName) {
            const container = document.getElementById(containerId);
            const newField = document.createElement('div');
            newField.className = 'input-group mb-2';
            newField.innerHTML = `
                <input type="text" class="form-control" name="${fieldName}[]" placeholder="Enter ${fieldName.replace('_', ' ')}">
                <button type="button" class="btn btn-danger" onclick="this.parentElement.remove()">
                    <i class="bi bi-trash"></i>
                </button>
            `;
            container.appendChild(newField);
        }
        
        // Toggle follow-up details
        function toggleFollowup(value) {
            const details = document.getElementById('followupDetails');
            details.style.display = value === 'Yes' ? 'block' : 'none';
        }
        
        // Load patient information for update
        async function loadPatientInfo() {
            const patientId = document.getElementById('updatePatientSelect').value;
            const formContainer = document.getElementById('patientInfoForm');
            
            if (!patientId) {
                formContainer.style.display = 'none';
                return;
            }
            
            try {
                const response = await fetch(`/doctor/api/patient-info/${patientId}`);
                const data = await response.json();
                
                if (data.success && data.patient) {
                    const p = data.patient;
                    
                    // Populate editable fields
                    document.getElementById('update_patient_id').value = p.patient_id;
                    document.getElementById('update_blood_group').value = p.blood_group || '';
                    document.getElementById('update_dob').value = p.date_of_birth || '';
                    document.getElementById('update_height').value = p.height || '';
                    document.getElementById('update_weight').value = p.weight || '';
                    document.getElementById('update_conditions').value = p.current_conditions || '';
                    
                    // Display read-only fields
                    document.getElementById('display_name').textContent = p.username || 'N/A';
                    document.getElementById('display_gender').textContent = p.gender || 'N/A';
                    document.getElementById('display_contact').textContent = p.contact || 'N/A';
                    document.getElementById('display_email').textContent = p.email || 'N/A';
                    
                    formContainer.style.display = 'block';
                } else {
                    alert('Failed to load patient information');
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }
        
        // Update medical information form submit
        document.getElementById('updateMedicalForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);
            
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Updating...';
            
            try {
                const response = await fetch('/doctor/update-patient-info', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('✅ Medical information updated successfully!');
                } else {
                    alert('❌ ' + result.error);
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-save me-2"></i>Update Medical Information';
            }
        });
        
        // Load Patient Records
        async function loadPatientRecords() {
            const patientId = document.getElementById('viewPatientSelect').value;
            const container = document.getElementById('patientRecordsList');
            
            if (!patientId) {
                container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>Select a patient</h5></div>';
                return;
            }
            
            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch(`/doctor/api/patient-records/${patientId}`);
                const data = await response.json();
                
                if (data.success && data.blocks.length > 0) {
                    let html = '';
                    data.blocks.forEach(block => {
                        const hasCid = block.ipfs_cid && block.ipfs_cid !== 'N/A';
                        html += `
                            <div class="record-card">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h5 style="color: #00d2ff;">${block.file_type || 'Medical Record'}</h5>
                                        <p class="mb-1"><strong>Date:</strong> ${new Date(parseInt(block.timestamp)).toLocaleString()}</p>
                                        <p class="mb-1"><strong>Status:</strong> <span class="badge ${block.file_status === 'Closed' ? 'bg-secondary' : 'bg-success'}">${block.file_status || 'Open'}</span></p>
                                    </div>
                                    ${hasCid ? `<button class="btn btn-primary" onclick="viewRecord('${block.ipfs_cid}')">
                                        <i class="bi bi-eye me-2"></i>View Details
                                    </button>` : '<span class="badge bg-secondary">No Data</span>'}
                                </div>
                            </div>
                        `;
                    });
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>No records found</h5></div>';
                }
            } catch (error) {
                container.innerHTML = '<div class="alert alert-danger">Error: ' + error.message + '</div>';
            }
        }
        
        // View Record Details
        async function viewRecord(cid) {
            const modal = new bootstrap.Modal(document.getElementById('filePreviewModal'));
            const modalContent = document.getElementById('modalContent');
            
            modalContent.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3">Fetching from IPFS...</p></div>';
            modal.show();
            
            try {
                const response = await fetch(`/doctor/api/fetch-ipfs/${cid}`);
                const result = await response.json();
                
                if (result.success) {
                    const data = result.data;
                    let html = `
                        <div class="row">
                            <div class="col-md-6 mb-3"><strong>Patient ID:</strong> ${data['Patient ID'] || 'N/A'}</div>
                            <div class="col-md-6 mb-3"><strong>Patient Name:</strong> ${data['Patient Name'] || 'N/A'}</div>
                            <div class="col-md-6 mb-3"><strong>File Type:</strong> ${data['File Type'] || 'N/A'}</div>
                            <div class="col-md-6 mb-3"><strong>Disease:</strong> ${data['Disease'] || 'N/A'}</div>
                            <div class="col-md-6 mb-3"><strong>Doctor:</strong> ${data['doctor'] || 'N/A'}</div>
                            <div class="col-md-6 mb-3"><strong>Uploaded By:</strong> ${data['Uploaded By'] || 'N/A'}</div>
                            <div class="col-md-6 mb-3"><strong>Status:</strong> ${data['File Status'] || 'Open'}</div>
                            <div class="col-md-6 mb-3"><strong>Date:</strong> ${data['Timestamp'] || 'N/A'}</div>
                        </div>
                        <hr style="border-color: rgba(255,255,255,0.2);">
                        <div class="mb-3"><strong>Description:</strong><p>${data['Description'] || 'No description'}</p></div>
                        <div class="mb-3"><strong>IPFS CID:</strong><code style="background: rgba(255,255,255,0.1); padding: 5px 10px; border-radius: 5px;">${cid}</code></div>
                    `;
                    
                    if (data.file_data) {
                        html += `<div class="mt-4"><strong>Attached File:</strong><br>
                            <img src="${data.file_data}" alt="Medical File" style="max-width: 100%; border-radius: 10px; margin-top: 10px;">
                        </div>`;
                    }
                    
                    modalContent.innerHTML = html;
                } else {
                    modalContent.innerHTML = '<div class="alert alert-danger">Error fetching record: ' + result.error + '</div>';
                }
            } catch (error) {
                modalContent.innerHTML = '<div class="alert alert-danger">Error: ' + error.message + '</div>';
            }
        }
        
        // Load allocation data when tab is opened
        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            
            event.target.classList.add('active');
            document.getElementById(tabName + '-tab').classList.add('active');
            
            if (tabName === 'allocate') {
                loadAllocationData();
            }
        }
        
        // Load all patients and current allocations
        async function loadAllocationData() {
            // Load all patients for dropdown
            try {
                const response = await fetch('/doctor/api/all-patients');
                const data = await response.json();
                
                const select = document.getElementById('patientSelectAlloc');
                select.innerHTML = '<option value="">Choose a patient...</option>';
                
                if (data.success && data.patients) {
                    data.patients.forEach(patient => {
                        select.innerHTML += `<option value="${patient.patient_id}">${patient.patient_id} - ${patient.username}</option>`;
                    });
                }
            } catch (error) {
                console.error('Error loading patients:', error);
            }
            
            // Load current allocations
            loadMyAllocations();
        }
        
        // Load doctor's current patient allocations
        async function loadMyAllocations() {
            const container = document.getElementById('myAllocationsTable');
            container.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch('/doctor/api/my-allocations');
                const data = await response.json();
                
                if (data.success && data.relations.length > 0) {
                    let html = '<table class="table table-sm" style="color: white;"><thead><tr><th>Patient ID</th><th>Name</th><th>Action</th></tr></thead><tbody>';
                    data.relations.forEach(rel => {
                        html += `
                            <tr>
                                <td>${rel.pat_id}</td>
                                <td>${rel.patient_name}</td>
                                <td><button class="btn btn-sm btn-danger" onclick="removeAllocation('${rel.pat_id}')"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        `;
                    });
                    html += '</tbody></table>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<p class="text-center" style="color: rgba(255,255,255,0.5);">No allocations yet</p>';
                }
            } catch (error) {
                container.innerHTML = '<div class="alert alert-danger">Error loading allocations</div>';
            }
        }
        
        // Allocate patient to self
        document.getElementById('allocateForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const patientId = document.getElementById('patientSelectAlloc').value;
            if (!patientId) return;
            
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Allocating...';
            
            try {
                const response = await fetch('/doctor/allocate-patient', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ patient_id: patientId })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('✅ Patient allocated successfully!');
                    document.getElementById('patientSelectAlloc').value = '';
                    loadMyAllocations();
                    // Reload page to update patient lists
                    setTimeout(() => location.reload(), 1000);
                } else {
                    alert('❌ ' + result.error);
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-plus-circle me-2"></i>Allocate Patient';
            }
        });
        
        // Remove patient allocation
        async function removeAllocation(patientId) {
            if (!confirm('Remove this patient from your list?')) return;
            
            try {
                const response = await fetch('/doctor/remove-patient', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ patient_id: patientId })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('✅ Patient removed successfully!');
                    loadMyAllocations();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    alert('❌ ' + result.error);
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            }
        }
        
        // ===========================================
        // CONSENT MANAGEMENT FOR DOCTOR
        // ===========================================
        
        // Load patients who granted consent to this doctor
        async function loadPatientsGrantedToDoctor() {
            const select = document.getElementById('consentedPatientSelectDoctor');
            select.innerHTML = '<option value="">Loading...</option>';
            
            try {
                const response = await fetch('/doctor/api/patients-granted-to-me');
                const data = await response.json();
                
                if (data.success) {
                    select.innerHTML = '<option value="">Choose patient...</option>';
                    data.patients.forEach(patient => {
                        select.innerHTML += `<option value="${patient.patient_id}">${patient.patient_id} - ${patient.username}</option>`;
                    });
                }
            } catch (error) {
                select.innerHTML = '<option value="">Error loading</option>';
            }
        }
        
        // Load consented records for doctor
        async function loadConsentedRecordsDoctor() {
            const patientId = document.getElementById('consentedPatientSelectDoctor').value;
            const container = document.getElementById('consentedRecordsListDoctor');
            
            if (!patientId) {
                container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>Select a patient</h5></div>';
                return;
            }
            
            container.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch(`/doctor/api/consented-blocks/${patientId}`);
                const data = await response.json();
                
                if (data.success && data.blocks.length > 0) {
                    let html = '';
                    data.blocks.forEach(block => {
                        const hasCid = block.ipfs_cid && block.ipfs_cid !== 'N/A';
                        html += `
                            <div class="record-card">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h5 style="color: #00d2ff;">${block.file_type || 'Medical Record'}</h5>
                                        <p class="mb-1"><strong>Date:</strong> ${new Date(parseInt(block.timestamp)).toLocaleString()}</p>
                                        <p class="mb-1"><strong>Status:</strong> <span class="badge ${block.file_status === 'Closed' ? 'bg-secondary' : 'bg-success'}">${block.file_status || 'Open'}</span></p>
                                        <span class="badge bg-info">Block #${block.block_index}</span>
                                    </div>
                                    ${hasCid ? `<button class="btn btn-primary" onclick="viewRecord('${block.ipfs_cid}')">
                                        <i class="bi bi-eye me-2"></i>View Details
                                    </button>` : '<span class="badge bg-secondary">No Data</span>'}
                                </div>
                            </div>
                        `;
                    });
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>No records shared</h5></div>';
                }
            } catch (error) {
                container.innerHTML = '<div class="alert alert-danger">Error loading records</div>';
            }
        }
    </script>
</body>
</html>
