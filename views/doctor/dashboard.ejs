            const resultCount = document.getElementById('gaResultCount');
            const { summary, insights, meta } = data;
            
            resultCount.textContent = `Database Analytics - ${meta.totalRecordsAnalyzed} Best Matches`;
            
            let html = `
                <div class="alert mb-4" style="background: linear-gradient(135deg, rgba(0, 210, 255, 0.2) 0%, rgba(0, 255, 127, 0.2) 100%); border: none; border-left: 5px solid #00d2ff; border-radius: 12px; padding: 20px; box-shadow: 0 4px 15px rgba(0, 210, 255, 0.2);">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-database-check me-3" style="font-size: 2rem; color: #00ff7f;"></i>
                        <div>
                            <h5 class="mb-1" style="color: #00ff7f; font-weight: 600;">Database-Wide Pattern Analysis Complete</h5>
                            <p class="mb-0" style="color: #e5e7eb; font-size: 0.95rem;">
                                Successfully analyzed <strong style="color: #00d2ff;">${meta.totalRecordsAnalyzed} best-matching records</strong> from the entire medical database using advanced genetic algorithms.
                            </p>
                        </div>
                    </div>
