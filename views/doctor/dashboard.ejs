                            </div>
                            <div>
                                <h5 class="mb-0" style="color: #00d2ff; font-weight: 600;">Clinical Intelligence Summary</h5>
                                <small style="color: #9ca3af;">AI-powered pattern recognition and insights</small>
                            </div>
                        </div>
                        <div class="insights-list">
                `;
                
                insights.forEach((insight, idx) => {
                    const colors = ['#00d2ff', '#00ff7f', '#ffd700', '#a78bfa'];
                    const bgColors = ['rgba(0, 210, 255, 0.12)', 'rgba(0, 255, 127, 0.12)', 'rgba(255, 215, 0, 0.12)', 'rgba(167, 139, 250, 0.12)'];
