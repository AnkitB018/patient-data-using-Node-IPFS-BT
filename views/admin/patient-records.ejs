<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Medical Records</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        body {
            background: linear-gradient(135deg, #e0f7fa 0%, #80deea 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .records-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .btn-back {
            background: #6c757d;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 8px 20px;
            text-decoration: none;
        }
    </style>
</head>
<body>
    
    <div class="container">
        <div class="records-card">
            <div class="mb-4">
                <a href="/admin/dashboard" class="btn-back">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
            </div>
            
            <h1 class="mb-4">
                <i class="bi bi-file-earmark-medical-fill"></i> <%= title %>
            </h1>
            
            <div class="alert alert-info">
                <i class="bi bi-person-circle"></i> Patient ID: <strong><%= patientId %></strong> | 
                Records Found: <strong><%= blocks.length %></strong>
            </div>
            
            <% if (blocks.length === 0) { %>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i> No records found for this patient
                </div>
            <% } else { %>
                <% blocks.forEach(block => { %>
                    <div class="card mb-3">
                        <div class="card-header bg-primary text-white">
                            <strong>Block #<%= block.index %></strong> - <%= block.timestamp %>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>File Type:</strong> <%= block.data['File Type'] %></p>
                                    <p><strong>Disease:</strong> <%= block.data['Disease'] %></p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Status:</strong> 
                                        <span class="badge <%= block.data['File Status'] === 'Open' ? 'bg-success' : 'bg-secondary' %>">
                                            <%= block.data['File Status'] %>
                                        </span>
                                    </p>
                                    <p><strong>Uploaded By:</strong> <%= block.data['Uploaded By'] %></p>
                                </div>
                            </div>
                            <p><strong>IPFS CID:</strong> <code><%= block.data.cid %></code></p>
                            <button class="btn btn-sm btn-primary" onclick="fetchIPFS('<%= block.data.cid %>')">
                                <i class="bi bi-cloud-download"></i> Fetch from IPFS
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
    
    <!-- IPFS Modal -->
    <div class="modal fade" id="ipfsModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">IPFS Content</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="ipfsContent">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        function fetchIPFS(cid) {
            const modal = new bootstrap.Modal(document.getElementById('ipfsModal'));
            modal.show();
            
            $.get('/admin/api/fetch-ipfs/' + cid, function(response) {
                if (response.success) {
                    let html = '<pre style="max-height: 500px; overflow-y: auto;">';
                    html += JSON.stringify(response.data, null, 2);
                    html += '</pre>';
                    $('#ipfsContent').html(html);
                } else {
                    $('#ipfsContent').html('<div class="alert alert-danger">Error: ' + response.error + '</div>');
                }
            }).fail(function() {
                $('#ipfsContent').html('<div class="alert alert-danger">Failed to fetch from IPFS</div>');
            });
        }
    </script>
</body>
</html>
