<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Medical Records</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        body {
            background: linear-gradient(135deg, #e0f7fa 0%, #80deea 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .blockchain-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .block-card {
            background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
            border-left: 5px solid #0d9488;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 3px 8px rgba(0,0,0,0.1);
        }
        
        .block-header {
            font-size: 1.2rem;
            font-weight: 700;
            color: #0d9488;
            margin-bottom: 10px;
        }
        
        .block-data {
            background: white;
            padding: 15px;
            border-radius: 8px;
            font-family: 'Courier New', monospace;
            font-size: 0.9rem;
            max-height: 300px;
            overflow-y: auto;
        }
        
        .btn-back {
            background: #6c757d;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 8px 20px;
            text-decoration: none;
        }
    </style>
</head>
<body>
    
    <div class="container">
        <div class="blockchain-card">
            <div class="mb-4">
                <a href="/admin/dashboard" class="btn-back">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
            </div>
            
            <h1 class="mb-4">
                <i class="bi bi-collection-fill"></i> Blockchain Explorer
            </h1>
            
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Showing last 10 blocks | Total Blocks: <%= totalBlocks %>
            </div>
            
            <% if (blocks.length === 0) { %>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i> No blocks in the blockchain yet
                </div>
            <% } else { %>
                <% blocks.forEach(block => { %>
                    <div class="block-card">
                        <div class="block-header">
                            🧱 Block #<%= block.index %>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">Timestamp:</small> <strong><%= block.timestamp %></strong>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">Hash:</small><br>
                            <code class="small"><%= block.hash %></code>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">Previous Hash:</small><br>
                            <code class="small"><%= block.previous_hash %></code>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted">Nonce:</small> <strong><%= block.nonce %></strong>
                        </div>
                        <div>
                            <small class="text-muted">Data:</small>
                            <div class="block-data">
                                <pre style="margin: 0;"><%= JSON.stringify(block.data, null, 2) %></pre>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
