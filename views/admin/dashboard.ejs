        // Search block by index
        window.searchBlockByIndex = async function() {
            const blockIndex = document.getElementById('blockSearchInput').value;
            const container = document.getElementById('blockchainList');
            
            if (!blockIndex || blockIndex < 0) {
                alert('Please enter a valid block index');
                return;
            }
            
            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3">Searching for block #' + blockIndex + '...</p></div>';
            
            try {
                const response = await fetch('/admin/api/blockchain');
                const data = await response.json();
                
                if (data.success) {
                    const block = data.chain.find(b => b.block_index == blockIndex);
                    
                    if (!block) {
                        container.innerHTML = `
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle me-2"></i>Block #${blockIndex} not found in the blockchain
                            </div>
                            <button class="btn btn-secondary" onclick="loadBlockchain(20)">
                                <i class="bi bi-arrow-left me-2"></i>Back to Blockchain Explorer
                            </button>
                        `;
                        return;
                    }
                    
                    // Display the found block
                    const foundBlockIndex = block.block_index;
                    const blockHash = block.block_hash;
                    const isGenesisBlock = foundBlockIndex === 0;
                    const cid = block.ipfs_cid || 'N/A';
                    const hasCid = cid !== 'N/A' && cid !== '';
                    const patientId = block.patient_id || (isGenesisBlock ? 'Genesis' : 'N/A');
                    const fileType = block.file_type || (isGenesisBlock ? 'System Initialization' : 'N/A');
                    const doctor = block.doc || (isGenesisBlock ? 'System' : 'N/A');
                    const status = block.file_status || 'Open';
                    
                    // Format timestamp
                    let formattedDate = block.timestamp;
                    if (block.timestamp && !isGenesisBlock) {
                        try {
                            const timestampNum = typeof block.timestamp === 'string' ? parseInt(block.timestamp, 10) : block.timestamp;
                            const date = new Date(timestampNum);
                            formattedDate = date.toLocaleString('en-US', {
                                year: 'numeric',
                                month: 'short',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit',
                                hour12: true
                            });
                        } catch (e) {
                            formattedDate = block.timestamp;
                        }
                    }
                    
                    const html = `
                        <div class="alert alert-success mb-3">
                            <i class="bi bi-check-circle me-2"></i>Block #${foundBlockIndex} found!
                        </div>
                        <button class="btn btn-secondary mb-3" onclick="loadBlockchain(20)">
                            <i class="bi bi-arrow-left me-2"></i>Back to Blockchain Explorer
                        </button>
                        <div class="block-card" style="border: 2px solid rgba(34, 197, 94, 0.5); border-radius: 15px; padding: 20px; background: rgba(15,52,96,0.3);">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <div class="block-index" style="font-size: 1.3rem; color: #22c55e; font-weight: bold;">Block #${foundBlockIndex}</div>
                                    <small style="color: rgba(255,255,255,0.7);"><i class="bi bi-clock me-1"></i>${formattedDate}</small>
                                </div>
                                ${hasCid ? `<button class="btn btn-primary" onclick="viewRecord('${cid}')" style="white-space: nowrap;">
                                    <i class="bi bi-eye me-1"></i>View Details
                                </button>` : '<span class="badge bg-secondary">Genesis Block</span>'}
                            </div>
                            
                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <strong style="color: #94a3b8;">Patient ID:</strong> <span style="color: #e4e4e7;">${patientId}</span>
                                </div>
                                <div class="col-md-4">
                                    <strong style="color: #94a3b8;">File Type:</strong> <span style="color: #e4e4e7;">${fileType}</span>
                                </div>
                                <div class="col-md-4">
                                    <strong style="color: #94a3b8;">Doctor:</strong> <span style="color: #e4e4e7;">${doctor}</span>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-4">
                                    <strong style="color: #94a3b8;">Status:</strong> 
                                    <span class="badge ${status.toLowerCase() === 'open' ? 'bg-success' : 'bg-secondary'}">${status}</span>
                                </div>
                                ${hasCid ? `<div class="col-md-6">
                                    <strong style="color: #94a3b8;">IPFS CID:</strong> <code style="color: #22c55e; font-size: 0.85rem;">${cid.substring(0, 20)}...</code>
                                </div>` : ''}
                            </div>
                            
                            <div class="mt-2" style="font-size: 0.75rem; color: rgba(255,255,255,0.5); word-break: break-all;">
                                <strong>Hash:</strong> ${blockHash}
                            </div>
                        </div>
                    `;
                    
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<div class="alert alert-danger">Failed to load blockchain</div>';
                }
            } catch (error) {
                container.innerHTML = '<div class="alert alert-danger">Error: ' + error.message + '</div>';
            }
        }
        
        // Load Patient Records
        window.loadPatientRecords = async function() {
            const patientId = document.getElementById('recordsPatientSelect').value;
            const container = document.getElementById('patientRecordsList');
            
            if (!patientId) {
                container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>Select a patient</h5></div>';
