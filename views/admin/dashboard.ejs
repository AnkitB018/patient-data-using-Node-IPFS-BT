<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - MediChain</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            color: #fff;
        }
        
        /* Top Navigation Bar */
        .top-navbar {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        .logo {
            font-size: 1.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, #00d2ff, #3a7bd5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .user-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        
        .user-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, #00d2ff, #3a7bd5);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.2rem;
        }
        
        .btn-logout {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            padding: 10px 25px;
            border-radius: 25px;
            text-decoration: none;
            transition: all 0.3s;
            font-weight: 600;
        }
        
        .btn-logout:hover {
            background: rgba(255,255,255,0.2);
            color: white;
            transform: translateY(-2px);
        }
        
        /* Status Bar */
        .status-bar {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            padding: 30px 40px;
            max-width: 1400px;
            margin: 0 auto;
        }
        
        .status-card {
            background: rgba(30,41,59,0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 20px;
            padding: 25px;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        
        .status-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
        }
        
        .status-card.health::before { background: #00d2ff; }
        .status-card.ipfs::before { background: #3a7bd5; }
        .status-card.blockchain::before { background: #a8edea; }
        .status-card.patients::before { background: #fed6e3; }
        
        .status-card:hover {
            background: rgba(255,255,255,0.08);
            transform: translateY(-5px);
        }
        
        .status-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 15px;
        }
        
        .status-card.health .status-icon { background: linear-gradient(135deg, #00d2ff, #3a7bd5); }
        .status-card.ipfs .status-icon { background: linear-gradient(135deg, #3a7bd5, #667eea); }
        .status-card.blockchain .status-icon { background: linear-gradient(135deg, #a8edea, #fed6e3); color: #333; }
        .status-card.patients .status-icon { background: linear-gradient(135deg, #fed6e3, #ffa8a8); color: #333; }
        
        .status-value {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 5px;
        }
        
        .status-label {
            color: rgba(255,255,255,0.6);
            font-size: 0.9rem;
        }
        
        .status-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: 10px;
        }
        
        .badge-success { background: rgba(0,255,127,0.2); color: #00ff7f; }
        .badge-error { background: rgba(255,0,0,0.2); color: #ff4444; }
        
        /* Tabs Section */
        .tabs-container {
            padding: 0 40px 40px 40px;
            max-width: 1400px;
            margin: 0 auto;
        }
        
        .tabs-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            border-bottom: 2px solid rgba(255,255,255,0.1);
            overflow-x: auto;
        }
        
        .tab-btn {
            background: none;
            border: none;
            color: rgba(255,255,255,0.6);
            padding: 15px 30px;
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
            border-bottom: 3px solid transparent;
            transition: all 0.3s;
            white-space: nowrap;
        }
        
        .tab-btn:hover {
            color: rgba(255,255,255,0.9);
        }
        
        .tab-btn.active {
            color: #00d2ff;
            border-bottom-color: #00d2ff;
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
            animation: fadeIn 0.5s;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Content Cards */
        .content-card {
            background: rgba(30,41,59,0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-label {
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
            color: rgba(255,255,255,0.9);
        }
        
        .form-control, .form-select {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 12px;
            padding: 12px 18px;
            color: white;
            transition: all 0.3s;
        }
        
        .form-control::placeholder {
            color: rgba(255,255,255,0.4);
        }
        
        .form-control:focus, .form-select:focus {
            background: rgba(255,255,255,0.15);
            border-color: #00d2ff;
            box-shadow: 0 0 0 3px rgba(0,210,255,0.1);
            color: white;
            outline: none;
        }
        
        .form-select option {
            background: #16213e;
            color: white;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #00d2ff, #3a7bd5);
            border: none;
            padding: 12px 30px;
            border-radius: 25px;
            color: white;
            font-weight: 700;
            transition: all 0.3s;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,210,255,0.3);
        }
        
        /* Blockchain Block Card */
        .block-card {
            background: rgba(30,41,59,0.5);
            border: 1px solid rgba(255,255,255,0.15);
            border-left: 4px solid #00d2ff;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 15px;
            transition: all 0.3s;
        }
        
        .block-card:hover {
            background: rgba(30,41,59,0.7);
            transform: translateX(5px);
            box-shadow: 0 4px 15px rgba(0,210,255,0.2);
        }
        
        .block-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        
        .block-index {
            font-size: 1.5rem;
            font-weight: 800;
            color: #00d2ff;
        }
        
        .block-hash {
            font-family: monospace;
            font-size: 0.85rem;
            color: rgba(255,255,255,0.5);
            word-break: break-all;
        }
        
        /* Record Card */
        .record-card {
            background: rgba(30,41,59,0.5);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            transition: all 0.3s;
        }
        
        .record-card:hover {
            background: rgba(30,41,59,0.7);
            transform: translateY(-3px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }
        
        .cid-badge {
            background: rgba(0,210,255,0.1);
            border: 1px solid rgba(0,210,255,0.3);
            padding: 8px 15px;
            border-radius: 20px;
            font-family: monospace;
            font-size: 0.85rem;
            color: #00d2ff;
            display: inline-block;
            margin: 10px 0;
        }
        
        .btn-fetch {
            background: linear-gradient(135deg, #3a7bd5, #00d2ff);
            border: none;
            padding: 8px 20px;
            border-radius: 20px;
            color: white;
            font-weight: 600;
            transition: all 0.3s;
            font-size: 0.9rem;
        }
        
        .btn-fetch:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(0,210,255,0.455,0.05);
            transform: translateY(-3px);
        }
        
        /* Modal Styles */
        .modal-content {
            background: #1a1a2e;
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 20px;
            color: white;
        }
        
        .modal-header {
            border-bottom: 1px solid rgba(255,255,255,0.1);
            background: linear-gradient(135deg, #00d2ff, #3a7bd5);
            border-radius: 20px 20px 0 0;
        }
        
        .modal-body {
            max-height: 80vh;
            overflow-y: auto;
        }
        
        .btn-close {
            filter: brightness(0) invert(1);
        }
        
        .metadata-item {
            background: rgba(30,41,59,0.6);
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 10px;
            border-left: 3px solid #00d2ff;
        }
        
        .file-preview-img {
            max-width: 100%;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: rgba(255,255,255,0.5);
        }
        
        .empty-state i {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.3;
        }
        
        /* Drag and Drop Upload Area */
        .upload-area {
            border: 3px dashed rgba(0,210,255,0.4);
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            background: rgba(30,41,59,0.4);
        }
        
        .upload-area:hover, .upload-area.dragover {
            border-color: #00d2ff;
            background: rgba(0,210,255,0.15);
            transform: scale(1.01);
            box-shadow: 0 5px 20px rgba(0,210,255,0.2);
        }
        
        .upload-icon {
            font-size: 4rem;
            color: #00d2ff;
            margin-bottom: 20px;
        }
        
        .alert {
            border-radius: 15px;
            border: none;
        }
        
        .alert-success {
            background: rgba(0,255,127,0.1);
            color: #00ff7f;
            border-left: 4px solid #00ff7f;
        }
        
        .alert-danger {
            background: rgba(255,0,0,0.1);
            color: #ff4444;
            border-left: 4px solid #ff4444;
        }
    </style>
</head>
<body>
    
    <!-- Top Navigation -->
    <nav class="top-navbar">
        <div class="logo">
            <i class="bi bi-shield-check me-2"></i>MediChain Admin
        </div>
        <div class="user-info">
            <div>
                <div style="font-weight: 600;"><%= user.username %></div>
                <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Administrator</div>
            </div>
            <div class="user-avatar">
                <%= (user.username || 'A').charAt(0).toUpperCase() %>
            </div>
            <a href="/logout" class="btn-logout">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
            </a>
        </div>
    </nav>
    
    <!-- Status Bar -->
    <div class="status-bar">
        <div class="status-card health">
            <div class="status-icon">
                <i class="bi bi-heart-pulse"></i>
            </div>
            <div class="status-value">Healthy</div>
            <div class="status-label">System Status</div>
            <span class="status-badge badge-success" id="systemStatus">All Systems Operational</span>
        </div>
        
        <div class="status-card ipfs">
            <div class="status-icon">
                <i class="bi bi-diagram-3"></i>
            </div>
            <div class="status-value" id="ipfsStatus"><%= ipfsConnected ? 'Running' : 'Offline' %></div>
            <div class="status-label">IPFS Status</div>
            <span class="status-badge <%= ipfsConnected ? 'badge-success' : 'badge-error' %>" id="ipfsBadge"><%= ipfsConnected ? 'Local Node Active' : 'Node Not Running' %></span>
        </div>
        
        <div class="status-card blockchain">
            <div class="status-icon">
                <i class="bi bi-link-45deg"></i>
            </div>
            <div class="status-value"><%= stats.total_blocks || stats.totalBlocks || 0 %></div>
            <div class="status-label">Blockchain Blocks</div>
            <span class="status-badge badge-success"><%= stats.patients_count || stats.patientsCount || 0 %> Patients</span>
        </div>
        
        <div class="status-card patients">
            <div class="status-icon">
                <i class="bi bi-people"></i>
            </div>
            <div class="status-value"><%= patients.length %></div>
            <div class="status-label">Total Patients</div>
            <span class="status-badge badge-success"><%= patients.filter(p => p.username).length %> Registered</span>
        </div>
    </div>
    
    <!-- Upload Medical Record Button -->
    <div style="max-width: 1400px; margin: 0 auto; padding: 0 40px 20px 40px;">
        <a href="/admin/upload" class="btn btn-lg w-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; color: white; font-weight: 600; font-size: 1.1rem; padding: 20px; border-radius: 15px; box-shadow: 0 10px 40px rgba(102,126,234,0.4); transition: all 0.3s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 15px 50px rgba(102,126,234,0.5)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 10px 40px rgba(102,126,234,0.4)';">
            <i class="bi bi-cloud-upload-fill me-3" style="font-size: 1.5rem;"></i>Upload Medical Record
        </a>
    </div>
    
    <!-- Tabs Container -->
    <div class="tabs-container">
        <!-- Tabs Navigation -->
        <div class="tabs-nav">
            <button class="tab-btn active" onclick="switchTab('blockchain')">
                <i class="bi bi-link-45deg me-2"></i>Blockchain Explorer
            </button>
            <button class="tab-btn" onclick="switchTab('records')">
                <i class="bi bi-file-medical me-2"></i>Patient Records
            </button>
            <button class="tab-btn" onclick="switchTab('edit-patient')">
                <i class="bi bi-person-gear me-2"></i>Edit Patient Data
            </button>
            <button class="tab-btn" onclick="switchTab('doctor-patient')">
                <i class="bi bi-people-fill me-2"></i>Doctor-Patient Allocation
            </button>
            <button class="tab-btn" onclick="switchTab('ga-viz')">
                <i class="bi bi-graph-up me-2"></i>GA Visualization
            </button>
        </div>
        
        <!-- Tab: Blockchain Explorer -->
        <div id="blockchain-tab" class="tab-content active">
            <div class="content-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3><i class="bi bi-link-45deg me-2"></i>Blockchain Explorer</h3>
                    <button class="btn btn-primary" onclick="loadBlockchain(20)">
                        <i class="bi bi-arrow-clockwise me-2"></i>Load More Blocks
                    </button>
                </div>
                
                <div id="blockchainList">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-3">Loading blockchain...</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Tab: Patient Records -->
        <div id="records-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-file-medical me-2"></i>Patient Medical Records</h3>
                
                <div class="form-group">
                    <label class="form-label">Select Patient</label>
                    <select class="form-select" id="recordsPatientSelect" onchange="loadPatientRecords()">
                        <option value="">Choose a patient...</option>
                        <% patients.forEach(patient => { %>
                            <option value="<%= patient.patient_id %>">
                                <%= patient.patient_id %> - <%= patient.username || 'Unnamed' %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                
                <div id="patientRecordsList" class="mt-4">
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <h5>Select a patient to view their records</h5>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Tab: Edit Patient Data -->
        <div id="edit-patient-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-person-gear me-2"></i>Edit Patient Information</h3>
                
                <div class="form-group">
                    <label class="form-label">Select Patient</label>
                    <select class="form-select" id="editPatientSelect" onchange="loadPatientData()">
                        <option value="">Choose a patient...</option>
                        <% patients.forEach(patient => { %>
                            <option value="<%= patient.patient_id %>">
                                <%= patient.patient_id %> - <%= patient.username || 'Unnamed' %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                
                <!-- Current Values Display -->
                <div id="currentValuesDisplay" style="display: none;" class="mt-4 mb-4">
                    <div class="card" style="background: rgba(59,130,246,0.2); border: 2px solid rgba(59,130,246,0.5); border-radius: 15px; padding: 25px; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">
                        <h5 style="color: #60a5fa; margin-bottom: 20px; font-weight: bold;">
                            <i class="bi bi-info-circle me-2"></i>Current Patient Information
                        </h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <strong style="color: #93c5fd;">Name:</strong> <span id="current_name" style="color: #e4e4e7;">-</span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <strong style="color: #93c5fd;">Gender:</strong> <span id="current_gender" style="color: #e4e4e7;">-</span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <strong style="color: #93c5fd;">Blood Group:</strong> <span id="current_blood" style="color: #e4e4e7;">-</span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <strong style="color: #93c5fd;">DOB:</strong> <span id="current_dob" style="color: #e4e4e7;">-</span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <strong style="color: #93c5fd;">Height:</strong> <span id="current_height" style="color: #e4e4e7;">-</span> cm
                            </div>
                            <div class="col-md-4 mb-3">
                                <strong style="color: #93c5fd;">Weight:</strong> <span id="current_weight" style="color: #e4e4e7;">-</span> kg
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong style="color: #93c5fd;">Contact:</strong> <span id="current_contact" style="color: #e4e4e7;">-</span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong style="color: #93c5fd;">Email:</strong> <span id="current_email" style="color: #e4e4e7;">-</span>
                            </div>
                            <div class="col-md-12 mb-3">
                                <strong style="color: #93c5fd;">Current Conditions:</strong> <span id="current_conditions" style="color: #e4e4e7;">-</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div id="editPatientForm" style="display: none;" class="mt-4">
                    <form onsubmit="return updatePatientData(event)">
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label">Full Name</label>
                                <label for="edit_full_name" class="form-label small">Username</label>
                                <input type="text" class="form-control" id="edit_full_name" name="full_name" readonly>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label">Gender</label>
                                <select class="form-select" id="edit_gender" name="gender">
                                    <option value="">Select</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label">Date of Birth</label>
                                <input type="date" class="form-control" id="edit_dob" name="date_of_birth">
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label">Blood Group</label>
                                <select class="form-select" id="edit_blood" name="blood_group">
                                    <option value="">Select</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label">Phone</label>
                                <input type="tel" class="form-control" id="edit_phone" name="contact">
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" id="edit_email" name="email">
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label">Height (cm)</label>
                                <input type="number" class="form-control" id="edit_height" name="height" placeholder="e.g., 175">
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label">Weight (kg)</label>
                                <input type="number" class="form-control" id="edit_weight" name="weight" placeholder="e.g., 70">
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">Current Medical Conditions</label>
                            <textarea class="form-control" id="edit_conditions" name="current_conditions" rows="3" placeholder="e.g., Diabetes, Hypertension"></textarea>
                        </div>
                        
                        <input type="hidden" id="edit_patient_id" name="patient_id">
                        
                        <div class="alert alert-success" id="editSuccess" style="display: none;"></div>
                        <div class="alert alert-danger" id="editError" style="display: none;"></div>
                        
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-save me-2"></i>Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>
        
        <!-- Tab: Doctor-Patient Allocation -->
        <div id="doctor-patient-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-people-fill me-2"></i>Doctor-Patient Allocation</h3>
                
                <!-- Assign Doctor Form -->
                <div class="card mb-4" style="background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.3); border-radius: 15px; padding: 30px;">
                    <h5 style="color: #3b82f6; margin-bottom: 20px;">
                        <i class="bi bi-plus-circle me-2"></i>Assign Doctor to Patient
                    </h5>
                    <form id="assignDoctorForm" onsubmit="return assignDoctor(event)">
                        <div class="row">
                            <div class="col-md-5">
                                <label class="form-label">Select Doctor</label>
                                <select class="form-select" id="selectDoctor" required>
                                    <option value="">Choose a doctor...</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Select Patient</label>
                                <select class="form-select" id="selectPatient" required>
                                    <option value="">Choose a patient...</option>
                                    <% patients.forEach(patient => { %>
                                        <option value="<%= patient.patient_id %>">
                                            <%= patient.patient_id %> - <%= patient.username || 'Unnamed' %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-plus-lg me-2"></i>Assign
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
                
                <!-- Current Allocations -->
                <h5 class="mb-3"><i class="bi bi-list-ul me-2"></i>Current Allocations</h5>
                <div id="doctorPatientList">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-3">Loading allocations...</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Tab: GA Visualization -->
        <div id="ga-viz-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-graph-up me-2"></i>Genetic Algorithm Visualization</h3>
                <div class="empty-state">
                    <i class="bi bi-hourglass-split"></i>
                    <h5>Coming Soon</h5>
                    <p>GA-based access control visualization will be implemented here</p>
                    <small style="color: rgba(255,255,255,0.4);">This feature is under development</small>
                </div>
            </div>
        </div>
    </div>
    
    <!-- File Preview Modal -->
    <div class="modal fade" id="filePreviewModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-text me-2"></i>Medical Record Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="modalContent">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tab Switching
        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            
            event.target.classList.add('active');
            document.getElementById(tabName + '-tab').classList.add('active');
            
            // Load data when switching tabs
            if (tabName === 'blockchain') loadBlockchain(10);
            if (tabName === 'doctor-patient') loadDoctorPatientData();
        }
        
        // Check IPFS Status
        async function checkIPFSStatus() {
            console.log('🔍 Checking IPFS status...');
            try {
                const response = await fetch('/admin/api/ipfs-status');
                console.log('📡 IPFS API Response:', response.status);
                const data = await response.json();
                console.log('📊 IPFS Data:', data);
                
                if (data.success && data.connected) {
                    document.getElementById('ipfsStatus').textContent = 'Running';
                    document.getElementById('ipfsBadge').textContent = 'Local Node Active';
                    document.getElementById('ipfsBadge').className = 'status-badge badge-success';
                    console.log('✅ IPFS is running');
                } else {
                    document.getElementById('ipfsStatus').textContent = 'Offline';
                    document.getElementById('ipfsBadge').textContent = 'Node Not Running';
                    document.getElementById('ipfsBadge').className = 'status-badge badge-error';
                    console.log('❌ IPFS is offline');
                }
            } catch (error) {
                console.error('❌ IPFS check error:', error);
                document.getElementById('ipfsStatus').textContent = 'Error';
                document.getElementById('ipfsBadge').textContent = 'Connection Failed';
                document.getElementById('ipfsBadge').className = 'status-badge badge-error';
            }
        }
        
        // Load Blockchain
        async function loadBlockchain(limit = 10) {
            const container = document.getElementById('blockchainList');
            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch('/admin/api/blockchain');
                const data = await response.json();
                
                if (data.success) {
                    const blocks = data.chain.slice(-limit).reverse();
                    let html = '';
                    
                    blocks.forEach(block => {
                        // Use database field names
                        const blockIndex = block.block_index;
                        const blockHash = block.block_hash;
                        const isGenesisBlock = blockIndex === 0;
                        const cid = block.ipfs_cid || 'N/A';
                        const hasCid = cid !== 'N/A' && cid !== '';
                        const patientId = block.patient_id || (isGenesisBlock ? 'Genesis' : 'N/A');
                        const fileType = block.file_type || (isGenesisBlock ? 'System Initialization' : 'N/A');
                        const doctor = block.doc || (isGenesisBlock ? 'System' : 'N/A');
                        const status = block.file_status || 'Open';
                        
                        // Format timestamp
                        let formattedDate = block.timestamp;
                        if (block.timestamp && !isGenesisBlock) {
                            try {
                                const date = new Date(block.timestamp);
                                formattedDate = date.toLocaleString('en-US', {
                                    year: 'numeric',
                                    month: 'short',
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit',
                                    hour12: true
                                });
                            } catch (e) {
                                formattedDate = block.timestamp;
                            }
                        }
                        
                        html += `
                            <div class="block-card" style="border: 2px solid rgba(0,210,255,0.3); border-radius: 15px; padding: 20px; margin-bottom: 15px; background: rgba(15,52,96,0.3);">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="block-index" style="font-size: 1.3rem; color: #00d2ff; font-weight: bold;">Block #${blockIndex}</div>
                                        <small style="color: rgba(255,255,255,0.7);"><i class="bi bi-clock me-1"></i>${formattedDate}</small>
                                    </div>
                                    ${hasCid ? `<button class="btn btn-primary" onclick="viewRecord('${cid}')" style="white-space: nowrap;">
                                        <i class="bi bi-eye me-1"></i>View Details
                                    </button>` : '<span class="badge bg-secondary">Genesis Block</span>'}
                                </div>
                                
                                <div class="row mb-2">
                                    <div class="col-md-4">
                                        <strong style="color: #94a3b8;">Patient ID:</strong> <span style="color: #e4e4e7;">${patientId}</span>
                                    </div>
                                    <div class="col-md-4">
                                        <strong style="color: #94a3b8;">File Type:</strong> <span style="color: #e4e4e7;">${fileType}</span>
                                    </div>
                                    <div class="col-md-4">
                                        <strong style="color: #94a3b8;">Doctor:</strong> <span style="color: #e4e4e7;">${doctor}</span>
                                    </div>
                                </div>
                                
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <strong style="color: #94a3b8;">Status:</strong> <span class="badge ${status === 'Closed' ? 'bg-secondary' : 'bg-success'}">${status}</span>
                                    </div>
                                    ${hasCid ? `<div class="col-md-6">
                                        <strong style="color: #94a3b8;">IPFS CID:</strong> <code style="color: #22c55e; font-size: 0.85rem;">${cid.substring(0, 20)}...</code>
                                    </div>` : ''}
                                </div>
                                
                                <div class="mt-2" style="font-size: 0.75rem; color: rgba(255,255,255,0.5); word-break: break-all;">
                                    <strong>Hash:</strong> ${blockHash}
                                </div>
                            </div>
                        `;
                    });
                    
                    container.innerHTML = html || '<div class="empty-state"><i class="bi bi-inbox"></i><h5>No blocks found</h5></div>';
                } else {
                    container.innerHTML = '<div class="alert alert-danger">Failed to load blockchain</div>';
                }
            } catch (error) {
                container.innerHTML = '<div class="alert alert-danger">Error: ' + error.message + '</div>';
            }
        }
        
        // Load Patient Records
        async function loadPatientRecords() {
            const patientId = document.getElementById('recordsPatientSelect').value;
            const container = document.getElementById('patientRecordsList');
            
            if (!patientId) {
                container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>Select a patient</h5></div>';
                return;
            }
            
            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch('/admin/api/patient-records/' + patientId);
                const data = await response.json();
                
                if (data.success && data.blocks.length > 0) {
                    let html = '';
                    data.blocks.forEach(block => {
                        const hasCid = block.ipfs_cid;
                        
                        // Format timestamp
                        let formattedDate = 'N/A';
                        if (block.timestamp) {
                            try {
                                const date = new Date(block.timestamp);
                                formattedDate = date.toLocaleString('en-US', {
                                    year: 'numeric',
                                    month: 'short',
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit',
                                    hour12: true
                                });
                            } catch (e) {
                                formattedDate = block.timestamp;
                            }
                        }
                        
                        html += `
                            <div class="record-card" style="border: 2px solid rgba(0,210,255,0.3); border-radius: 15px; padding: 20px; margin-bottom: 15px; background: rgba(15,52,96,0.3);">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center mb-3">
                                            <i class="bi bi-file-earmark-medical-fill me-2" style="font-size: 1.5rem; color: #00d2ff;"></i>
                                            <h5 class="mb-0" style="color: #00d2ff;">${block.file_type || 'Medical Record'}</h5>
                                            <span class="badge ms-3" style="background: rgba(148,163,184,0.3);">Block #${block.block_index}</span>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p class="mb-2"><strong style="color: #94a3b8;">Doctor:</strong> <span style="color: #e4e4e7;">${block.doc || 'N/A'}</span></p>
                                                <p class="mb-2"><strong style="color: #94a3b8;">Status:</strong> <span class="badge ${block.file_status === 'Closed' ? 'bg-secondary' : 'bg-success'}">${block.file_status || 'Open'}</span></p>
                                            </div>
                                            <div class="col-md-6">
                                                <p class="mb-2"><strong style="color: #94a3b8;">Date:</strong> <span style="color: #e4e4e7;">${formattedDate}</span></p>
                                                <p class="mb-2"><strong style="color: #94a3b8;">Patient ID:</strong> <span style="color: #e4e4e7;">${block.patient_id || patientId}</span></p>
                                            </div>
                                        </div>
                                    </div>
                                    ${hasCid ? `<button class="btn btn-primary" onclick="viewRecord('${block.ipfs_cid}')" style="height: fit-content;">
                                        <i class="bi bi-eye me-2"></i>View Details
                                    </button>` : `<span class="badge bg-secondary" style="height: fit-content;">No IPFS Data</span>`}
                                </div>
                            </div>
                        `;
                    });
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>No records found for this patient</h5></div>';
                }
            } catch (error) {
                container.innerHTML = '<div class="alert alert-danger">Error: ' + error.message + '</div>';
            }
        }
        
        // View Record with File Preview
        async function viewRecord(cid) {
            const modal = new bootstrap.Modal(document.getElementById('filePreviewModal'));
            const content = document.getElementById('modalContent');
            modal.show();
            
            content.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3">Loading record...</p></div>';
            
            try {
                const response = await fetch('/admin/api/fetch-ipfs/' + cid);
                const result = await response.json();
                
                if (result.success) {
                    const data = result.data;
                    
                    // Normalize data keys - handle both formats
                    const normalizedData = {
                        patient_name: data.patient_name || data['Patient Name'] || 'N/A',
                        patient_id: data.patient_id || data['Patient ID'] || 'N/A',
                        file_type: data.file_type || data['File Type'] || 'N/A',
                        primary_diagnosis: data.primary_diagnosis || data['Disease'] || 'N/A',
                        file_status: data.file_status || data['File Status'] || 'Open',
                        doctor: data.doctor || 'N/A',
                        uploaded_by: data.uploaded_by || data['Uploaded By'] || 'N/A',
                        timestamp: data.timestamp || data['Timestamp'] || 'N/A',
                        description: data.description || data['Description'] || '',
                        file_base64: data.file_base64 || data.file_data || null,
                        filename: data.filename || 'N/A',
                        symptoms: data.symptoms || [],
                        secondary_diagnoses: data.secondary_diagnoses || data.secondary_diagnosis || [],
                        affected_body_parts: data.affected_body_parts || [],
                        treatments_given: data.treatments_given || data.treatments || [],
                        medications: data.medications || [],
                        followup_info: data.followup_info || {}
                    };
                    
                    // Format timestamp
                    let formattedTimestamp = normalizedData.timestamp;
                    if (formattedTimestamp !== 'N/A') {
                        try {
                            const date = new Date(formattedTimestamp);
                            formattedTimestamp = date.toLocaleString('en-US', {
                                year: 'numeric',
                                month: 'short',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit',
                                hour12: true
                            });
                        } catch (e) {}
                    }
                    normalizedData.timestamp = formattedTimestamp;
                    
                    let html = '<div class="container-fluid">';
                    
                    // Metadata
                    html += '<div class="row mb-4">';
                    html += '<div class="col-md-6">';
                    html += `<div class="metadata-item"><strong>Patient Name:</strong> <span style="color: #e4e4e7;">${normalizedData.patient_name}</span></div>`;
                    html += `<div class="metadata-item"><strong>Patient ID:</strong> <span style="color: #e4e4e7;">${normalizedData.patient_id}</span></div>`;
                    html += `<div class="metadata-item"><strong>File Type:</strong> <span style="color: #e4e4e7;">${normalizedData.file_type}</span></div>`;
                    html += `<div class="metadata-item"><strong>Primary Diagnosis:</strong> <span style="color: #e4e4e7;">${normalizedData.primary_diagnosis}</span></div>`;
                    html += '</div>';
                    html += '<div class="col-md-6">';
                    html += `<div class="metadata-item"><strong>Status:</strong> <span class="badge ${normalizedData.file_status === 'Closed' ? 'bg-secondary' : 'bg-success'}">${normalizedData.file_status}</span></div>`;
                    html += `<div class="metadata-item"><strong>Doctor:</strong> <span style="color: #e4e4e7;">${normalizedData.doctor}</span></div>`;
                    html += `<div class="metadata-item"><strong>Uploaded By:</strong> <span style="color: #e4e4e7;">${normalizedData.uploaded_by}</span></div>`;
                    html += `<div class="metadata-item"><strong>Timestamp:</strong> <span style="color: #e4e4e7;">${normalizedData.timestamp}</span></div>`;
                    html += '</div>';
                    html += '</div>';
                    
                    // Symptoms
                    if (normalizedData.symptoms && normalizedData.symptoms.length > 0) {
                        html += '<div class="alert alert-primary" style="background: rgba(59,130,246,0.15); border: 2px solid rgba(59,130,246,0.4);">';
                        html += '<strong style="font-size: 1.1rem; color: #3b82f6;"><i class="bi bi-thermometer-half me-2"></i>Symptoms:</strong><br>';
                        html += '<div class="mt-2">';
                        html += normalizedData.symptoms.map(s => `<span class="badge bg-primary me-1 mb-1" style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">${s}</span>`).join('');
                        html += '</div></div>';
                    }
                    
                    // Secondary Diagnoses
                    if (normalizedData.secondary_diagnoses && normalizedData.secondary_diagnoses.length > 0) {
                        html += '<div class="alert alert-warning" style="background: rgba(251,191,36,0.1); border-color: rgba(251,191,36,0.3);">';
                        html += '<strong><i class="bi bi-clipboard-check me-2"></i>Secondary Diagnoses:</strong> ';
                        html += normalizedData.secondary_diagnoses.map(d => `<span class="badge bg-warning text-dark me-1">${d}</span>`).join('');
                        html += '</div>';
                    }
                    
                    // Body Parts Affected
                    if (normalizedData.affected_body_parts && normalizedData.affected_body_parts.length > 0) {
                        html += '<div class="alert alert-danger" style="background: rgba(239,68,68,0.1); border-color: rgba(239,68,68,0.3);">';
                        html += '<strong><i class="bi bi-heart-pulse me-2"></i>Affected Areas:</strong> ';
                        html += normalizedData.affected_body_parts.map(p => `<span class="badge bg-danger me-1">${p}</span>`).join('');
                        html += '</div>';
                    }
                    
                    // Treatments and Medications
                    if ((normalizedData.treatments_given && normalizedData.treatments_given.length > 0) || (normalizedData.medications && normalizedData.medications.length > 0)) {
                        html += '<div class="row mb-3">';
                        if (normalizedData.treatments_given && normalizedData.treatments_given.length > 0) {
                            html += '<div class="col-md-6">';
                            html += '<div class="alert alert-success" style="background: rgba(34,197,94,0.15); border: 2px solid rgba(34,197,94,0.4);">';
                            html += '<strong style="font-size: 1.1rem; color: #22c55e;"><i class="bi bi-capsule me-2"></i>Treatments:</strong><ul class="mt-2 mb-0" style="color: #e4e4e7; font-size: 0.95rem;">';
                            normalizedData.treatments_given.forEach(t => html += `<li style="margin-bottom: 0.5rem;"><strong>${t}</strong></li>`);
                            html += '</ul></div></div>';
                        }
                        if (normalizedData.medications && normalizedData.medications.length > 0) {
                            html += '<div class="col-md-6">';
                            html += '<div class="alert alert-info" style="background: rgba(6,182,212,0.15); border: 2px solid rgba(6,182,212,0.4);">';
                            html += '<strong style="font-size: 1.1rem; color: #06b6d4;"><i class="bi bi-prescription2 me-2"></i>Medications:</strong><ul class="mt-2 mb-0" style="color: #e4e4e7; font-size: 0.95rem;">';
                            normalizedData.medications.forEach(m => html += `<li style="margin-bottom: 0.5rem;"><strong>${m}</strong></li>`);
                            html += '</ul></div></div>';
                        }
                        html += '</div>';
                    }
                    
                    // Follow-up
                    if (normalizedData.followup_info && normalizedData.followup_info.required) {
                        html += '<div class="alert alert-secondary" style="background: rgba(148,163,184,0.15); border: 2px solid rgba(148,163,184,0.4);">';
                        html += '<strong style="font-size: 1.1rem; color: #94a3b8;"><i class="bi bi-calendar-check me-2"></i>Follow-up Required:</strong> ';
                        if (normalizedData.followup_info.date) html += `<span class="text-warning" style="font-weight: bold; font-size: 1rem;">📅 ${normalizedData.followup_info.date}</span> `;
                        if (normalizedData.followup_info.notes) html += `<br><small style="color: #e4e4e7; font-size: 0.9rem; margin-top: 0.5rem; display: inline-block;">${normalizedData.followup_info.notes}</small>`;
                        html += '</div>';
                    }
                    
                    // Description
                    if (normalizedData.description && normalizedData.description !== 'No additional notes') {
                        html += '<div class="alert alert-light" style="background: rgba(241,245,249,0.15); border: 2px solid rgba(241,245,249,0.3); padding: 1.25rem;">';
                        html += '<strong style="font-size: 1.1rem; color: #00d2ff;"><i class="bi bi-clipboard-text me-2"></i>Additional Notes:</strong>';
                        html += `<p style="color: #e4e4e7; margin-top: 0.75rem; margin-bottom: 0; font-size: 0.95rem; line-height: 1.6;">${normalizedData.description}</p>`;
                        html += '</div>';
                    }
                    
                    // File Preview
                    if (normalizedData.file_base64) {
                        html += '<h5 class="mt-4 mb-3" style="color: #00d2ff;">File Preview:</h5>';
                        const fileType = (normalizedData.file_type || '').toLowerCase();
                        const filename = (normalizedData.filename || 'medical_file').toLowerCase();
                        
                        const isPDF = fileType.includes('pdf') || filename.endsWith('.pdf') || normalizedData.file_base64.startsWith('data:application/pdf');
                        const isImage = fileType.includes('image') || fileType.includes('x-ray') || fileType.includes('scan') || 
                                       fileType.includes('mri') || fileType.includes('ct') ||
                                       filename.match(/\.(jpg|jpeg|png|gif|bmp)$/i) ||
                                       normalizedData.file_base64.startsWith('data:image/');
                        
                        let fileData = normalizedData.file_base64;
                        if (!fileData.startsWith('data:')) {
                            if (isPDF) {
                                fileData = 'data:application/pdf;base64,' + fileData;
                            } else if (isImage) {
                                fileData = 'data:image/jpeg;base64,' + fileData;
                            }
                        }
                        
                        if (isPDF) {
                            html += `
                                <div class="mb-3">
                                    <div style="background: #1e293b; padding: 20px; border-radius: 15px;">
                                        <iframe 
                                            src="${fileData}#toolbar=1&navpanes=1&scrollbar=1" 
                                            type="application/pdf"
                                            width="100%" 
                                            height="700px" 
                                            style="border: none; border-radius: 10px; background: white;">
                                        </iframe>
                                    </div>
                                    <div class="text-center mt-3">
                                        <a href="${fileData}" download="${data.filename || 'medical_report.pdf'}" class="btn btn-primary">
                                            <i class="bi bi-download me-2"></i>Download PDF
                                        </a>
                                    </div>
                                </div>
                            `;
                        } else if (isImage) {
                            html += `
                                <div class="text-center mb-3">
                                    <img src="${fileData}" class="file-preview" alt="Medical Image" style="max-width: 100%; border-radius: 15px; box-shadow: 0 5px 20px rgba(0,0,0,0.3);"/>
                                    <div class="mt-3">
                                        <a href="${fileData}" download="${data.filename || 'medical_image'}" class="btn btn-primary">
                                            <i class="bi bi-download me-2"></i>Download Image
                                        </a>
                                    </div>
                                </div>
                            `;
                        } else {
                            const detectedType = data.file_base64 && data.file_base64.startsWith('data:application/pdf') ? 'PDF (detected)' : 
                                               data.file_base64 && data.file_base64.startsWith('data:image/') ? 'Image (detected)' :
                                               data.file_type || 'Unknown';
                            
                            html += `
                                <div class="text-center p-5" style="background: rgba(15,52,96,0.4); border-radius: 15px;">
                                    <i class="bi bi-file-earmark-text" style="font-size: 4rem; color: #00d2ff;"></i>
                                    <p class="mt-3" style="color: #e4e4e7;">File type: ${detectedType}</p>
                                    <p class="text-muted">Preview not available for this file type</p>
                                    <small class="text-muted">Filename: ${data.filename || 'N/A'}</small>
                                    <div class="mt-3">
                                        <a href="${fileData}" download="${data.filename || 'medical_file'}" class="btn btn-primary">
                                            <i class="bi bi-download me-2"></i>Download File
                                        </a>
                                    </div>
                                </div>
                            `;
                        }
                    } else {
                        html += '<div class="alert alert-warning mt-4">No file attached to this record.</div>';
                    }
                    
                    html += '</div>';
                    content.innerHTML = html;
                } else {
                    content.innerHTML = '<div class="alert alert-danger">Failed to load record</div>';
                }
            } catch (error) {
                content.innerHTML = '<div class="alert alert-danger">Error: ' + error.message + '</div>';
            }
        }
        
        // Load Patient Data for Editing
        async function loadPatientData() {
            const patientId = document.getElementById('editPatientSelect').value;
            const form = document.getElementById('editPatientForm');
            const currentDisplay = document.getElementById('currentValuesDisplay');
            
            if (!patientId) {
                form.style.display = 'none';
                currentDisplay.style.display = 'none';
                return;
            }
            
            try {
                const response = await fetch('/admin/api/patient-data/' + patientId);
                const data = await response.json();
                
                if (data.success) {
                    const patient = data.patient;
                    
                    // Populate current values display
                    document.getElementById('current_name').textContent = patient.username || 'N/A';
                    document.getElementById('current_gender').textContent = patient.gender || 'N/A';
                    document.getElementById('current_blood').textContent = patient.blood_group || 'N/A';
                    document.getElementById('current_dob').textContent = patient.date_of_birth || 'N/A';
                    document.getElementById('current_height').textContent = patient.height || 'N/A';
                    document.getElementById('current_weight').textContent = patient.weight || 'N/A';
                    document.getElementById('current_contact').textContent = patient.contact || 'N/A';
                    document.getElementById('current_email').textContent = patient.email || 'N/A';
                    document.getElementById('current_conditions').textContent = patient.current_conditions || 'N/A';
                    
                    // Populate form fields
                    document.getElementById('edit_full_name').value = patient.username || '';
                    document.getElementById('edit_gender').value = patient.gender || '';
                    document.getElementById('edit_dob').value = patient.date_of_birth || '';
                    document.getElementById('edit_blood').value = patient.blood_group || '';
                    document.getElementById('edit_phone').value = patient.contact || '';
                    document.getElementById('edit_email').value = patient.email || '';
                    document.getElementById('edit_height').value = patient.height || '';
                    document.getElementById('edit_weight').value = patient.weight || '';
                    document.getElementById('edit_conditions').value = patient.current_conditions || '';
                    document.getElementById('edit_patient_id').value = patientId;
                    
                    currentDisplay.style.display = 'block';
                    form.style.display = 'block';
                }
            } catch (error) {
                alert('Error loading patient data: ' + error.message);
            }
        }
        
        // Update Patient Data
        async function updatePatientData(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData);
            
            // Remove full_name as it's readonly and shouldn't be updated
            delete data.full_name;
            
            console.log('Sending update data:', data);
            
            document.getElementById('editSuccess').style.display = 'none';
            document.getElementById('editError').style.display = 'none';
            
            try {
                const response = await fetch('/admin/api/update-patient', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                console.log('Update result:', result);
                
                if (result.success) {
                    document.getElementById('editSuccess').textContent = 'Patient data updated successfully!';
                    document.getElementById('editSuccess').style.display = 'block';
                    // Reload patient data to show updated values
                    setTimeout(() => loadPatientData(), 1000);
                } else {
                    document.getElementById('editError').textContent = 'Failed to update patient data: ' + (result.error || 'Unknown error');
                    document.getElementById('editError').style.display = 'block';
                }
            } catch (error) {
                console.error('Update error:', error);
                document.getElementById('editError').textContent = 'Error: ' + error.message;
                document.getElementById('editError').style.display = 'block';
            }
            
            return false;
        }
        
        // File Upload Handlers
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, e => {e.preventDefault(); e.stopPropagation();}, false);
        });
        
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.add('dragover'), false);
        });
        
        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.remove('dragover'), false);
        });
        
        dropZone.addEventListener('drop', e => {
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                fileInput.files = files;
                handleFileSelect();
            }
        });
        
        fileInput.addEventListener('change', handleFileSelect);
        
        function handleFileSelect() {
            const file = fileInput.files[0];
            if (file) {
                document.getElementById('fileNameUpload').textContent = file.name;
                document.getElementById('fileSizeUpload').textContent = (file.size / 1024).toFixed(2) + ' KB';
                document.getElementById('filename').value = file.name;
                document.getElementById('filePreviewUpload').style.display = 'block';
                
                const reader = new FileReader();
                reader.onload = e => document.getElementById('file_base64').value = e.target.result;
                reader.readAsDataURL(file);
            }
        }
        
        function removeFile() {
            fileInput.value = '';
            document.getElementById('file_base64').value = '';
            document.getElementById('filename').value = '';
            document.getElementById('filePreviewUpload').style.display = 'none';
        }
        
        function updatePatientName() {
            const select = document.getElementById('patient_id');
            const selectedOption = select.options[select.selectedIndex];
            document.getElementById('patient_name').value = selectedOption.getAttribute('data-name') || '';
        }
        
        function handleUpload(e) {
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Uploading...';
            return true;
        }
        
        // Doctor-Patient Management Functions
        async function loadDoctorPatientData() {
            // Load doctors list
            try {
                const response = await fetch('/admin/api/doctors');
                const data = await response.json();
                
                if (data.success) {
                    const select = document.getElementById('selectDoctor');
                    select.innerHTML = '<option value="">Choose a doctor...</option>';
                    data.doctors.forEach(doctor => {
                        select.innerHTML += `<option value="${doctor.doctor_id}">
                            ${doctor.doctor_id} - Dr. ${doctor.username} (${doctor.specialization || 'General'})
                        </option>`;
                    });
                }
            } catch (error) {
                console.error('Error loading doctors:', error);
            }
            
            // Load current relations
            loadDoctorPatientRelations();
        }
        
        async function loadDoctorPatientRelations() {
            const container = document.getElementById('doctorPatientList');
            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch('/admin/api/doctor-patient-relations');
                const data = await response.json();
                
                if (data.success && data.relations.length > 0) {
                    let html = '<div class="table-responsive"><table class="table" style="color: white;"><thead><tr><th>Doctor ID</th><th>Doctor Name</th><th>Specialization</th><th>Patient ID</th><th>Patient Name</th><th>Action</th></tr></thead><tbody>';
                    
                    data.relations.forEach(rel => {
                        html += `
                            <tr>
                                <td>${rel.doc_id}</td>
                                <td>Dr. ${rel.doctor_name}</td>
                                <td>${rel.specialization || 'General'}</td>
                                <td>${rel.pat_id}</td>
                                <td>${rel.patient_name}</td>
                                <td>
                                    <button class="btn btn-sm btn-danger" onclick="removeRelation('${rel.doc_id}', '${rel.pat_id}')">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                </td>
                            </tr>
                        `;
                    });
                    
                    html += '</tbody></table></div>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>No doctor-patient allocations yet</h5></div>';
                }
            } catch (error) {
                container.innerHTML = '<div class="alert alert-danger">Error loading relations: ' + error.message + '</div>';
            }
        }
        
        async function assignDoctor(event) {
            event.preventDefault();
            
            const doctorId = document.getElementById('selectDoctor').value;
            const patientId = document.getElementById('selectPatient').value;
            
            try {
                const response = await fetch('/admin/api/assign-doctor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ doctor_id: doctorId, patient_id: patientId })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    alert('✅ Doctor assigned successfully!');
                    document.getElementById('assignDoctorForm').reset();
                    loadDoctorPatientRelations();
                } else {
                    alert('❌ Error: ' + data.error);
                }
            } catch (error) {
                alert('❌ Error assigning doctor: ' + error.message);
            }
            
            return false;
        }
        
        async function removeRelation(doctorId, patientId) {
            if (!confirm('Are you sure you want to remove this doctor-patient relation?')) {
                return;
            }
            
            try {
                const response = await fetch(`/admin/api/remove-doctor-patient/${doctorId}/${patientId}`, {
                    method: 'DELETE'
                });
                
                const data = await response.json();
                
                if (data.success) {
                    alert('✅ Relation removed successfully!');
                    loadDoctorPatientRelations();
                } else {
                    alert('❌ Error: ' + data.error);
                }
            } catch (error) {
                alert('❌ Error removing relation: ' + error.message);
            }
        }
        
        // Initialize
        console.log('🚀 Dashboard initializing...');
        checkIPFSStatus();
        setInterval(checkIPFSStatus, 30000); // Check every 30 seconds
        console.log('✅ IPFS status check scheduled');
    </script>
</body>
</html>
