                    document.getElementById('current_height').textContent = patient.height || 'N/A';
                    document.getElementById('current_weight').textContent = patient.weight || 'N/A';
                    document.getElementById('current_contact').textContent = patient.contact || 'N/A';
                    document.getElementById('current_email').textContent = patient.email || 'N/A';
                    document.getElementById('current_conditions').textContent = patient.current_conditions || 'N/A';
                    
                    // Populate form fields
                    document.getElementById('edit_full_name').value = patient.username || '';
                    document.getElementById('edit_gender').value = patient.gender || '';
                    document.getElementById('edit_dob').value = patient.date_of_birth || '';
                    document.getElementById('edit_blood').value = patient.blood_group || '';
                    document.getElementById('edit_phone').value = patient.contact || '';
                    document.getElementById('edit_email').value = patient.email || '';
                    document.getElementById('edit_height').value = patient.height || '';
                    document.getElementById('edit_weight').value = patient.weight || '';
                    document.getElementById('edit_conditions').value = patient.current_conditions || '';
                    document.getElementById('edit_patient_id').value = patientId;
                    
                    currentDisplay.style.display = 'block';
                    form.style.display = 'block';
                }
            } catch (error) {
