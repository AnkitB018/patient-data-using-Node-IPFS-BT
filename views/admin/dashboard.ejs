                        </button>
                    </form>
                </div>
            </div>
        </div>
        
        <!-- Tab: Doctor-Patient Allocation -->
        <div id="doctor-patient-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-people-fill me-2"></i>Doctor-Patient Allocation</h3>
                
                <!-- Assign Doctor Form -->
                <div class="card mb-4" style="background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.3); border-radius: 15px; padding: 30px;">
                    <h5 style="color: #3b82f6; margin-bottom: 20px;">
                        <i class="bi bi-plus-circle me-2"></i>Assign Doctor to Patient
                    </h5>
                    <form id="assignDoctorForm" onsubmit="return assignDoctor(event)">
                        <div class="row">
                            <div class="col-md-5">
                                <label class="form-label">Select Doctor</label>
                                <select class="form-select" id="selectDoctor" required>
                                    <option value="">Choose a doctor...</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Select Patient</label>
                                <select class="form-select" id="selectPatient" required>
                                    <option value="">Choose a patient...</option>
                                    <% patients.forEach(patient => { %>
                                        <option value="<%= patient.patient_id %>">
                                            <%= patient.patient_id %> - <%= patient.username || 'Unnamed' %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-plus-lg me-2"></i>Assign
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
                
                <!-- Current Allocations -->
                <h5 class="mb-3"><i class="bi bi-list-ul me-2"></i>Current Allocations</h5>
                <div id="doctorPatientList">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-3">Loading allocations...</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Tab: GA Visualization -->
        <div id="ga-viz-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-graph-up me-2"></i>Genetic Algorithm Visualization</h3>
                <div class="empty-state">
                    <i class="bi bi-hourglass-split"></i>
                    <h5>Coming Soon</h5>
                    <p>GA-based access control visualization will be implemented here</p>
                    <small style="color: rgba(255,255,255,0.4);">This feature is under development</small>
                </div>
            </div>
        </div>

        <!-- Tab: GA Search for Similar Records -->
        <div id="ga-search-tab" class="tab-content">
            <div class="content-card">
                <div class="mb-4">
                    <h3><i class="bi bi-cpu me-2"></i>Intelligent Record Search using Genetic Algorithm</h3>
                    <div class="alert alert-info mt-3" style="background: rgba(0, 210, 255, 0.1); border: 1px solid rgba(0, 210, 255, 0.3); border-radius: 12px; color: #00d2ff;">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>How it works:</strong> This system uses a Genetic Algorithm (GA) to intelligently find the most relevant medical records based on your search criteria. 
                        The GA scores record relevance based on file type matching, patient conditions similarity, blood group, gender, doctor records, and temporal patterns (recent records ranked higher).
                        <br><strong>Note:</strong> Genesis block (block 0) is automatically excluded from searches. Blood group searches patient's blood group field.
                    </div>
                </div>

                <!-- Search Form -->
                <form id="gaSearchForm" onsubmit="performGASearch(event)">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-file-earmark-medical me-2"></i>File Type
                                </label>
                                <select class="form-select" id="ga_file_type">
                                    <option value="">All File Types</option>
                                    <option value="Blood Test">Blood Test</option>
                                    <option value="X-Ray">X-Ray</option>
                                    <option value="MRI Scan">MRI Scan</option>
                                    <option value="CT Scan">CT Scan</option>
                                    <option value="Prescription">Prescription</option>
                                    <option value="Lab Report">Lab Report</option>
                                    <option value="Medical Certificate">Medical Certificate</option>
                                    <option value="Other">Other</option>
                                </select>
                                <small class="text-muted">Optional: Select specific file type for exact matching</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-person me-2"></i>Patient
                                </label>
                                <select class="form-select" id="ga_patient_id">
                                    <option value="">All Patients</option>
                                    <% patients.forEach(patient => { %>
                                        <option value="<%= patient.patient_id %>">
                                            <%= patient.patient_id %> - <%= patient.username || 'Unnamed' %>
                                        </option>
                                    <% }); %>
                                </select>
                                <small class="text-muted">Optional: Filter by specific patient</small>
                            </div>
                        </div>
                    </div>

                    <!-- Primary Medical Criteria (Highest Priority) -->
                    <div class="alert alert-success mt-3" style="background: rgba(40, 167, 69, 0.1); border: 1px solid rgba(40, 167, 69, 0.3);">
                        <strong><i class="bi bi-star-fill me-2"></i>High Priority Fields</strong> (More weight in search)
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-clipboard-pulse me-2"></i>Primary Diagnosis
                                </label>
                                <input type="text" class="form-control" id="ga_primary_diagnosis" 
                                       placeholder="e.g., Pneumonia, Diabetes Type 2">
                                <small class="text-muted"><strong>Weight: Very High</strong> - Main medical condition</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-thermometer-half me-2"></i>Symptoms
                                </label>
                                <div id="ga_symptoms_container">
