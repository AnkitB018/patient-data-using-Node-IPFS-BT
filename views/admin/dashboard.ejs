                                               placeholder="e.g., Oxygen therapy, Physical therapy">
                                        <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)" style="display:none;">
                                            <i class="bi bi-dash-circle"></i>
                                        </button>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addGATreatment()">
                                    <i class="bi bi-plus-circle me-1"></i>Add More Treatments
