        // View Record with File Preview
        async function viewRecord(cid) {
            const modal = new bootstrap.Modal(document.getElementById('filePreviewModal'));
            const content = document.getElementById('modalContent');
            modal.show();
            
            content.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3">Loading record...</p></div>';
            
            try {
                const response = await fetch('/admin/api/fetch-ipfs/' + cid);
                const result = await response.json();
                
                if (result.success) {
                    const data = result.data;
                    
                    // Normalize data keys - handle both formats
                    const normalizedData = {
                        patient_name: data.patient_name || data['Patient Name'] || 'N/A',
                        patient_id: data.patient_id || data['Patient ID'] || 'N/A',
                        file_type: data.file_type || data['File Type'] || 'N/A',
                        primary_diagnosis: data.primary_diagnosis || data['Disease'] || 'N/A',
                        file_status: data.file_status || data['File Status'] || 'Open',
                        doctor: data.doctor || 'N/A',
                        uploaded_by: data.uploaded_by || data['Uploaded By'] || 'N/A',
                        timestamp: data.timestamp || data['Timestamp'] || 'N/A',
                        description: data.description || data['Description'] || '',
                        file_base64: data.file_base64 || data.file_data || null,
                        filename: data.filename || 'N/A',
                        symptoms: data.symptoms || [],
                        secondary_diagnoses: data.secondary_diagnoses || data.secondary_diagnosis || [],
                        affected_body_parts: data.affected_body_parts || [],
                        treatments_given: data.treatments_given || data.treatments || [],
                        medications: data.medications || [],
                        followup_info: data.followup_info || {}
                    };
                    
                    // Format timestamp
                    let formattedTimestamp = normalizedData.timestamp;
                    if (formattedTimestamp !== 'N/A') {
                        try {
                            const date = new Date(formattedTimestamp);
                            formattedTimestamp = date.toLocaleString('en-US', {
                                year: 'numeric',
                                month: 'short',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit',
                                hour12: true
                            });
                        } catch (e) {}
                    }
                    normalizedData.timestamp = formattedTimestamp;
                    
                    let html = '<div class="container-fluid">';
                    
                    // Metadata
                    html += '<div class="row mb-4">';
                    html += '<div class="col-md-6">';
                    html += `<div class="metadata-item"><strong>Patient Name:</strong> <span style="color: #e4e4e7;">${normalizedData.patient_name}</span></div>`;
                    html += `<div class="metadata-item"><strong>Patient ID:</strong> <span style="color: #e4e4e7;">${normalizedData.patient_id}</span></div>`;
                    html += `<div class="metadata-item"><strong>File Type:</strong> <span style="color: #e4e4e7;">${normalizedData.file_type}</span></div>`;
                    html += `<div class="metadata-item"><strong>Primary Diagnosis:</strong> <span style="color: #e4e4e7;">${normalizedData.primary_diagnosis}</span></div>`;
                    html += '</div>';
                    html += '<div class="col-md-6">';
                    html += `<div class="metadata-item"><strong>Status:</strong> <span class="badge ${normalizedData.file_status === 'Closed' ? 'bg-secondary' : 'bg-success'}">${normalizedData.file_status}</span></div>`;
                    html += `<div class="metadata-item"><strong>Doctor:</strong> <span style="color: #e4e4e7;">${normalizedData.doctor}</span></div>`;
                    html += `<div class="metadata-item"><strong>Uploaded By:</strong> <span style="color: #e4e4e7;">${normalizedData.uploaded_by}</span></div>`;
                    html += `<div class="metadata-item"><strong>Timestamp:</strong> <span style="color: #e4e4e7;">${normalizedData.timestamp}</span></div>`;
                    html += '</div>';
                    html += '</div>';
                    
                    // Symptoms
                    if (normalizedData.symptoms && normalizedData.symptoms.length > 0) {
                        html += '<div class="alert alert-primary" style="background: rgba(59,130,246,0.15); border: 2px solid rgba(59,130,246,0.4);">';
                        html += '<strong style="font-size: 1.1rem; color: #3b82f6;"><i class="bi bi-thermometer-half me-2"></i>Symptoms:</strong><br>';
                        html += '<div class="mt-2">';
                        html += normalizedData.symptoms.map(s => `<span class="badge bg-primary me-1 mb-1" style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">${s}</span>`).join('');
                        html += '</div></div>';
                    }
                    
                    // Secondary Diagnoses
                    if (normalizedData.secondary_diagnoses && normalizedData.secondary_diagnoses.length > 0) {
                        html += '<div class="alert alert-warning" style="background: rgba(251,191,36,0.1); border-color: rgba(251,191,36,0.3);">';
                        html += '<strong><i class="bi bi-clipboard-check me-2"></i>Secondary Diagnoses:</strong> ';
                        html += normalizedData.secondary_diagnoses.map(d => `<span class="badge bg-warning text-dark me-1">${d}</span>`).join('');
                        html += '</div>';
                    }
                    
                    // Body Parts Affected
                    if (normalizedData.affected_body_parts && normalizedData.affected_body_parts.length > 0) {
                        html += '<div class="alert alert-danger" style="background: rgba(239,68,68,0.1); border-color: rgba(239,68,68,0.3);">';
                        html += '<strong><i class="bi bi-heart-pulse me-2"></i>Affected Areas:</strong> ';
                        html += normalizedData.affected_body_parts.map(p => `<span class="badge bg-danger me-1">${p}</span>`).join('');
                        html += '</div>';
                    }
                    
                    // Treatments and Medications
                    if ((normalizedData.treatments_given && normalizedData.treatments_given.length > 0) || (normalizedData.medications && normalizedData.medications.length > 0)) {
                        html += '<div class="row mb-3">';
                        if (normalizedData.treatments_given && normalizedData.treatments_given.length > 0) {
                            html += '<div class="col-md-6">';
                            html += '<div class="alert alert-success" style="background: rgba(34,197,94,0.15); border: 2px solid rgba(34,197,94,0.4);">';
                            html += '<strong style="font-size: 1.1rem; color: #22c55e;"><i class="bi bi-capsule me-2"></i>Treatments:</strong><ul class="mt-2 mb-0" style="color: #e4e4e7; font-size: 0.95rem;">';
                            normalizedData.treatments_given.forEach(t => html += `<li style="margin-bottom: 0.5rem;"><strong>${t}</strong></li>`);
                            html += '</ul></div></div>';
                        }
                        if (normalizedData.medications && normalizedData.medications.length > 0) {
                            html += '<div class="col-md-6">';
                            html += '<div class="alert alert-info" style="background: rgba(6,182,212,0.15); border: 2px solid rgba(6,182,212,0.4);">';
                            html += '<strong style="font-size: 1.1rem; color: #06b6d4;"><i class="bi bi-prescription2 me-2"></i>Medications:</strong><ul class="mt-2 mb-0" style="color: #e4e4e7; font-size: 0.95rem;">';
                            normalizedData.medications.forEach(m => html += `<li style="margin-bottom: 0.5rem;"><strong>${m}</strong></li>`);
                            html += '</ul></div></div>';
                        }
                        html += '</div>';
                    }
                    
                    // Follow-up
                    if (normalizedData.followup_info && normalizedData.followup_info.required) {
                        html += '<div class="alert alert-secondary" style="background: rgba(148,163,184,0.15); border: 2px solid rgba(148,163,184,0.4);">';
                        html += '<strong style="font-size: 1.1rem; color: #94a3b8;"><i class="bi bi-calendar-check me-2"></i>Follow-up Required:</strong> ';
                        if (normalizedData.followup_info.date) html += `<span class="text-warning" style="font-weight: bold; font-size: 1rem;">📅 ${normalizedData.followup_info.date}</span> `;
                        if (normalizedData.followup_info.notes) html += `<br><small style="color: #e4e4e7; font-size: 0.9rem; margin-top: 0.5rem; display: inline-block;">${normalizedData.followup_info.notes}</small>`;
                        html += '</div>';
                    }
                    
                    // Description
                    if (normalizedData.description && normalizedData.description !== 'No additional notes') {
                        html += '<div class="alert alert-light" style="background: rgba(241,245,249,0.15); border: 2px solid rgba(241,245,249,0.3); padding: 1.25rem;">';
                        html += '<strong style="font-size: 1.1rem; color: #00d2ff;"><i class="bi bi-clipboard-text me-2"></i>Additional Notes:</strong>';
                        html += `<p style="color: #e4e4e7; margin-top: 0.75rem; margin-bottom: 0; font-size: 0.95rem; line-height: 1.6;">${normalizedData.description}</p>`;
                        html += '</div>';
                    }
                    
                    // File Preview
                    if (normalizedData.file_base64) {
                        html += '<h5 class="mt-4 mb-3" style="color: #00d2ff;">File Preview:</h5>';
                        const fileType = (normalizedData.file_type || '').toLowerCase();
                        const filename = (normalizedData.filename || 'medical_file').toLowerCase();
                        
                        const isPDF = fileType.includes('pdf') || filename.endsWith('.pdf') || normalizedData.file_base64.startsWith('data:application/pdf');
                        const isImage = fileType.includes('image') || fileType.includes('x-ray') || fileType.includes('scan') || 
                                       fileType.includes('mri') || fileType.includes('ct') ||
                                       filename.match(/\.(jpg|jpeg|png|gif|bmp)$/i) ||
                                       normalizedData.file_base64.startsWith('data:image/');
                        
                        let fileData = normalizedData.file_base64;
                        if (!fileData.startsWith('data:')) {
                            if (isPDF) {
                                fileData = 'data:application/pdf;base64,' + fileData;
                            } else if (isImage) {
                                fileData = 'data:image/jpeg;base64,' + fileData;
                            }
                        }
                        
                        if (isPDF) {
                            html += `
                                <div class="mb-3">
                                    <div style="background: #1e293b; padding: 20px; border-radius: 15px;">
                                        <iframe 
                                            src="${fileData}#toolbar=1&navpanes=1&scrollbar=1" 
                                            type="application/pdf"
                                            width="100%" 
                                            height="700px" 
                                            style="border: none; border-radius: 10px; background: white;">
                                        </iframe>
                                    </div>
                                    <div class="text-center mt-3">
                                        <a href="${fileData}" download="${data.filename || 'medical_report.pdf'}" class="btn btn-primary">
                                            <i class="bi bi-download me-2"></i>Download PDF
                                        </a>
                                    </div>
                                </div>
                            `;
                        } else if (isImage) {
                            html += `
                                <div class="text-center mb-3">
                                    <img src="${fileData}" class="file-preview" alt="Medical Image" style="max-width: 100%; border-radius: 15px; box-shadow: 0 5px 20px rgba(0,0,0,0.3);"/>
                                    <div class="mt-3">
                                        <a href="${fileData}" download="${data.filename || 'medical_image'}" class="btn btn-primary">
                                            <i class="bi bi-download me-2"></i>Download Image
                                        </a>
                                    </div>
                                </div>
                            `;
                        } else {
                            const detectedType = data.file_base64 && data.file_base64.startsWith('data:application/pdf') ? 'PDF (detected)' : 
                                               data.file_base64 && data.file_base64.startsWith('data:image/') ? 'Image (detected)' :
                                               data.file_type || 'Unknown';
                            
                            html += `
                                <div class="text-center p-5" style="background: rgba(15,52,96,0.4); border-radius: 15px;">
                                    <i class="bi bi-file-earmark-text" style="font-size: 4rem; color: #00d2ff;"></i>
                                    <p class="mt-3" style="color: #e4e4e7;">File type: ${detectedType}</p>
                                    <p class="text-muted">Preview not available for this file type</p>
                                    <small class="text-muted">Filename: ${data.filename || 'N/A'}</small>
                                    <div class="mt-3">
                                        <a href="${fileData}" download="${data.filename || 'medical_file'}" class="btn btn-primary">
                                            <i class="bi bi-download me-2"></i>Download File
                                        </a>
                                    </div>
                                </div>
                            `;
                        }
                    } else {
                        html += '<div class="alert alert-warning mt-4">No file attached to this record.</div>';
                    }
                    
                    html += '</div>';
                    content.innerHTML = html;
                } else {
                    content.innerHTML = '<div class="alert alert-danger">Failed to load record</div>';
                }
            } catch (error) {
                content.innerHTML = '<div class="alert alert-danger">Error: ' + error.message + '</div>';
            }
        }
        
        // Load Patient Data for Editing
        async function loadPatientData() {
            const patientId = document.getElementById('editPatientSelect').value;
            const form = document.getElementById('editPatientForm');
            const currentDisplay = document.getElementById('currentValuesDisplay');
            
            if (!patientId) {
                form.style.display = 'none';
                currentDisplay.style.display = 'none';
                return;
            }
            
            try {
                const response = await fetch('/admin/api/patient-data/' + patientId);
                const data = await response.json();
                
                if (data.success) {
                    const patient = data.patient;
                    
                    // Populate current values display
                    document.getElementById('current_name').textContent = patient.username || 'N/A';
                    document.getElementById('current_gender').textContent = patient.gender || 'N/A';
                    document.getElementById('current_blood').textContent = patient.blood_group || 'N/A';
                    document.getElementById('current_dob').textContent = patient.date_of_birth || 'N/A';
                    document.getElementById('current_height').textContent = patient.height || 'N/A';
                    document.getElementById('current_weight').textContent = patient.weight || 'N/A';
                    document.getElementById('current_contact').textContent = patient.contact || 'N/A';
                    document.getElementById('current_email').textContent = patient.email || 'N/A';
                    document.getElementById('current_conditions').textContent = patient.current_conditions || 'N/A';
                    
                    // Populate form fields
                    document.getElementById('edit_full_name').value = patient.username || '';
                    document.getElementById('edit_gender').value = patient.gender || '';
                    document.getElementById('edit_dob').value = patient.date_of_birth || '';
                    document.getElementById('edit_blood').value = patient.blood_group || '';
                    document.getElementById('edit_phone').value = patient.contact || '';
                    document.getElementById('edit_email').value = patient.email || '';
                    document.getElementById('edit_height').value = patient.height || '';
                    document.getElementById('edit_weight').value = patient.weight || '';
                    document.getElementById('edit_conditions').value = patient.current_conditions || '';
                    document.getElementById('edit_patient_id').value = patientId;
                    
                    currentDisplay.style.display = 'block';
                    form.style.display = 'block';
                }
            } catch (error) {
                alert('Error loading patient data: ' + error.message);
            }
        }
        
        // Update Patient Data
        async function updatePatientData(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData);
            
            // Remove full_name as it's readonly and shouldn't be updated
            delete data.full_name;
            
            console.log('Sending update data:', data);
            
            document.getElementById('editSuccess').style.display = 'none';
            document.getElementById('editError').style.display = 'none';
            
            try {
                const response = await fetch('/admin/api/update-patient', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                console.log('Update result:', result);
                
                if (result.success) {
                    document.getElementById('editSuccess').textContent = 'Patient data updated successfully!';
                    document.getElementById('editSuccess').style.display = 'block';
                    // Reload patient data to show updated values
                    setTimeout(() => loadPatientData(), 1000);
                } else {
                    document.getElementById('editError').textContent = 'Failed to update patient data: ' + (result.error || 'Unknown error');
                    document.getElementById('editError').style.display = 'block';
                }
            } catch (error) {
                console.error('Update error:', error);
                document.getElementById('editError').textContent = 'Error: ' + error.message;
                document.getElementById('editError').style.display = 'block';
            }
            
            return false;
        }
        
        // File Upload Handlers
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, e => {e.preventDefault(); e.stopPropagation();}, false);
        });
        
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.add('dragover'), false);
        });
        
        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.remove('dragover'), false);
        });
        
        dropZone.addEventListener('drop', e => {
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                fileInput.files = files;
                handleFileSelect();
            }
        });
        
        fileInput.addEventListener('change', handleFileSelect);
        
        function handleFileSelect() {
            const file = fileInput.files[0];
            if (file) {
                document.getElementById('fileNameUpload').textContent = file.name;
                document.getElementById('fileSizeUpload').textContent = (file.size / 1024).toFixed(2) + ' KB';
                document.getElementById('filename').value = file.name;
                document.getElementById('filePreviewUpload').style.display = 'block';
                
                const reader = new FileReader();
                reader.onload = e => document.getElementById('file_base64').value = e.target.result;
                reader.readAsDataURL(file);
            }
        }
        
        function removeFile() {
            fileInput.value = '';
            document.getElementById('file_base64').value = '';
            document.getElementById('filename').value = '';
            document.getElementById('filePreviewUpload').style.display = 'none';
        }
        
        function updatePatientName() {
            const select = document.getElementById('patient_id');
            const selectedOption = select.options[select.selectedIndex];
            document.getElementById('patient_name').value = selectedOption.getAttribute('data-name') || '';
        }
        
        function handleUpload(e) {
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Uploading...';
            return true;
        }
        
        // Doctor-Patient Management Functions
        async function loadDoctorPatientData() {
            // Load doctors list
            try {
                const response = await fetch('/admin/api/doctors');
                const data = await response.json();
                
                if (data.success) {
                    const select = document.getElementById('selectDoctor');
                    select.innerHTML = '<option value="">Choose a doctor...</option>';
                    data.doctors.forEach(doctor => {
                        select.innerHTML += `<option value="${doctor.doctor_id}">
                            ${doctor.doctor_id} - Dr. ${doctor.username} (${doctor.specialization || 'General'})
                        </option>`;
                    });
                }
            } catch (error) {
                console.error('Error loading doctors:', error);
            }
            
            // Load current relations
            loadDoctorPatientRelations();
        }
        
        async function loadDoctorPatientRelations() {
            const container = document.getElementById('doctorPatientList');
            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch('/admin/api/doctor-patient-relations');
                const data = await response.json();
                
                if (data.success && data.relations.length > 0) {
                    let html = '<div class="table-responsive"><table class="table" style="color: white;"><thead><tr><th>Doctor ID</th><th>Doctor Name</th><th>Specialization</th><th>Patient ID</th><th>Patient Name</th><th>Action</th></tr></thead><tbody>';
                    
                    data.relations.forEach(rel => {
                        html += `
                            <tr>
                                <td>${rel.doc_id}</td>
                                <td>Dr. ${rel.doctor_name}</td>
                                <td>${rel.specialization || 'General'}</td>
                                <td>${rel.pat_id}</td>
                                <td>${rel.patient_name}</td>
                                <td>
                                    <button class="btn btn-sm btn-danger" onclick="removeRelation('${rel.doc_id}', '${rel.pat_id}')">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                </td>
                            </tr>
                        `;
                    });
                    
                    html += '</tbody></table></div>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><h5>No doctor-patient allocations yet</h5></div>';
                }
            } catch (error) {
                container.innerHTML = '<div class="alert alert-danger">Error loading relations: ' + error.message + '</div>';
            }
        }
        
        async function assignDoctor(event) {
            event.preventDefault();
            
            const doctorId = document.getElementById('selectDoctor').value;
            const patientId = document.getElementById('selectPatient').value;
            
            try {
                const response = await fetch('/admin/api/assign-doctor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ doctor_id: doctorId, patient_id: patientId })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    alert('✅ Doctor assigned successfully!');
                    document.getElementById('assignDoctorForm').reset();
                    loadDoctorPatientRelations();
                } else {
                    alert('❌ Error: ' + data.error);
                }
            } catch (error) {
                alert('❌ Error assigning doctor: ' + error.message);
            }
            
            return false;
        }
        
        async function removeRelation(doctorId, patientId) {
            if (!confirm('Are you sure you want to remove this doctor-patient relation?')) {
                return;
            }
            
            try {
                const response = await fetch(`/admin/api/remove-doctor-patient/${doctorId}/${patientId}`, {
                    method: 'DELETE'
                });
                
                const data = await response.json();
                
                if (data.success) {
                    alert('✅ Relation removed successfully!');
                    loadDoctorPatientRelations();
                } else {
                    alert('❌ Error: ' + data.error);
                }
            } catch (error) {
                alert('❌ Error removing relation: ' + error.message);
            }
        }
        
        // ==================== GA SEARCH FUNCTIONS ====================
        
        async function performGASearch(event) {
            event.preventDefault();
            
            const btn = document.getElementById('gaSearchBtn');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Running GA...';
            
            const searchCriteria = {
                file_type: document.getElementById('ga_file_type').value.trim(),
                patient_id: document.getElementById('ga_patient_id').value.trim(),
                current_conditions: document.getElementById('ga_conditions').value.trim(),
                primary_diagnosis: document.getElementById('ga_primary_diagnosis').value.trim(),
                symptoms: collectFieldValues('ga-symptom-field'),
                affected_body_parts: document.getElementById('ga_body_parts').value.trim(),
                medications: collectFieldValues('ga-medication-field'),
                treatments: collectFieldValues('ga-treatment-field'),
                secondary_diagnoses: collectFieldValues('ga-secondary-diagnosis-field'),
                blood_group: document.getElementById('ga_blood_group').value.trim(),
                gender: document.getElementById('ga_gender').value,
                age_range: document.getElementById('ga_age_range').value,
                doctor_id: document.getElementById('ga_doctor_id').value.trim(),
                limit: parseInt(document.getElementById('ga_limit').value) || 10
            };
            
            // Check if at least one criteria is provided
            const hasSearchCriteria = searchCriteria.file_type || searchCriteria.patient_id || 
                                      searchCriteria.current_conditions || searchCriteria.primary_diagnosis ||
                                      searchCriteria.symptoms || searchCriteria.affected_body_parts ||
                                      searchCriteria.medications || searchCriteria.treatments ||
                                      searchCriteria.secondary_diagnoses || searchCriteria.blood_group || 
                                      searchCriteria.gender || searchCriteria.age_range || searchCriteria.doctor_id;
            
            if (!hasSearchCriteria) {
                alert('⚠️ Please fill in at least one search criterion');
                btn.disabled = false;
                btn.innerHTML = originalText;
                return;
            }
            
            try {
                const response = await fetch('/api/ga/recommend', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(searchCriteria)
                });
                
                const data = await response.json();
                
                if (data.success) {
                    displayGAResults(data);
                } else {
                    alert('❌ Error: ' + (data.error || 'Failed to perform GA search'));
                }
            } catch (error) {
                console.error('GA Search Error:', error);
                alert('❌ Error performing search: ' + error.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }
        
        function displayGAResults(data) {
            const resultsSection = document.getElementById('gaResults');
            const resultsContent = document.getElementById('gaResultsContent');
            
            resultsSection.style.display = 'block';
            
            if (data.recommendations.length === 0) {
                resultsContent.innerHTML = `
                    <div class="alert alert-warning" style="background: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.3);">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        No matching records found. Try adjusting your search criteria.
                    </div>
                    <div class="mt-3">
                        <strong>Search analyzed:</strong> ${data.totalRecordsAnalyzed} total records<br>
                        <strong>Generations:</strong> ${data.config.generations}<br>
                        <strong>Population size:</strong> ${data.config.populationSize}
                    </div>
                `;
                return;
            }
            
            let html = `
                <div class="alert alert-success mb-4" style="background: rgba(0, 255, 127, 0.1); border: 1px solid rgba(0, 255, 127, 0.3);">
                    <i class="bi bi-check-circle me-2"></i>
                    <strong>GA Search Complete!</strong> Found ${data.recommendations.length} relevant records from ${data.totalRecordsAnalyzed} total records.
                    <br><small>Processed through ${data.config.generations} generations with population size of ${data.config.populationSize}</small>
                </div>
                
                <div class="row">
            `;
            
            data.recommendations.forEach((record, index) => {
                const matchColor = record.matchPercentage >= 80 ? '#00ff7f' : 
                                 record.matchPercentage >= 60 ? '#00d2ff' : 
                                 record.matchPercentage >= 40 ? '#ffd700' : '#ff6b6b';
                
                html += `
                    <div class="col-md-6 mb-3">
                        <div class="card" style="background: rgba(30,41,59,0.8); border: 2px solid ${matchColor}; border-radius: 15px; padding: 20px; color: white;">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 style="color: ${matchColor};">
                                    <i class="bi bi-file-earmark-medical me-2"></i>
                                    Record #${index + 1}
                                </h5>
                                <span class="badge" style="background: ${matchColor}; color: #000; font-size: 1.2rem; padding: 8px 15px;">
                                    ${record.matchPercentage}% Match
                                </span>
                            </div>
                            
                            <div class="record-details">
                                <div class="mb-2">
                                    <i class="bi bi-fingerprint me-2"></i>
                                    <strong>Block Index:</strong> ${record.block_index}
                                </div>
                                <div class="mb-2">
                                    <i class="bi bi-person me-2"></i>
                                    <strong>Patient:</strong> ${record.patient_username || 'N/A'} (ID: ${record.patient_id})
                                </div>
                                <div class="mb-2">
                                    <i class="bi bi-file-text me-2"></i>
                                    <strong>File Type:</strong> ${record.file_type || 'N/A'}
                                </div>
                                ${record.doctor_username ? `
                                <div class="mb-2">
                                    <i class="bi bi-person-badge me-2"></i>
                                    <strong>Doctor:</strong> ${record.doctor_username} (ID: ${record.doctor_id})
                                </div>
                                ` : ''}
                                ${record.current_conditions ? `
                                <div class="mb-2">
                                    <i class="bi bi-heart-pulse me-2"></i>
                                    <strong>Conditions:</strong> ${record.current_conditions}
                                </div>
                                ` : ''}
                                ${record.gender ? `
                                <div class="mb-2">
                                    <i class="bi bi-gender-ambiguous me-2"></i>
                                    <strong>Gender:</strong> ${record.gender}
                                </div>
                                ` : ''}
                                ${record.blood_group ? `
                                <div class="mb-2">
                                    <i class="bi bi-droplet me-2"></i>
                                    <strong>Blood Group:</strong> ${record.blood_group}
                                </div>
                                ` : ''}
                                <div class="mb-2">
                                    <i class="bi bi-clock me-2"></i>
                                    <strong>Date:</strong> ${new Date(record.timestamp).toLocaleString()}
                                </div>
                                <div class="mb-2">
                                    <i class="bi bi-link-45deg me-2"></i>
                                    <strong>IPFS CID:</strong> 
                                    <code style="font-size: 0.75rem; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">
                                        ${record.ipfs_cid ? record.ipfs_cid.substring(0, 30) + '...' : 'N/A'}
                                    </code>
                                </div>
                                
                                <hr style="border-color: rgba(255,255,255,0.2); margin: 15px 0;">
                                
                                <div class="fitness-details" style="font-size: 0.85rem; color: rgba(255,255,255,0.7);">
                                    <div><strong>Fitness Score:</strong> ${record.fitnessScore}</div>
                                    <div><strong>Raw Score:</strong> ${record.rawScore} / ${record.maxScore}</div>
                                </div>
                                
                                <div class="mt-3">
                                    <button class="btn btn-sm btn-primary w-100" onclick="viewRecord('${record.ipfs_cid}', '${record.file_type}', ${record.block_index})">
                                        <i class="bi bi-eye me-2"></i>View Full Record
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            
            html += '</div>';
            resultsContent.innerHTML = html;
            
            // Scroll to results
            resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        
        // GA Search - Add/Remove field functions
        function addGASymptom() {
            const container = document.getElementById('ga_symptoms_container');
            const newField = document.createElement('div');
            newField.className = 'input-group mb-2';
            newField.innerHTML = `
                <input type="text" class="form-control ga-symptom-field" placeholder="e.g., fever, headache">
                <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)">
                    <i class="bi bi-dash-circle"></i>
                </button>
            `;
            container.appendChild(newField);
            updateRemoveButtons(container);
        }
        
        function addGAMedication() {
            const container = document.getElementById('ga_medications_container');
            const newField = document.createElement('div');
            newField.className = 'input-group mb-2';
            newField.innerHTML = `
                <input type="text" class="form-control ga-medication-field" placeholder="e.g., Amoxicillin 500mg">
                <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)">
                    <i class="bi bi-dash-circle"></i>
                </button>
            `;
            container.appendChild(newField);
            updateRemoveButtons(container);
        }
        
        function addGATreatment() {
            const container = document.getElementById('ga_treatments_container');
            const newField = document.createElement('div');
            newField.className = 'input-group mb-2';
            newField.innerHTML = `
                <input type="text" class="form-control ga-treatment-field" placeholder="e.g., Oxygen therapy">
                <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)">
                    <i class="bi bi-dash-circle"></i>
                </button>
            `;
            container.appendChild(newField);
            updateRemoveButtons(container);
        }
        
        function addGASecondaryDiagnosis() {
            const container = document.getElementById('ga_secondary_diagnosis_container');
            const newField = document.createElement('div');
            newField.className = 'input-group mb-2';
            newField.innerHTML = `
                <input type="text" class="form-control ga-secondary-diagnosis-field" placeholder="e.g., Hypertension">
                <button type="button" class="btn btn-outline-danger" onclick="removeGAField(this)">
                    <i class="bi bi-dash-circle"></i>
                </button>
            `;
            container.appendChild(newField);
            updateRemoveButtons(container);
        }
        
        function removeGAField(button) {
            const container = button.closest('.input-group').parentElement;
            button.closest('.input-group').remove();
            updateRemoveButtons(container);
        }
        
        function updateRemoveButtons(container) {
            const inputGroups = container.querySelectorAll('.input-group');
            inputGroups.forEach((group, index) => {
                const removeBtn = group.querySelector('.btn-outline-danger');
                if (removeBtn) {
                    removeBtn.style.display = inputGroups.length > 1 ? 'block' : 'none';
                }
            });
        }
        
        // Helper function to collect values from multiple fields
        function collectFieldValues(className) {
            const fields = document.querySelectorAll('.' + className);
            const values = [];
            fields.forEach(field => {
                const value = field.value.trim();
                if (value) values.push(value);
            });
            return values.join(', ');
        }
        
        function clearGASearch() {
            document.getElementById('gaSearchForm').reset();
            document.getElementById('gaResults').style.display = 'none';
            
            // Reset multi-field containers to single field
            ['ga_symptoms_container', 'ga_medications_container', 'ga_treatments_container', 'ga_secondary_diagnosis_container'].forEach(containerId => {
                const container = document.getElementById(containerId);
                const inputGroups = container.querySelectorAll('.input-group');
                // Remove all except first
                for (let i = 1; i < inputGroups.length; i++) {
                    inputGroups[i].remove();
                }
                // Clear first input
                const firstInput = container.querySelector('input');
                if (firstInput) firstInput.value = '';
                // Hide remove button on first field
                const removeBtn = container.querySelector('.btn-outline-danger');
                if (removeBtn) removeBtn.style.display = 'none';
            });
        }

        console.log('🚀 Dashboard initializing...');
        checkIPFSStatus();
        setInterval(checkIPFSStatus, 30000); // Check every 30 seconds
        console.log('✅ IPFS status check scheduled');
    </script>
</body>
</html>

