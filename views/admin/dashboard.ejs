                <div id="doctorPatientList">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-3">Loading allocations...</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Tab: GA Visualization -->
        <div id="ga-viz-tab" class="tab-content">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-graph-up me-2"></i>GA Bucket Visualization</h3>
                <p class="text-muted mb-4">Explore the bucket system used for multi-population genetic algorithm search</p>
                
                <!-- Bucket Statistics -->
                <div id="bucketStats" class="row mb-4">
                    <div class="col-md-12">
                        <div class="alert alert-info">
                            <i class="bi bi-hourglass-split me-2"></i>Loading bucket statistics...
                        </div>
                    </div>
                </div>

                <!-- Three-Level Visualization -->
                <div class="row">
                    <!-- Level 1: Categories -->
                    <div class="col-md-4">
                        <div class="card" style="background: rgba(30,41,59,0.8); border: 1px solid rgba(59,130,246,0.3);">
                            <div class="card-header" style="background: rgba(59,130,246,0.2); border-bottom: 1px solid rgba(59,130,246,0.3);">
                                <h5 class="mb-0"><i class="bi bi-folder me-2"></i>Bucket Categories</h5>
