                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                </select>
                                <small class="text-muted">Patient's blood group</small>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-gender-ambiguous me-2"></i>Gender
                                </label>
                                <select class="form-select" id="ga_gender">
                                    <option value="">Any Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                                <small class="text-muted">Patient's gender</small>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-calendar-range me-2"></i>Age Range
                                </label>
                                <select class="form-select" id="ga_age_range">
                                    <option value="">Any Age</option>
                                    <option value="0-12">Pediatric (0-12)</option>
                                    <option value="13-19">Adolescent (13-19)</option>
                                    <option value="20-39">Young Adult (20-39)</option>
                                    <option value="40-59">Middle Age (40-59)</option>
                                    <option value="60-150">Senior (60+)</option>
                                </select>
                                <small class="text-muted">Patient's age group</small>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-person-badge me-2"></i>Doctor
                                </label>
                                <select class="form-select" id="ga_doctor_id">
                                    <option value="">All Doctors</option>
                                    <% if (doctors && doctors.length > 0) { %>
                                        <% doctors.forEach(doctor => { %>
                                            <option value="<%= doctor.doctor_id %>">
                                                <%= doctor.doctor_id %> - Dr. <%= doctor.username %>
                                            </option>
                                        <% }); %>
                                    <% } %>
                                </select>
                                <small class="text-muted">Uploaded by doctor</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-list-ol me-2"></i>Number of Results
                                </label>
                                <input type="number" class="form-control" id="ga_limit" 
                                       value="10" min="1" max="50">
                                <small class="text-muted">Maximum results to return (1-50)</small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg" id="gaSearchBtn">
                            <i class="bi bi-search me-2"></i>Search with GA
                        </button>
                        <button type="button" class="btn btn-secondary btn-lg" onclick="clearGASearch()">
                            <i class="bi bi-x-circle me-2"></i>Clear
                        </button>
                    </div>
                </form>

                <!-- Results Section -->
                <div id="gaResults" class="mt-4" style="display: none;">
                    <h4><i class="bi bi-list-check me-2"></i>Search Results</h4>
                    <div id="gaResultsContent"></div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- File Preview Modal -->
    <div class="modal fade" id="filePreviewModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-text me-2"></i>Medical Record Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="modalContent">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global variable for feedback tracking (must be declared before use)
        let lastSearchCriteria = {};
        
        // Tab Switching
        switchTab = function(tabName, clickedButton) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            
            if (clickedButton) {
                clickedButton.classList.add('active');
            }
            
            document.getElementById(tabName + '-tab').classList.add('active');
            
            // Load data when switching tabs
            if (tabName === 'blockchain') window.loadBlockchain(10);
            if (tabName === 'doctor-patient') window.loadDoctorPatientData();
            if (tabName === 'ga-viz') window.loadBucketVisualization();
        }
        
        // Check IPFS Status
        checkIPFSStatus = async function() {
            console.log('🔍 Checking IPFS status...');
            try {
                const response = await fetch('/admin/api/ipfs-status');
                console.log('📡 IPFS API Response:', response.status);
                const data = await response.json();
                console.log('📊 IPFS Data:', data);
                
                if (data.success && data.connected) {
                    document.getElementById('ipfsStatus').textContent = 'Running';
                    document.getElementById('ipfsBadge').textContent = 'Local Node Active';
                    document.getElementById('ipfsBadge').className = 'status-badge badge-success';
                    console.log('✅ IPFS is running');
                } else {
                    document.getElementById('ipfsStatus').textContent = 'Offline';
                    document.getElementById('ipfsBadge').textContent = 'Node Not Running';
                    document.getElementById('ipfsBadge').className = 'status-badge badge-error';
                    console.log('❌ IPFS is offline');
                }
            } catch (error) {
                console.error('❌ IPFS check error:', error);
                document.getElementById('ipfsStatus').textContent = 'Error';
                document.getElementById('ipfsBadge').textContent = 'Connection Failed';
                document.getElementById('ipfsBadge').className = 'status-badge badge-error';
            }
        }
        
        // Load Blockchain
        window.loadBlockchain = async function(limit = 10) {
            const container = document.getElementById('blockchainList');
            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch('/admin/api/blockchain');
                const data = await response.json();
                
                if (data.success) {
                    const blocks = data.chain.slice(-limit).reverse();
                    let html = '';
                    
                    blocks.forEach(block => {
                        // Use database field names
                        const blockIndex = block.block_index;
                        const blockHash = block.block_hash;
                        const isGenesisBlock = blockIndex === 0;
                        const cid = block.ipfs_cid || 'N/A';
                        const hasCid = cid !== 'N/A' && cid !== '';
                        const patientId = block.patient_id || (isGenesisBlock ? 'Genesis' : 'N/A');
                        const fileType = block.file_type || (isGenesisBlock ? 'System Initialization' : 'N/A');
                        const doctor = block.doc || (isGenesisBlock ? 'System' : 'N/A');
                        const status = block.file_status || 'Open';
                        
                        // Format timestamp
                        let formattedDate = block.timestamp;
                        if (block.timestamp && !isGenesisBlock) {
                            try {
                                const timestampNum = typeof block.timestamp === 'string' ? parseInt(block.timestamp, 10) : block.timestamp;
                                const date = new Date(timestampNum);
                                formattedDate = date.toLocaleString('en-US', {
                                    year: 'numeric',
                                    month: 'short',
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit',
                                    hour12: true
                                });
                            } catch (e) {
                                formattedDate = block.timestamp;
                            }
                        }
                        
                        html += `
                            <div class="block-card" style="border: 2px solid rgba(0,210,255,0.3); border-radius: 15px; padding: 20px; margin-bottom: 15px; background: rgba(15,52,96,0.3);">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="block-index" style="font-size: 1.3rem; color: #00d2ff; font-weight: bold;">Block #${blockIndex}</div>
                                        <small style="color: rgba(255,255,255,0.7);"><i class="bi bi-clock me-1"></i>${formattedDate}</small>
                                    </div>
                                    ${hasCid ? `<button class="btn btn-primary" onclick="viewRecord('${cid}')" style="white-space: nowrap;">
                                        <i class="bi bi-eye me-1"></i>View Details
                                    </button>` : '<span class="badge bg-secondary">Genesis Block</span>'}
                                </div>
                                
                                <div class="row mb-2">
                                    <div class="col-md-4">
                                        <strong style="color: #94a3b8;">Patient ID:</strong> <span style="color: #e4e4e7;">${patientId}</span>
                                    </div>
                                    <div class="col-md-4">
                                        <strong style="color: #94a3b8;">File Type:</strong> <span style="color: #e4e4e7;">${fileType}</span>
                                    </div>
                                    <div class="col-md-4">
                                        <strong style="color: #94a3b8;">Doctor:</strong> <span style="color: #e4e4e7;">${doctor}</span>
                                    </div>
                                </div>
                                
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <strong style="color: #94a3b8;">Status:</strong> <span class="badge ${status === 'Closed' ? 'bg-secondary' : 'bg-success'}">${status}</span>
                                    </div>
                                    ${hasCid ? `<div class="col-md-6">
