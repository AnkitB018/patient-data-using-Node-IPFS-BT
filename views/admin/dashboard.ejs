        // ==================== GA SEARCH FUNCTIONS ====================
        
        window.performGASearch = async function(event) {
            event.preventDefault();
            
            const btn = document.getElementById('gaSearchBtn');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Running Multi-Population GA...';
            
            const searchCriteria = {
                file_type: document.getElementById('ga_file_type').value.trim(),
                diagnosis: document.getElementById('ga_primary_diagnosis').value.trim(),
                symptoms: collectFieldValues('ga-symptom-field'),
                body_parts: document.getElementById('ga_body_parts').value.trim(),
                secondary_diagnosis: collectFieldValues('ga-secondary-diagnosis-field'),
                treatments: collectFieldValues('ga-treatment-field'),
                medications: collectFieldValues('ga-medication-field'),
                conditions: document.getElementById('ga_conditions')?.value.trim() || '',
                gender: document.getElementById('ga_gender').value,
                age_range: document.getElementById('ga_age_range').value,
                topN: parseInt(document.getElementById('ga_limit').value) || 10
            };
            
            // Check if at least one criteria is provided
            const hasSearchCriteria = searchCriteria.file_type || searchCriteria.diagnosis ||
                                      searchCriteria.symptoms || searchCriteria.body_parts ||
                                      searchCriteria.secondary_diagnosis || searchCriteria.treatments ||
                                      searchCriteria.medications || searchCriteria.conditions ||
                                      searchCriteria.gender || searchCriteria.age_range;
            
            if (!hasSearchCriteria) {
                alert('⚠️ Please fill in at least one search criterion');
                btn.disabled = false;
                btn.innerHTML = originalText;
                return;
            }
            
            try {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 120000); // 120 second timeout
                
                const response = await fetch('/admin/api/ga-search', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(searchCriteria),
                    signal: controller.signal
                });
                
                clearTimeout(timeoutId);
                
                if (!response.ok) {
                    throw new Error(`Server returned ${response.status}: ${response.statusText}`);
                }
                
                const data = await response.json();
                console.log('Multi-Population GA Response:', data);
                
                if (data.success) {
                    displayGAResults(data);
                } else {
                    alert('❌ Error: ' + (data.error || 'Failed to perform GA search'));
                }
            } catch (error) {
                console.error('GA Search Error:', error);
                if (error.name === 'AbortError') {
                    alert('⏱️ Search timeout: Request took too long. Try reducing the number of results or refining your criteria.');
                } else {
                    alert('❌ Error performing search: ' + error.message);
                }
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }
        
        displayGAResults = function(data) {
            const resultsSection = document.getElementById('gaResults');
            const resultsContent = document.getElementById('gaResultsContent');
            
            resultsSection.style.display = 'block';
            
            if (!data.results || data.results.length === 0) {
                resultsContent.innerHTML = `
                    <div class="alert alert-warning" style="background: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.3);">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        No matching records found. Try adjusting your search criteria.
                    </div>
                `;
                return;
            }
            
            const metrics = data.metrics || {};
            
            let html = `
                <div class="alert alert-success mb-4" style="background: rgba(0, 255, 127, 0.1); border: 1px solid rgba(0, 255, 127, 0.3);">
                    <h5 class="mb-3"><i class="bi bi-check-circle me-2"></i>Multi-Population GA Complete!</h5>
                    <div class="row">
                        <div class="col-md-3">
                            <strong><i class="bi bi-layers me-1"></i>Generations:</strong> ${metrics.generations || 'N/A'}
                        </div>
                        <div class="col-md-3">
                            <strong><i class="bi bi-search me-1"></i>Evaluated:</strong> ${metrics.recordsEvaluated || 'N/A'}/${metrics.totalRecords || 'N/A'}
                        </div>
                        <div class="col-md-3">
                            <strong><i class="bi bi-percent me-1"></i>Coverage:</strong> ${metrics.evaluationPercentage || 'N/A'}%
                        </div>
                        <div class="col-md-3">
                            <strong><i class="bi bi-clock me-1"></i>Duration:</strong> ${metrics.duration || 'N/A'}
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-md-12">
                            <strong><i class="bi bi-trophy me-1"></i>Top Fitness:</strong> ${metrics.topFitness || 'N/A'}%
                            <small class="ms-2" style="color: rgba(255,255,255,0.7);">Found ${data.results.length} relevant records</small>
                        </div>
                    </div>
                </div>
                
                <div class="row">
            `;
            
            data.results.forEach((record, index) => {
                const fitness = record.fitness || 0;
                const matchColor = fitness >= 80 ? '#00ff7f' : 
                                 fitness >= 60 ? '#00d2ff' : 
                                 fitness >= 40 ? '#ffd700' : '#ff6b6b';
                
                html += `
                    <div class="col-md-6 mb-3">
                        <div class="card" style="background: rgba(30,41,59,0.8); border: 2px solid ${matchColor}; border-radius: 15px; padding: 20px; color: white;">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 style="color: ${matchColor};">
                                    <i class="bi bi-file-earmark-medical me-2"></i>
                                    #${index + 1} - Block #${record.block_index}
                                </h5>
                                <span class="badge" style="background: ${matchColor}; color: #000; font-size: 1.1rem; padding: 6px 12px;">
                                    ${fitness.toFixed(1)}% Match
                                </span>
                            </div>
                            
                            <div class="record-details">
                                <div class="mb-2">
                                    <i class="bi bi-person me-2"></i>
                                    <strong>Patient ID:</strong> ${record.patient_id || 'N/A'}
                                </div>
                                <div class="mb-2">
                                    <i class="bi bi-file-text me-2"></i>
                                    <strong>File Type:</strong> ${record.file_type || 'N/A'}
                                </div>
                                <div class="mb-2">
                                    <i class="bi bi-person-badge me-2"></i>
                                    <strong>Doctor:</strong> ${record.doctor || 'N/A'}
                                </div>
                                <div class="mb-2">
                                    <i class="bi bi-heart-pulse me-2"></i>
                                    <strong>Diagnosis:</strong> ${record.diagnosis || 'N/A'}
                                </div>
                                <div class="mb-2">
                                    <i class="bi bi-thermometer-half me-2"></i>
                                    <strong>Symptoms:</strong> ${record.symptoms || 'N/A'}
                                </div>
                                <div class="mb-2">
                                    <i class="bi bi-body-text me-2"></i>
                                    <strong>Body Parts:</strong> ${record.body_parts || 'N/A'}
                                </div>
                                ${record.ipfs_cid && record.ipfs_cid !== 'N/A' ? `
                                <div class="mt-3">
                                    <button class="btn btn-primary btn-sm" onclick="viewRecord('${record.ipfs_cid}')">
                                        <i class="bi bi-eye me-1"></i>View Full Record
                                    </button>
                                </div>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `;
            });
            
            html += '</div>';
            resultsContent.innerHTML = html;
            
            // Scroll to results
            resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        
