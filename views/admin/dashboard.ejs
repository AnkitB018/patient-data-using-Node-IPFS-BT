                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Level 2: Buckets in Selected Category -->
                    <div class="col-md-4">
                        <div class="card" style="background: rgba(30,41,59,0.8); border: 1px solid rgba(59,130,246,0.3);">
