        // Select a category
        window.selectCategory = function(categoryKey) {
            selectedCategory = categoryKey;
            
            // Highlight selected category
            document.querySelectorAll('.category-item').forEach(item => {
                item.style.background = 'rgba(59,130,246,0.1)';
                item.style.borderLeft = '3px solid transparent';
            });
            
            const selectedItem = document.querySelector(`[data-category="${categoryKey}"]`);
            if (selectedItem) {
                selectedItem.style.background = 'rgba(59,130,246,0.3)';
                selectedItem.style.borderLeft = '3px solid #60a5fa';
            }

            // Display buckets for this category
            displayBuckets(categoryKey);
            
            // Clear block list
            document.getElementById('blockList').innerHTML = `
                <div class="empty-state text-center py-5" style="color: rgba(255,255,255,0.5);">
                    <i class="bi bi-arrow-left" style="font-size: 2rem;"></i>
                    <p class="mt-3 mb-0">Select a bucket to view block indices</p>
                </div>
            `;
        }

        // Display buckets in a category
        function displayBuckets(categoryKey) {
            const category = currentCategories[categoryKey];
            const bucketList = document.getElementById('bucketList');
            
            if (!category || category.buckets.length === 0) {
                bucketList.innerHTML = `
                    <div class="empty-state text-center py-5" style="color: rgba(255,255,255,0.5);">
                        <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                        <p class="mt-3 mb-0">No buckets in this category</p>
                    </div>
                `;
                return;
            }

            let html = '<div class="list-group">';
            
            category.buckets.forEach(bucketName => {
                html += `
                    <a href="javascript:void(0)" 
                       class="list-group-item list-group-item-action bucket-item"
                       onclick="selectBucket('${categoryKey}', '${bucketName}')"
                       style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.2); color: white; margin-bottom: 6px; border-radius: 6px;">
                        <i class="bi bi-box me-2"></i>${bucketName}
                    </a>
                `;
            });
            
            html += '</div>';
            bucketList.innerHTML = html;
        }

        // Select a bucket and display block indices
        window.selectBucket = async function(categoryKey, bucketName) {
            // Highlight selected bucket
            document.querySelectorAll('.bucket-item').forEach(item => {
                item.style.background = 'rgba(16,185,129,0.1)';
                item.style.borderLeft = '3px solid transparent';
            });
            
            event.target.closest('.bucket-item').style.background = 'rgba(16,185,129,0.3)';
            event.target.closest('.bucket-item').style.borderLeft = '3px solid #34d399';

            // Load block indices
            try {
                const response = await fetch(`/admin/api/buckets/${categoryKey}/${bucketName}`);
                const data = await response.json();
                
                if (data.success) {
                    displayBlockIndices(data);
                }
            } catch (error) {
                console.error('Error loading block indices:', error);
                document.getElementById('blockList').innerHTML = `
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>Error loading blocks
                    </div>
                `;
            }
        }

        // Display block indices
        function displayBlockIndices(data) {
            const blockList = document.getElementById('blockList');
            
            if (data.records.length === 0) {
                blockList.innerHTML = `
                    <div class="empty-state text-center py-5" style="color: rgba(255,255,255,0.5);">
                        <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                        <p class="mt-3 mb-0">No blocks in this bucket</p>
                    </div>
                `;
                return;
            }

            let html = `
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0" style="color: #a78bfa;">
                            <i class="bi bi-info-circle me-2"></i>${data.bucketName}
                        </h6>
                        <span class="badge bg-secondary">${data.count} blocks</span>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
            `;

            data.records.forEach(blockIndex => {
                html += `
                    <span class="badge bg-primary" style="font-size: 0.9rem; padding: 6px 12px;">
                        Block #${blockIndex}
                    </span>
                `;
            });

            html += '</div>';
            blockList.innerHTML = html;
        }
        
        // ===========================================
        // INITIALIZATION - MUST BE AT THE END
        // ===========================================
        console.log('🚀 Dashboard initializing...');
        
        // Setup tab event listeners
        document.querySelectorAll('.tab-btn').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const tabName = this.getAttribute('data-tab');
                switchTab(tabName, this);
            });
        });
        console.log('✅ Tab event listeners attached');
        
        // Start IPFS status check
        checkIPFSStatus();
        setInterval(checkIPFSStatus, 30000); // Check every 30 seconds
        console.log('✅ IPFS status check scheduled');
        
        // Load initial blockchain data
        window.loadBlockchain(10);
        console.log('✅ Dashboard initialization complete');
    </script>
</body>
</html>

